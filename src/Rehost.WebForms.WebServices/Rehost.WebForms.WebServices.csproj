<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>System.Web.Services</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0108;CS0618;CS0649;CS0612;CS0672;CS3021;CA2200;SYSLIB0003;SYSLIB0004;SYSLIB0011;SYSLIB0012;SYSLIB0014;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../System.Web.Services.ReferenceSource/**/*.cs" />
    <!-- WSDL proxy generation: needs System.Xml.Serialization code-export APIs cut
         from modern .NET. -->
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/Description/SoapProtocolImporter.cs" />
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/Description/Soap12ProtocolImporter.cs" />
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/Description/SoapExtensionImporter.cs" />
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/Description/SoapTransportImporter.cs" />
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/Description/SoapHttpTransportImporter.cs" />
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/Description/MimeXmlImporter.cs" />
    <!-- VS debugger-causality COM channel; RemoteDebugger.cs here stands in. -->
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/Protocols/RemoteDebugger.cs" />
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/Interop/**/*.cs" />
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/UnsafeNativeMethods.cs" />
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/NativeMethods.cs" />
    <!-- IIS-metabase (ADSI) dynamic discovery. -->
    <Compile Remove="../System.Web.Services.ReferenceSource/System/Web/Services/Discovery/DynamicVirtualDiscoSearcher.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Security.Permissions" />
  </ItemGroup>

  <Import Project="../../eng/Rehost.WebForms.GeneratedInputs/Rehost.WebForms.ServicesGeneratedInputs.targets" />
</Project>
