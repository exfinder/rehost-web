<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>System.Web</RootNamespace>
    <Description>ASP.NET AJAX and ScriptManager compatibility for Rehost.Web.</Description>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0108;CS0612;CS0618;CS0649;CS0672;CS3021;CS9191;SYSLIB0003;SYSLIB0004;SYSLIB0005;SYSLIB0044;SYSLIB0050;SYSLIB0051</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="../Rehost.Web.Package/Rehost.Web.Dependencies.props" />

  <ItemGroup>
    <Compile Include="../System.Web.Extensions.ReferenceSource/**/*.cs" />
    <Compile Remove="../System.Web.Extensions.ReferenceSource/Properties/AssemblyInfo.cs" />
    <!-- Windows-desktop client stack: wininet, WindowsIdentity, WinForms paths, OleDb. -->
    <Compile Remove="../System.Web.Extensions.ReferenceSource/ClientServices/**/*.cs" />
    <!-- VS .svcmap/.datasvcmap WCF proxy generation; needs cut System.ServiceModel codegen. -->
    <Compile Remove="../System.Web.Extensions.ReferenceSource/Compilation/**/*.cs" />
    <Compile Remove="../System.Web.Extensions.ReferenceSource/Resources/WCFModelStrings.Designer.cs" />
    <Compile Remove="../System.Web.Extensions.ReferenceSource/Script/Services/ProxyGenerator.cs" />
    <!-- WCF-hosted .svc application services; the JSON siblings in Profile/ and Security/ compile. -->
    <Compile Remove="../System.Web.Extensions.ReferenceSource/ApplicationServices/ApplicationServicesHostFactory.cs" />
    <Compile Remove="../System.Web.Extensions.ReferenceSource/ApplicationServices/AuthenticationService.cs" />
    <Compile Remove="../System.Web.Extensions.ReferenceSource/ApplicationServices/ProfileService.cs" />
    <Compile Remove="../System.Web.Extensions.ReferenceSource/ApplicationServices/RoleService.cs" />
    <!-- System.Data.Linq has no modern implementation. LinqDataSource* also covers
         LinqDataSourceContextData.cs, a duplicate of ContextDataSourceContextData. -->
    <Compile Remove="../System.Web.Extensions.ReferenceSource/ui/WebControls/ILinqToSql.cs" />
    <Compile Remove="../System.Web.Extensions.ReferenceSource/ui/WebControls/LinqDataSource*.cs" />
    <Compile Remove="../System.Web.Extensions.ReferenceSource/ui/WebControls/LinqToSqlWrapper.cs" />
    <!-- Fully commented out upstream. -->
    <Compile Remove="../System.Web.Extensions.ReferenceSource/ui/WebControls/PermaLink.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts/*.js" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource
      Include="../System.Web.Extensions.ReferenceSource/Resources/AtlasWeb.resx"
      LogicalName="System.Web.Resources.AtlasWeb.resources" />
    <EmbeddedResource
      Include="../System.Web.Extensions.ReferenceSource/Resources/ScriptLibrary/Res.resx"
      LogicalName="System.Web.Resources.ScriptLibrary.Res.resources" />
    <EmbeddedResource
      Include="../System.Web.Extensions.ReferenceSource/Resources/ScriptLibrary/WebForms.Res.resx"
      LogicalName="System.Web.Resources.ScriptLibrary.WebForms.Res.resources" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.Web/Rehost.Web.csproj" />
    <ProjectReference Include="../Rehost.Web.Services/Rehost.Web.Services.csproj" />
    <ProjectReference
      Include="../../eng/Rehost.Web.ReferenceSource.BuildInputs/Rehost.Web.ReferenceSource.BuildInputs.csproj"
      Private="false"
      PrivateAssets="all" />
  </ItemGroup>
</Project>
