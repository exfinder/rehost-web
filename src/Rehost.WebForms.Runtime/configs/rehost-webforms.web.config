<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal portable defaults. Pipeline handlers/modules are selected by the host profile. -->
<configuration>
  <system.web>
    <!--
      Framework inherited its compiler entries from <system.codedom>, which .NET has no
      configuration handler for. The ASP.NET <compilers> collection is the only remaining seam.
    -->
    <compilation>
      <compilers>
        <compiler
          language="c#;cs;csharp"
          extension=".cs"
          warningLevel="4"
          compilerOptions="/langversion:7.3"
          type="System.Web.Compilation.RoslynCSharpCodeProvider, Rehost.WebForms.Runtime" />
        <compiler
          language="vb;vbs;visualbasic;vbscript"
          extension=".vb"
          warningLevel="4"
          type="System.Web.Compilation.UnsupportedVBCodeProvider, Rehost.WebForms.Runtime" />
      </compilers>
      <assemblies>
        <add assembly="Rehost.WebForms.Runtime" />
        <add assembly="Rehost.WebForms.WebServices" />
        <add assembly="Rehost.WebForms.ApplicationServices" />
        <add assembly="System.Configuration.ConfigurationManager" />
        <add assembly="System.Drawing.Common" />
        <add assembly="System.Data.SqlClient" />
        <add assembly="*" />
      </assemblies>
    </compilation>
    <hostingEnvironment />
    <httpRuntime fcnMode="Disabled" />
    <trust level="Full" legacyCasModel="false" />
  </system.web>
</configuration>
