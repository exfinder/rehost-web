<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <authorization>
      <allow users="*" />
    </authorization>
    <!--
      Framework inherited its compiler entries from <system.codedom>, which .NET has no
      configuration handler for. The ASP.NET <compilers> collection is the only remaining seam.
    -->
    <compilation>
      <compilers>
        <compiler
          language="c#;cs;csharp"
          extension=".cs"
          warningLevel="4"
          compilerOptions="/langversion:7.3"
          type="System.Web.Compilation.RoslynCSharpCodeProvider, Rehost.WebForms.Runtime" />
        <compiler
          language="vb;vbs;visualbasic;vbscript"
          extension=".vb"
          warningLevel="4"
          type="System.Web.Compilation.UnsupportedVBCodeProvider, Rehost.WebForms.Runtime" />
      </compilers>
      <!--
        Framework's list, minus the four whose types live in assemblies this port does not carry
        (.edmx, .xoml, .svc, .xamlx); see the compatibility feature map. Types are assembly
        qualified because Framework's unqualified names resolved through System.Web itself.
        Registration resolves the type only when a file of that extension is compiled, so an
        extension listed here claims nothing about the slice that supports it.
      -->
      <buildProviders>
        <add extension=".aspx" type="System.Web.Compilation.PageBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".ascx" type="System.Web.Compilation.UserControlBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".master" type="System.Web.Compilation.MasterPageBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".asmx" type="System.Web.Compilation.WebServiceBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".ashx" type="System.Web.Compilation.WebHandlerBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".soap" type="System.Web.Compilation.WebServiceBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".resx" type="System.Web.Compilation.ResXBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".resources" type="System.Web.Compilation.ResourcesBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".wsdl" type="System.Web.Compilation.WsdlBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".xsd" type="System.Web.Compilation.XsdBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".js" type="System.Web.Compilation.ForceCopyBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".lic" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".licx" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".exclude" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".refresh" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.WebForms.Runtime" />
      </buildProviders>
      <assemblies>
        <!-- Framework's first entry. Compilation ignores it (the shared framework already
             supplies every reference), but BuildManager.GetType searches this list, and the
             facade's type forwards are what make a bare BCL name such as the ItemType
             "System.String" resolve. -->
        <add assembly="mscorlib" />
        <add assembly="Rehost.WebForms.Runtime" />
        <add assembly="Rehost.WebForms.ApplicationServices" />
        <add assembly="Rehost.WebForms.WebServices" />
        <add assembly="Rehost.WebForms.Extensions" />
        <add assembly="System.Configuration.ConfigurationManager" />
        <!-- Framework lists System.Drawing; only Primitives (Color) is portable. -->
        <add assembly="System.Drawing.Primitives" />
        <add assembly="System.Data.SqlClient" />
        <add assembly="*" />
      </assemblies>
    </compilation>
    <!--
      Imports every generated file receives. Framework's list minus System.Web.DynamicData, whose
      assembly this port does not carry: an unresolvable import fails every compilation rather
      than only the code that uses it.

      <controls> keeps the Framework entries whose assemblies survive; the rest named
      System.Web.DynamicData and System.Web.Entity.
      System.Web's own WebControls needs no entry because
      PagesSection.DefaultTagNamespaceRegisterEntries hard-codes asp: for it; [assembly:TagPrefix]
      is design-time metadata that nothing in the runtime reads.

      Naming Rehost.WebForms.Extensions here is a deployment promise: prefix resolution loads
      every assembly registered for asp:, so an application without it fails on any asp: tag.
      Every consumer here references it explicitly until a metapackage guarantees it; see
      [runtime metapackage](../../../docs/follow-ups/runtime-metapackage.md).
    -->
    <pages>
      <namespaces>
        <add namespace="System" />
        <add namespace="System.Collections" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Collections.Specialized" />
        <add namespace="System.ComponentModel.DataAnnotations" />
        <add namespace="System.Configuration" />
        <add namespace="System.Linq" />
        <add namespace="System.Text" />
        <add namespace="System.Text.RegularExpressions" />
        <add namespace="System.Web" />
        <add namespace="System.Web.Caching" />
        <add namespace="System.Web.SessionState" />
        <add namespace="System.Web.Security" />
        <add namespace="System.Web.Profile" />
        <add namespace="System.Web.UI" />
        <add namespace="System.Web.UI.WebControls" />
        <add namespace="System.Web.UI.WebControls.WebParts" />
        <add namespace="System.Web.UI.HtmlControls" />
        <add namespace="System.Xml.Linq" />
      </namespaces>
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI.WebControls.WebParts" assembly="Rehost.WebForms.Runtime" />
        <add tagPrefix="asp" namespace="System.Web.UI" assembly="Rehost.WebForms.Extensions" />
        <add tagPrefix="asp" namespace="System.Web.UI.WebControls" assembly="Rehost.WebForms.Extensions" />
        <add tagPrefix="asp" namespace="System.Web.UI.WebControls.Expressions" assembly="Rehost.WebForms.Extensions" />
      </controls>
    </pages>
    <siteMap>
      <providers>
        <add siteMapFile="web.sitemap" name="AspNetXmlSiteMapProvider" type="System.Web.XmlSiteMapProvider, Rehost.WebForms.Runtime" />
      </providers>
    </siteMap>
    <!--
      Framework's list in its original order, minus the eight entries whose types live in
      assemblies this port does not carry; see the compatibility feature map. Order carries
      meaning: the forbidden entries only protect anything because they precede the trailing
      catch-all. Types are assembly qualified because Framework's unqualified names resolved
      through System.Web itself.

      validate="True" resolves the type when this section initializes, so an unresolvable entry
      here fails activation for every application, not only one that requests that extension.

      DefaultHttpHandler hands the request to the host through EXECUTE_URL when the worker request
      supports it, and serves the file itself when it does not. No worker request here supports it,
      so the trailing entry means System.Web serves static files.
    -->
    <httpHandlers>
      <add path="eurl.axd" verb="*" type="System.Web.HttpNotFoundHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="trace.axd" verb="*" type="System.Web.Handlers.TraceHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="WebResource.axd" verb="GET" type="System.Web.Handlers.AssemblyResourceLoader, Rehost.WebForms.Runtime" validate="True" />
      <add path="*_AppService.axd" verb="*" type="System.Web.Script.Services.ScriptHandlerFactory, Rehost.WebForms.Extensions" validate="False" />
      <add path="ScriptResource.axd" verb="GET,HEAD" type="System.Web.Handlers.ScriptResourceHandler, Rehost.WebForms.Extensions" validate="False" />
      <add path="*.axd" verb="*" type="System.Web.HttpNotFoundHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.aspx" verb="*" type="System.Web.UI.PageHandlerFactory, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.ashx" verb="*" type="System.Web.UI.SimpleHandlerFactory, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.asmx" verb="*" type="System.Web.Script.Services.ScriptHandlerFactory, Rehost.WebForms.Extensions" validate="False" />
      <add path="*.asax" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.ascx" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.master" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.skin" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.browser" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.sitemap" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.dll.config" verb="GET,HEAD" type="System.Web.StaticFileHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.exe.config" verb="GET,HEAD" type="System.Web.StaticFileHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.config" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.cs" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.csproj" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.vb" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.vbproj" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.webinfo" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.licx" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.resx" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.resources" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.mdb" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.vjsproj" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.java" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.jsl" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.ldb" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.ad" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.dd" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.ldd" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.sd" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.cd" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.adprototype" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.lddprototype" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.sdm" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.sdmDocument" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.mdf" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.ldf" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.exclude" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.refresh" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.rules" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.aspq" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.cshtm" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.cshtml" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.vbhtm" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*.vbhtml" verb="*" type="System.Web.HttpForbiddenHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*" verb="GET,HEAD,POST" type="System.Web.DefaultHttpHandler, Rehost.WebForms.Runtime" validate="True" />
      <add path="*" verb="*" type="System.Web.HttpMethodNotAllowedHandler, Rehost.WebForms.Runtime" validate="True" />
    </httpHandlers>
    <httpModules>
      <add name="OutputCache" type="System.Web.Caching.OutputCacheModule, Rehost.WebForms.Runtime" />
      <add name="Session" type="System.Web.SessionState.SessionStateModule, Rehost.WebForms.Runtime" />
      <add name="FormsAuthentication" type="System.Web.Security.FormsAuthenticationModule, Rehost.WebForms.Runtime" />
      <add name="RoleManager" type="System.Web.Security.RoleManagerModule, Rehost.WebForms.Runtime" />
      <add name="UrlAuthorization" type="System.Web.Security.UrlAuthorizationModule, Rehost.WebForms.Runtime" />
      <add name="AnonymousIdentification" type="System.Web.Security.AnonymousIdentificationModule, Rehost.WebForms.Runtime" />
      <add name="Profile" type="System.Web.Profile.ProfileModule, Rehost.WebForms.Runtime" />
      <add name="UrlRoutingModule-4.0" type="System.Web.Routing.UrlRoutingModule, Rehost.WebForms.Runtime" />
      <add name="ScriptModule-4.0" type="System.Web.Handlers.ScriptModule, Rehost.WebForms.Extensions" />
    </httpModules>
    <!--
      Without this section HttpCapabilitiesBase.GetBrowserCapabilities returns null and every
      control that consults Request.Browser throws. Framework names MobileCapabilities from
      System.Web.Mobile, which this port does not carry; its base class is the substitute, because
      dropping the element instead defaults the result to HttpCapabilitiesBase, which
      HttpRequest.Browser cannot cast. The definitions behind it come from the compiled-in
      BrowserCapabilitiesFactory; App_Browsers remains unsupported.
    -->
    <browserCaps userAgentCacheKeyLength="64">
      <result type="System.Web.HttpBrowserCapabilities, Rehost.WebForms.Runtime" />
    </browserCaps>
    <hostingEnvironment />
    <httpRuntime asyncPreloadMode="None" maxRequestLength="4096" requestLengthDiskThreshold="80" fcnMode="Disabled" />
    <trust level="Full" legacyCasModel="false" />
  </system.web>
</configuration>
