<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal portable defaults. Pipeline handlers/modules are selected by the host profile. -->
<configuration>
  <system.web>
    <!--
      Framework inherited its compiler entries from <system.codedom>, which .NET has no
      configuration handler for. The ASP.NET <compilers> collection is the only remaining seam.
    -->
    <compilation>
      <compilers>
        <compiler
          language="c#;cs;csharp"
          extension=".cs"
          warningLevel="4"
          compilerOptions="/langversion:7.3"
          type="System.Web.Compilation.RoslynCSharpCodeProvider, Rehost.WebForms.Runtime" />
        <compiler
          language="vb;vbs;visualbasic;vbscript"
          extension=".vb"
          warningLevel="4"
          type="System.Web.Compilation.UnsupportedVBCodeProvider, Rehost.WebForms.Runtime" />
      </compilers>
      <!--
        Framework's list, minus the four whose types live in assemblies this port does not carry
        (.edmx, .xoml, .svc, .xamlx); see the compatibility feature map. Types are assembly
        qualified because Framework's unqualified names resolved through System.Web itself.
        Registration resolves the type only when a file of that extension is compiled, so an
        extension listed here claims nothing about the slice that supports it.
      -->
      <buildProviders>
        <add extension=".aspx" type="System.Web.Compilation.PageBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".ascx" type="System.Web.Compilation.UserControlBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".master" type="System.Web.Compilation.MasterPageBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".asmx" type="System.Web.Compilation.WebServiceBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".ashx" type="System.Web.Compilation.WebHandlerBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".soap" type="System.Web.Compilation.WebServiceBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".resx" type="System.Web.Compilation.ResXBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".resources" type="System.Web.Compilation.ResourcesBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".wsdl" type="System.Web.Compilation.WsdlBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".xsd" type="System.Web.Compilation.XsdBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".js" type="System.Web.Compilation.ForceCopyBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".lic" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".licx" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".exclude" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.WebForms.Runtime" />
        <add extension=".refresh" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.WebForms.Runtime" />
      </buildProviders>
      <assemblies>
        <add assembly="Rehost.WebForms.Runtime" />
        <add assembly="Rehost.WebForms.WebServices" />
        <add assembly="Rehost.WebForms.ApplicationServices" />
        <add assembly="System.Configuration.ConfigurationManager" />
        <add assembly="System.Drawing.Common" />
        <add assembly="System.Data.SqlClient" />
        <add assembly="*" />
      </assemblies>
    </compilation>
    <!--
      Imports every generated file receives. Framework's list minus System.Web.DynamicData, whose
      assembly this port does not carry: an unresolvable import fails every compilation rather
      than only the code that uses it. <controls> stays absent until a slice compiles markup;
      the standard asp: prefix comes from assembly attributes, not from this section.
    -->
    <pages>
      <namespaces>
        <add namespace="System" />
        <add namespace="System.Collections" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Collections.Specialized" />
        <add namespace="System.ComponentModel.DataAnnotations" />
        <add namespace="System.Configuration" />
        <add namespace="System.Linq" />
        <add namespace="System.Text" />
        <add namespace="System.Text.RegularExpressions" />
        <add namespace="System.Web" />
        <add namespace="System.Web.Caching" />
        <add namespace="System.Web.SessionState" />
        <add namespace="System.Web.Security" />
        <add namespace="System.Web.Profile" />
        <add namespace="System.Web.UI" />
        <add namespace="System.Web.UI.WebControls" />
        <add namespace="System.Web.UI.WebControls.WebParts" />
        <add namespace="System.Web.UI.HtmlControls" />
        <add namespace="System.Xml.Linq" />
      </namespaces>
    </pages>
    <hostingEnvironment />
    <httpRuntime fcnMode="Disabled" />
    <trust level="Full" legacyCasModel="false" />
  </system.web>
</configuration>
