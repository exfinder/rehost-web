<?xml version="1.0" encoding="utf-8"?>
<!-- Rehost Web Forms portable configuration vocabulary. Runtime defaults live in rehost-webforms.web.config. -->
<configuration>
  <configSections>
    <section name="appSettings" type="System.Configuration.AppSettingsSection, System.Configuration.ConfigurationManager" restartOnExternalChanges="false" requirePermission="false" />
    <section name="connectionStrings" type="System.Configuration.ConnectionStringsSection, System.Configuration.ConfigurationManager" requirePermission="false" />
    <!--
      Mirrors Framework: System.Web ignores <system.webServer>; without the declaration an app
      web.config carrying it fails. The honored sections are read from
      rehost-webforms.applicationHost.config plus app amendments (ledger P60).
    -->
    <section name="system.webServer" type="System.Configuration.IgnoreSection, System.Configuration.ConfigurationManager" />
    <sectionGroup name="system.web" type="System.Web.Configuration.SystemWebSectionGroup, Rehost.WebForms.Runtime">
      <section name="anonymousIdentification" type="System.Web.Configuration.AnonymousIdentificationSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="authentication" type="System.Web.Configuration.AuthenticationSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="authorization" type="System.Web.Configuration.AuthorizationSection, Rehost.WebForms.Runtime" />
      <section name="browserCaps" type="System.Web.Configuration.HttpCapabilitiesSectionHandler, Rehost.WebForms.Runtime" />
      <section name="clientTarget" type="System.Web.Configuration.ClientTargetSection, Rehost.WebForms.Runtime" />
      <section name="compilation" type="System.Web.Configuration.CompilationSection, Rehost.WebForms.Runtime" requirePermission="false" />
      <section name="customErrors" type="System.Web.Configuration.CustomErrorsSection, Rehost.WebForms.Runtime" />
      <section name="deployment" type="System.Web.Configuration.DeploymentSection, Rehost.WebForms.Runtime" allowDefinition="MachineOnly" />
      <section name="fullTrustAssemblies" type="System.Web.Configuration.FullTrustAssembliesSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="globalization" type="System.Web.Configuration.GlobalizationSection, Rehost.WebForms.Runtime" />
      <section name="healthMonitoring" type="System.Web.Configuration.HealthMonitoringSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="hostingEnvironment" type="System.Web.Configuration.HostingEnvironmentSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="httpCookies" type="System.Web.Configuration.HttpCookiesSection, Rehost.WebForms.Runtime" />
      <section name="httpHandlers" type="System.Web.Configuration.HttpHandlersSection, Rehost.WebForms.Runtime" />
      <section name="httpModules" type="System.Web.Configuration.HttpModulesSection, Rehost.WebForms.Runtime" />
      <section name="httpRuntime" type="System.Web.Configuration.HttpRuntimeSection, Rehost.WebForms.Runtime" />
      <section name="identity" type="System.Web.Configuration.IdentitySection, Rehost.WebForms.Runtime" />
      <section name="machineKey" type="System.Web.Configuration.MachineKeySection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="membership" type="System.Web.Configuration.MembershipSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="pages" type="System.Web.Configuration.PagesSection, Rehost.WebForms.Runtime" requirePermission="false" />
      <section name="partialTrustVisibleAssemblies" type="System.Web.Configuration.PartialTrustVisibleAssembliesSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="processModel" type="System.Web.Configuration.ProcessModelSection, Rehost.WebForms.Runtime" allowDefinition="MachineOnly" allowLocation="false" />
      <section name="profile" type="System.Web.Configuration.ProfileSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="protocols" type="System.Web.Configuration.ProtocolsSection, Rehost.WebForms.Runtime" allowDefinition="MachineToWebRoot" />
      <section name="roleManager" type="System.Web.Configuration.RoleManagerSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="securityPolicy" type="System.Web.Configuration.SecurityPolicySection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="sessionPageState" type="System.Web.Configuration.SessionPageStateSection, Rehost.WebForms.Runtime" />
      <section name="sessionState" type="System.Web.Configuration.SessionStateSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="siteMap" type="System.Web.Configuration.SiteMapSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="trace" type="System.Web.Configuration.TraceSection, Rehost.WebForms.Runtime" />
      <section name="trust" type="System.Web.Configuration.TrustSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="urlMappings" type="System.Web.Configuration.UrlMappingsSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      <section name="webControls" type="System.Web.Configuration.WebControlsSection, Rehost.WebForms.Runtime" />
      <section name="webParts" type="System.Web.Configuration.WebPartsSection, Rehost.WebForms.Runtime" />
      <section name="webServices" type="System.Web.Services.Configuration.WebServicesSection, Rehost.WebForms.WebServices" />
      <section name="xhtmlConformance" type="System.Web.Configuration.XhtmlConformanceSection, Rehost.WebForms.Runtime" />
      <sectionGroup name="caching" type="System.Web.Configuration.SystemWebCachingSectionGroup, Rehost.WebForms.Runtime">
        <section name="cache" type="System.Web.Configuration.CacheSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
        <section name="outputCache" type="System.Web.Configuration.OutputCacheSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
        <section name="outputCacheSettings" type="System.Web.Configuration.OutputCacheSettingsSection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
        <section name="sqlCacheDependency" type="System.Web.Configuration.SqlCacheDependencySection, Rehost.WebForms.Runtime" allowDefinition="MachineToApplication" />
      </sectionGroup>
    </sectionGroup>
    <sectionGroup name="system.web.extensions" type="System.Web.Configuration.SystemWebExtensionsSectionGroup, Rehost.WebForms.Extensions">
      <sectionGroup name="scripting" type="System.Web.Configuration.ScriptingSectionGroup, Rehost.WebForms.Extensions">
        <section name="scriptResourceHandler" type="System.Web.Configuration.ScriptingScriptResourceHandlerSection, Rehost.WebForms.Extensions" requirePermission="false" allowDefinition="MachineToApplication" />
        <sectionGroup name="webServices" type="System.Web.Configuration.ScriptingWebServicesSectionGroup, Rehost.WebForms.Extensions">
          <section name="jsonSerialization" type="System.Web.Configuration.ScriptingJsonSerializationSection, Rehost.WebForms.Extensions" requirePermission="false" allowDefinition="Everywhere" />
          <section name="profileService" type="System.Web.Configuration.ScriptingProfileServiceSection, Rehost.WebForms.Extensions" requirePermission="false" allowDefinition="MachineToApplication" />
          <section name="authenticationService" type="System.Web.Configuration.ScriptingAuthenticationServiceSection, Rehost.WebForms.Extensions" requirePermission="false" allowDefinition="MachineToApplication" />
          <section name="roleService" type="System.Web.Configuration.ScriptingRoleServiceSection, Rehost.WebForms.Extensions" requirePermission="false" allowDefinition="MachineToApplication" />
        </sectionGroup>
      </sectionGroup>
    </sectionGroup>
  </configSections>
  <connectionStrings>
    <add name="LocalSqlServer" connectionString="data source=.\SQLEXPRESS;Integrated Security=SSPI;AttachDBFilename=|DataDirectory|aspnetdb.mdf;User Instance=true" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <membership>
      <providers>
        <add name="AspNetSqlMembershipProvider" type="System.Web.Security.SqlMembershipProvider, Rehost.WebForms.Runtime" connectionStringName="LocalSqlServer" enablePasswordRetrieval="false" enablePasswordReset="true" requiresQuestionAndAnswer="true" applicationName="/" requiresUniqueEmail="false" passwordFormat="Hashed" maxInvalidPasswordAttempts="5" minRequiredPasswordLength="7" minRequiredNonalphanumericCharacters="1" passwordAttemptWindow="10" passwordStrengthRegularExpression="" />
      </providers>
    </membership>
    <profile>
      <providers>
        <add name="AspNetSqlProfileProvider" type="System.Web.Profile.SqlProfileProvider, Rehost.WebForms.Runtime" connectionStringName="LocalSqlServer" applicationName="/" />
      </providers>
    </profile>
    <roleManager>
      <providers>
        <add name="AspNetSqlRoleProvider" type="System.Web.Security.SqlRoleProvider, Rehost.WebForms.Runtime" connectionStringName="LocalSqlServer" applicationName="/" />
        <add name="AspNetWindowsTokenRoleProvider" type="System.Web.Security.WindowsTokenRoleProvider, Rehost.WebForms.Runtime" applicationName="/" />
      </providers>
    </roleManager>
    <!--
      Belongs with the runtime defaults in rehost-webforms.web.config, but <processModel> is
      MachineOnly. The section default of 60 assumed the denominator was a shared server's whole RAM
      and the rest had to cover the OS and other worker processes; a container limit has no such
      tenants. Neither number reproduces Framework's behaviour, where the limit sat so far above any
      real working set that the monitor never ran.
    -->
    <processModel memoryLimit="80" />
  </system.web>
</configuration>
