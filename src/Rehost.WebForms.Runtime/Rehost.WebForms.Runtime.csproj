<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>System.Web</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0108;CS0436;CS0612;CS0618;CS0672;CS3021;CS9191;CA2200;SYSLIB0003;SYSLIB0004;SYSLIB0005;SYSLIB0011;SYSLIB0012;SYSLIB0013;SYSLIB0014;SYSLIB0021;SYSLIB0023;SYSLIB0024;SYSLIB0044;SYSLIB0045;SYSLIB0050;SYSLIB0051</NoWarn>
    <DefineConstants>$(DefineConstants);SYSTEM_WEB;CONFIGPATHUTILITY_SYSTEMWEB;OBJECTSTATEFORMATTER</DefineConstants>
    <RehostRoslynR2RProducer>true</RehostRoslynR2RProducer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../System.Web.ReferenceSource/**/*.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Compilation/WebReferencesBuildProvider.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Compilation/WsdlBuildProvider.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Compilation/XsdBuildProvider.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Compilation/BrowserCapabilitiesCompiler.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Configuration/BrowserCapabilitiesCodeGenerator.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Configuration/StrongNameUtility.cs" />
    <Compile Remove="../System.Web.ReferenceSource/InternalApis/NDP_Common/inc/StrongNameHelpers.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Configuration/IRemoteWebConfigurationHostServer.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Configuration/RemoteWebConfigurationHost.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Configuration/RemoteWebConfigurationHostServer.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Configuration/RemoteWebConfigurationHostStream.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Management/regiisutil.cs" />
    <Compile Remove="../System.Web.ReferenceSource/Util/Transactions.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="../System.Web.ReferenceSource/UI/WebControls/RuntimeScripts/*.js;
               ../System.Web.ReferenceSource/Resources/System/Web/UI/WebControls/*.gif;
               ../System.Web.ReferenceSource/Resources/System/Web/Exceptions/*.gif"
      LogicalName="%(Filename)%(Extension)" />
    <!-- Declared as SmartNav.htm; the file on disk is lower-case. -->
    <EmbeddedResource
      Include="../System.Web.ReferenceSource/UI/WebControls/RuntimeScripts/smartnav.htm"
      LogicalName="SmartNav.htm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.WebForms.ApplicationServices/Rehost.WebForms.ApplicationServices.csproj" />
    <ProjectReference
      Include="../../eng/Rehost.WebForms.ReferenceSource.BuildInputs/Rehost.WebForms.ReferenceSource.BuildInputs.csproj"
      Private="false"
      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Tasks.Core" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.Data.SqlClient" />
    <PackageReference Include="System.DirectoryServices" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
    <PackageReference Include="System.Runtime.Caching" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="System.Security.Permissions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Root configs ship in the Rehost.WebForms metapackage, which owns the promise
         that everything they name is present; the copy here serves project-reference
         consumers only. -->
    <None
      Update="configs/*"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <!-- buildTransitive as well: consumers usually reference the Rehost.WebForms
         metapackage, and plain build/ assets do not flow through a dependency. -->
    <None
      Update="build/Rehost.WebForms.Runtime.targets"
      Pack="true"
      PackagePath="build/Rehost.WebForms.Runtime.targets;buildTransitive/Rehost.WebForms.Runtime.targets" />
  </ItemGroup>

  <Import Project="../../eng/Rehost.WebForms.GeneratedInputs/Rehost.WebForms.GeneratedInputs.targets" />
  <Import Project="../../eng/RoslynReadyToRun.targets" />
</Project>
