<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <authorization>
      <allow users="*" />
    </authorization>
    <!--
      Framework inherited its compiler entries from <system.codedom>, which .NET has no
      configuration handler for. The ASP.NET <compilers> collection is the only remaining seam.
    -->
    <compilation>
      <compilers>
        <compiler
          language="c#;cs;csharp"
          extension=".cs"
          warningLevel="4"
          compilerOptions="/langversion:7.3"
          type="System.Web.Compilation.RoslynCSharpCodeProvider, Rehost.Web" />
        <compiler
          language="vb;vbs;visualbasic;vbscript"
          extension=".vb"
          warningLevel="4"
          type="System.Web.Compilation.UnsupportedVBCodeProvider, Rehost.Web" />
      </compilers>
      <!--
        Framework's list, minus the four whose types live in assemblies this port does not carry
        (.edmx, .xoml, .svc, .xamlx); see the compatibility feature map. Types are assembly
        qualified because Framework's unqualified names resolved through System.Web itself.
        Registration resolves the type only when a file of that extension is compiled, so an
        extension listed here claims nothing about the slice that supports it.
      -->
      <buildProviders>
        <add extension=".aspx" type="System.Web.Compilation.PageBuildProvider, Rehost.Web" />
        <add extension=".ascx" type="System.Web.Compilation.UserControlBuildProvider, Rehost.Web" />
        <add extension=".master" type="System.Web.Compilation.MasterPageBuildProvider, Rehost.Web" />
        <add extension=".asmx" type="System.Web.Compilation.WebServiceBuildProvider, Rehost.Web" />
        <add extension=".ashx" type="System.Web.Compilation.WebHandlerBuildProvider, Rehost.Web" />
        <add extension=".soap" type="System.Web.Compilation.WebServiceBuildProvider, Rehost.Web" />
        <add extension=".resx" type="System.Web.Compilation.ResXBuildProvider, Rehost.Web" />
        <add extension=".resources" type="System.Web.Compilation.ResourcesBuildProvider, Rehost.Web" />
        <add extension=".wsdl" type="System.Web.Compilation.WsdlBuildProvider, Rehost.Web" />
        <add extension=".xsd" type="System.Web.Compilation.XsdBuildProvider, Rehost.Web" />
        <add extension=".js" type="System.Web.Compilation.ForceCopyBuildProvider, Rehost.Web" />
        <add extension=".lic" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.Web" />
        <add extension=".licx" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.Web" />
        <add extension=".exclude" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.Web" />
        <add extension=".refresh" type="System.Web.Compilation.IgnoreFileBuildProvider, Rehost.Web" />
      </buildProviders>
      <expressionBuilders>
        <add expressionPrefix="Resources" type="System.Web.Compilation.ResourceExpressionBuilder, Rehost.Web" />
        <add expressionPrefix="ConnectionStrings" type="System.Web.Compilation.ConnectionStringsExpressionBuilder, Rehost.Web" />
        <add expressionPrefix="AppSettings" type="System.Web.Compilation.AppSettingsExpressionBuilder, Rehost.Web" />
        <add expressionPrefix="RouteUrl" type="System.Web.Compilation.RouteUrlExpressionBuilder, Rehost.Web" />
        <add expressionPrefix="RouteValue" type="System.Web.Compilation.RouteValueExpressionBuilder, Rehost.Web" />
      </expressionBuilders>
      <assemblies>
        <!-- Framework's first entry. Compilation ignores it (the shared framework already
             supplies every reference), but BuildManager.GetType searches this list, and the
             facade's type forwards are what make a bare BCL name such as the ItemType
             "System.String" resolve. -->
        <add assembly="mscorlib" />
        <add assembly="Rehost.Web" />
        <add assembly="Rehost.Web.ApplicationServices" />
        <add assembly="Rehost.Web.Services" />
        <add assembly="Rehost.Web.Extensions" />
        <add assembly="System.Configuration.ConfigurationManager" />
        <!-- Framework lists System.Drawing; only Primitives (Color) is portable. -->
        <add assembly="System.Drawing.Primitives" />
        <add assembly="System.Data.SqlClient" />
        <add assembly="*" />
      </assemblies>
    </compilation>
    <!--
      Imports every generated file receives. Framework's list minus System.Web.DynamicData, whose
      assembly this port does not carry: an unresolvable import fails every compilation rather
      than only the code that uses it.

      <controls> keeps the Framework entries whose assemblies survive; the rest named
      System.Web.DynamicData and System.Web.Entity.
      System.Web's own WebControls needs no entry because
      PagesSection.DefaultTagNamespaceRegisterEntries hard-codes asp: for it; [assembly:TagPrefix]
      is design-time metadata that nothing in the runtime reads.

      Naming Rehost.Web.Extensions here is a deployment promise: prefix resolution loads
      every assembly registered for asp:, so an application without it fails on any asp: tag.
      Every consumer here references it explicitly until a metapackage guarantees it; see
      [runtime metapackage](../../../docs/follow-ups/runtime-metapackage.md).
    -->
    <pages>
      <namespaces>
        <add namespace="System" />
        <add namespace="System.Collections" />
        <add namespace="System.Collections.Generic" />
        <add namespace="System.Collections.Specialized" />
        <add namespace="System.ComponentModel.DataAnnotations" />
        <add namespace="System.Configuration" />
        <add namespace="System.Linq" />
        <add namespace="System.Text" />
        <add namespace="System.Text.RegularExpressions" />
        <add namespace="System.Web" />
        <add namespace="System.Web.Caching" />
        <add namespace="System.Web.SessionState" />
        <add namespace="System.Web.Security" />
        <add namespace="System.Web.Profile" />
        <add namespace="System.Web.UI" />
        <add namespace="System.Web.UI.WebControls" />
        <add namespace="System.Web.UI.WebControls.WebParts" />
        <add namespace="System.Web.UI.HtmlControls" />
        <add namespace="System.Xml.Linq" />
      </namespaces>
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI.WebControls.WebParts" assembly="Rehost.Web" />
        <add tagPrefix="asp" namespace="System.Web.UI" assembly="Rehost.Web.Extensions" />
        <add tagPrefix="asp" namespace="System.Web.UI.WebControls" assembly="Rehost.Web.Extensions" />
        <add tagPrefix="asp" namespace="System.Web.UI.WebControls.Expressions" assembly="Rehost.Web.Extensions" />
      </controls>
    </pages>
    <siteMap>
      <providers>
        <add siteMapFile="web.sitemap" name="AspNetXmlSiteMapProvider" type="System.Web.XmlSiteMapProvider, Rehost.Web" />
      </providers>
    </siteMap>
    <!--
      Without this section HttpCapabilitiesBase.GetBrowserCapabilities returns null and every
      control that consults Request.Browser throws. Framework names MobileCapabilities from
      System.Web.Mobile, which this port does not carry; its base class is the substitute, because
      dropping the element instead defaults the result to HttpCapabilitiesBase, which
      HttpRequest.Browser cannot cast. The definitions behind it come from the compiled-in
      BrowserCapabilitiesFactory and the application's App_Browsers files.
    -->
    <browserCaps userAgentCacheKeyLength="64">
      <result type="System.Web.HttpBrowserCapabilities, Rehost.Web" />
    </browserCaps>
    <hostingEnvironment />
    <httpRuntime asyncPreloadMode="None" maxRequestLength="4096" requestLengthDiskThreshold="80" fcnMode="Disabled" />
    <trust level="Full" legacyCasModel="false" />
  </system.web>
</configuration>
