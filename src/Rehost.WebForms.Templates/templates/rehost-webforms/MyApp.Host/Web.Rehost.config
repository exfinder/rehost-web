<?xml version="1.0" encoding="utf-8"?>
<!-- This file replaces the package's default transform wholesale, so the first three
     adjustments must stay. Add the application's own below them. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!-- Binding redirects target Framework strong names that do not exist here. -->
  <runtime xdt:Transform="RemoveAll" />
  <!-- The runtime owns compiler selection; DotNetCompilerPlatform is Framework-only. -->
  <system.codedom xdt:Transform="RemoveAll" />
  <system.web>
    <pages>
      <controls>
        <add xdt:Locator="Condition(@assembly='Microsoft.AspNet.Web.Optimization.WebForms')"
             xdt:Transform="SetAttributes(assembly)"
             assembly="Rehost.WebForms.Optimization.WebForms" />
      </controls>
    </pages>
  </system.web>
  <!--
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Server=127.0.0.1;Database=MyApp;User ID=...;Password=...;TrustServerCertificate=True"
         xdt:Locator="Match(name)"
         xdt:Transform="SetAttributes(connectionString)" />
  </connectionStrings>
  -->
</configuration>
