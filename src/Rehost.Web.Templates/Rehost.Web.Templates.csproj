<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>dotnet new template that adds the Rehost.Web App and Host projects beside a legacy ASP.NET application built on System.Web.</Description>
    <PackageType>Template</PackageType>
    <PackageTags>dotnet-new;templates;webforms;aspnet</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content
      Include="templates/**/*"
      Exclude="templates/**/bin/**;templates/**/obj/**;templates/**/.template.config/template.json"
      PackagePath="content" />
  </ItemGroup>

  <!-- The generated package references must name this package's own version, which is
       known only at pack time, and the central versions of the bundling dependencies. -->
  <Target Name="StampTemplateVersion" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_TemplateJsonSource>$(MSBuildProjectDirectory)/templates/rehost-web/.template.config/template.json</_TemplateJsonSource>
      <_TemplateJsonStamped>$(IntermediateOutputPath)template.json</_TemplateJsonStamped>
      <_TemplateAntlrVersion>@(PackageVersion->WithMetadataValue('Identity', 'Antlr')->'%(Version)')</_TemplateAntlrVersion>
      <_TemplateWebGreaseVersion>@(PackageVersion->WithMetadataValue('Identity', 'WebGrease')->'%(Version)')</_TemplateWebGreaseVersion>
    </PropertyGroup>
    <Error
      Condition="'$(_TemplateAntlrVersion)' == '' or '$(_TemplateWebGreaseVersion)' == ''"
      Text="Directory.Packages.props must declare PackageVersion items for Antlr and WebGrease." />
    <WriteLinesToFile
      File="$(_TemplateJsonStamped)"
      Lines="$([System.IO.File]::ReadAllText('$(_TemplateJsonSource)').Replace('REHOST_PACKAGE_VERSION', '$(PackageVersion)').Replace('ANTLR_PACKAGE_VERSION', '$(_TemplateAntlrVersion)').Replace('WEBGREASE_PACKAGE_VERSION', '$(_TemplateWebGreaseVersion)'))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content
        Include="$(_TemplateJsonStamped)"
        Pack="true"
        PackagePath="content/rehost-web/.template.config/" />
    </ItemGroup>
  </Target>
</Project>
