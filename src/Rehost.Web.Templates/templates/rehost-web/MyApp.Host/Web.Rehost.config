<?xml version="1.0" encoding="utf-8"?>
<!-- This file replaces the package's default transform wholesale, so the first three
     adjustments must stay. Each InsertIfMissing line keeps the RemoveAll after it from
     warning when the application lacks that section. Add the application's own below them. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!-- Binding redirects target Framework strong names that do not exist here. -->
  <runtime xdt:Transform="InsertIfMissing" />
  <runtime xdt:Transform="RemoveAll" />
  <!-- The runtime owns compiler selection; DotNetCompilerPlatform is Framework-only. -->
  <system.codedom xdt:Transform="InsertIfMissing" />
  <system.codedom xdt:Transform="RemoveAll" />
  <!-- WCF is not part of this runtime; its configuration section is not declared. -->
  <system.serviceModel xdt:Transform="InsertIfMissing" />
  <system.serviceModel xdt:Transform="RemoveAll" />
  <!--
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Server=127.0.0.1;Database=MyApp;User ID=...;Password=...;TrustServerCertificate=True"
         xdt:Locator="Match(name)"
         xdt:Transform="SetAttributes(connectionString)" />
  </connectionStrings>
  -->
</configuration>
