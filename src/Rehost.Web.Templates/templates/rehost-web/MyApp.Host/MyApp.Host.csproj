<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RehostSiteContentRoot>../WEBAPP_PATH/</RehostSiteContentRoot>
    <OutDir>rehost_root/bin/</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.Web.AspNetCore" Version="REHOST_VERSION" />
    <ProjectReference Include="../MyApp.App/MyApp.App.csproj" />
  </ItemGroup>
</Project>
