<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>System.Web.WebPages.Deployment</RootNamespace>
    <Description>ASP.NET Web Pages deployment support over the Rehost.WebForms ASP.NET runtime.</Description>
    <RehostAssemblyVersion>3.0.0.0</RehostAssemblyVersion>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);ASPNETWEBPAGES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Common/CommonResources.resx" LogicalName="System.Web.WebPages.Deployment.Common.CommonResources.resources" />
    <EmbeddedResource Update="Resources/ConfigurationResources.resx" LogicalName="System.Web.WebPages.Deployment.Resources.ConfigurationResources.resources" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.WebForms/Rehost.WebForms.csproj" />
    <ProjectReference Include="../Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Rehost.Web.Infrastructure/Rehost.Web.Infrastructure.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
