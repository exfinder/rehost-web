<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Rehost.WebForms.Optimization</AssemblyName>
    <RootNamespace>System.Web.Optimization</RootNamespace>
    <Description>ASP.NET script and stylesheet optimization for Rehost.WebForms.</Description>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS3001;CS3002;CS3003;SYSLIB0021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../System.Web.Optimization.ReferenceSource/**/*.cs" />
    <Compile Remove="../System.Web.Optimization.ReferenceSource/Properties/AssemblyMetadataAttribute.cs" />
    <Compile Remove="../System.Web.Optimization.ReferenceSource/PreApplicationStartCode.cs" />
    <EmbeddedResource
      Include="../System.Web.Optimization.ReferenceSource/Resources/OptimizationResources.resx"
      LogicalName="System.Web.Optimization.Resources.OptimizationResources.resources" />
    <EmbeddedResource
      Include="../System.Web.Optimization.ReferenceSource/BundleManifestSchema.xsd"
      LogicalName="System.Web.Optimization.BundleManifestSchema.xsd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr" NoWarn="NU1701" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="WebGrease" NoWarn="NU1701" />
  </ItemGroup>

  <Target
    Name="PreferRehostWebFormsRuntimeTypes"
    AfterTargets="ResolveAssemblyReferences"
    BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath
        Remove="@(ReferencePath)"
        Condition="'%(ReferencePath.NuGetPackageId)' == 'Microsoft.NETCore.App.Ref' and ('%(ReferencePath.FileName)' == 'System.Web' or '%(ReferencePath.FileName)' == 'System.Web.HttpUtility')" />
    </ItemGroup>
  </Target>
</Project>
