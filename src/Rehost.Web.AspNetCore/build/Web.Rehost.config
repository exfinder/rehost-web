<?xml version="1.0" encoding="utf-8"?>
<!-- Default rehost adjustments applied when staging web.config. An application
     replaces this wholesale by placing Web.Rehost.config beside its host project
     or setting RehostWebConfigTransform. Each InsertIfMissing line keeps the
     RemoveAll after it from warning when the application lacks that section.
     Staging rewrites Framework assembly names in every web.config after this
     transform, so no row here renames one. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!-- Binding redirects target Framework strong names that do not exist here; probing is kept and honored. -->
  <runtime xdt:Transform="InsertIfMissing">
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" xdt:Transform="InsertIfMissing">
      <dependentAssembly xdt:Transform="InsertIfMissing" />
      <dependentAssembly xdt:Transform="RemoveAll" />
    </assemblyBinding>
  </runtime>
  <!-- The runtime owns compiler selection; DotNetCompilerPlatform is Framework-only. -->
  <system.codedom xdt:Transform="InsertIfMissing" />
  <system.codedom xdt:Transform="RemoveAll" />
  <!-- WCF is not part of this runtime; its configuration section is not declared. -->
  <system.serviceModel xdt:Transform="InsertIfMissing" />
  <system.serviceModel xdt:Transform="RemoveAll" />
</configuration>
