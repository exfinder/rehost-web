<?xml version="1.0" encoding="utf-8"?>
<!-- Default rehost adjustments applied when staging web.config. An application
     replaces this wholesale by placing Web.Rehost.config beside its host project
     or setting RehostWebConfigTransform. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!-- Binding redirects target Framework strong names that do not exist here. -->
  <runtime xdt:Transform="RemoveAll" />
  <!-- The runtime owns compiler selection; DotNetCompilerPlatform is Framework-only. -->
  <system.codedom xdt:Transform="RemoveAll" />
  <!-- WCF is not part of this runtime; its configuration section is not declared.
       InsertIfMissing keeps RemoveAll from warning when the section is absent. -->
  <system.serviceModel xdt:Transform="InsertIfMissing" />
  <system.serviceModel xdt:Transform="RemoveAll" />
  <system.web>
    <pages>
      <controls>
        <add xdt:Locator="Condition(@assembly='Microsoft.AspNet.Web.Optimization.WebForms')"
             xdt:Transform="SetAttributes(assembly)"
             assembly="Rehost.AspNet.Web.Optimization.WebForms" />
      </controls>
    </pages>
  </system.web>
</configuration>
