<Project>
  <!-- Consumer contract: setting RehostSiteContentRoot on an Exe project turns on site
       staging, and the project sets OutDir to $(RehostStagedSiteRoot)bin/ so the compiler
       writes the payload straight into the site. Build stages an always-current runnable
       site (content + transformed web.config) under RehostStagedSiteRoot, rehost_root/
       beside the project by default; Publish produces the same layout under
       RehostPublishSiteRoot with Web.$(Configuration).config applied first, matching
       Framework publish semantics. Staging is incremental and manifest-driven: removed
       sources are deleted from the stage, never by wiping the tree.

       OutDir cannot be set here: the SDK derives TargetPath, RunCommand and the deps and
       runtimeconfig paths from it before package targets import, so a late override leaves
       them pointing at the default output folder. -->

  <!-- A PublishDir from the command line (dotnet publish -o) cannot be reassigned during
       evaluation, which is how the probe below recognizes it. The folder the user named
       becomes the published site's root, and RehostRedirectPublishDir moves the payload to
       its bin before the SDK copies anything. -->
  <PropertyGroup Condition="'$(RehostSiteContentRoot)' != '' and '$(RehostPublishSiteLayout)' != 'false'">
    <_RehostRequestedPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_RehostRequestedPublishDir>
    <PublishDir>rehost-publish-dir-probe/</PublishDir>
    <_RehostPublishDirFromCommandLine Condition="'$(PublishDir)' != 'rehost-publish-dir-probe/'">true</_RehostPublishDirFromCommandLine>
    <_RehostPublishSiteRootExplicit Condition="'$(RehostPublishSiteRoot)' != ''">true</_RehostPublishSiteRootExplicit>
    <RehostPublishSiteRoot Condition="'$(RehostPublishSiteRoot)' == '' and '$(_RehostPublishDirFromCommandLine)' == 'true'">$(_RehostRequestedPublishDir)</RehostPublishSiteRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RehostSiteContentRoot)' != ''">
    <RehostSiteContentRoot>$([MSBuild]::EnsureTrailingSlash('$(RehostSiteContentRoot)'))</RehostSiteContentRoot>
    <RehostStageOnBuild Condition="'$(RehostStageOnBuild)' == ''">true</RehostStageOnBuild>
    <RehostStagedSiteRoot Condition="'$(RehostStagedSiteRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'rehost_root'))</RehostStagedSiteRoot>
    <RehostStagedSiteRoot>$([MSBuild]::EnsureTrailingSlash('$(RehostStagedSiteRoot)'))</RehostStagedSiteRoot>
    <RehostPublishSiteRoot Condition="'$(RehostPublishSiteRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutputPath)', 'site-publish'))</RehostPublishSiteRoot>
    <RehostPublishSiteRoot>$([MSBuild]::EnsureTrailingSlash('$(RehostPublishSiteRoot)'))</RehostPublishSiteRoot>
    <!-- The stage sits beside the project, where the SDK's default globs would otherwise
         compile its sources and ship its content. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(RehostStagedSiteRoot)**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The Web SDK's content glob would copy the transform beside the payload. -->
  <ItemGroup Condition="'$(RehostSiteContentRoot)' != ''">
    <Content Remove="$(MSBuildProjectDirectory)/Web.Rehost.config" />
    <None Include="$(MSBuildProjectDirectory)/Web.Rehost.config" Condition="Exists('$(MSBuildProjectDirectory)/Web.Rehost.config')" />
  </ItemGroup>

  <!-- Publish payload goes straight into the published site's bin so the deployable is
       the site folder itself, same shape as the dev stage. -->
  <PropertyGroup Condition="'$(RehostSiteContentRoot)' != '' and '$(RehostPublishSiteLayout)' != 'false'">
    <PublishDir>$(RehostPublishSiteRoot)bin/</PublishDir>
    <!-- The Web SDK's publish step would write an ASP.NET Core Module web.config into the
         published bin; the site's own web.config at the root is the one that applies. -->
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RehostSiteContentRoot)' != '' and '$(OutputType)' == 'Exe'">
    <RunCommand>dotnet</RunCommand>
    <RunArguments>"$(RehostStagedSiteRoot)bin/$(TargetFileName)"</RunArguments>
    <RunWorkingDirectory>$(RehostStagedSiteRoot)</RunWorkingDirectory>
  </PropertyGroup>

  <Target
    Name="RehostRedirectPublishDir"
    BeforeTargets="PrepareForPublish"
    Condition="'$(RehostSiteContentRoot)' != '' and '$(RehostPublishSiteLayout)' != 'false' and '$(_RehostPublishDirFromCommandLine)' == 'true' and '$(_RehostStageInvocation)' == ''">
    <PropertyGroup>
      <_RehostPublishRoot>$([MSBuild]::NormalizeDirectory('$(RehostPublishSiteRoot)'))</_RehostPublishRoot>
      <_RehostPublishBin>$([MSBuild]::NormalizeDirectory('$(RehostPublishSiteRoot)', 'bin'))</_RehostPublishBin>
    </PropertyGroup>
    <Error
      Condition="'$(_RehostPublishSiteRootExplicit)' == 'true' and '$(_RehostRequestedPublishDir)' != '$(_RehostPublishRoot)' and '$(_RehostRequestedPublishDir)' != '$(_RehostPublishBin)'"
      Text="The publish output '$(_RehostRequestedPublishDir)' and RehostPublishSiteRoot '$(_RehostPublishRoot)' name different folders. Remove one of them: either names the published site's root, and the payload goes to its bin." />
    <PropertyGroup>
      <PublishDir>$(_RehostPublishBin)</PublishDir>
    </PropertyGroup>
  </Target>

  <Target
    Name="RehostVerifyOutDir"
    BeforeTargets="BeforeBuild"
    Condition="'$(RehostSiteContentRoot)' != '' and '$(RehostStageOnBuild)' == 'true' and '$(_RehostStageInvocation)' == ''">
    <PropertyGroup>
      <_RehostOutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))</_RehostOutDir>
      <_RehostStagedBin>$([MSBuild]::NormalizeDirectory('$(RehostStagedSiteRoot)', 'bin'))</_RehostStagedBin>
    </PropertyGroup>
    <Error
      Condition="'$(_RehostOutDir)' != '$(_RehostStagedBin)'"
      Text="RehostSiteContentRoot stages the site under '$(RehostStagedSiteRoot)', so the project must build into its bin: add &lt;OutDir&gt;rehost_root/bin/&lt;/OutDir&gt; (or the bin of the RehostStagedSiteRoot you set) to the project." />
  </Target>

  <Target
    Name="RehostStageSite"
    AfterTargets="Build"
    Condition="'$(RehostSiteContentRoot)' != '' and '$(RehostStageOnBuild)' == 'true' and '$(_RehostStageInvocation)' == ''">
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="RehostStageCore"
      Properties="_RehostStageInvocation=build;RehostStageRoot=$(RehostStagedSiteRoot);RehostApplyConfigurationTransform=false" />
  </Target>

  <Target
    Name="RehostPublishSite"
    AfterTargets="Publish"
    Condition="'$(RehostSiteContentRoot)' != '' and '$(_RehostStageInvocation)' == ''">
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="RehostStageCore"
      Properties="_RehostStageInvocation=publish;RehostStageRoot=$(RehostPublishSiteRoot);RehostApplyConfigurationTransform=true" />
  </Target>

  <Target
    Name="RehostStageCore"
    Condition="'$(_RehostStageInvocation)' != '' and '$(RehostStageRoot)' != ''"
    DependsOnTargets="RehostComputeStageItems;RehostCopyStagedFiles;RehostTransformStagedWebConfig;RehostRetargetStagedConfigAssemblyNames;RehostCleanStaleStagedFiles;RehostVerifyStagedSite;RehostWriteStageManifest" />

  <Target Name="RehostComputeStageItems">
    <ItemGroup>
      <_RehostRootFile Include="$(RehostSiteContentRoot)*" />
      <_RehostRootWebConfig Include="@(_RehostRootFile)" Condition="'%(Filename)%(Extension)' == 'web.config'" />
      <_RehostRootConfigurationTransform Include="@(_RehostRootFile)" Condition="'%(Filename)%(Extension)' == 'web.$(Configuration).config'" />
      <_RehostRootConfig Include="@(_RehostRootFile)" Condition="'%(Extension)' == '.config' and ('%(Filename)' == 'web' or $([System.String]::Copy('%(Filename)').ToLowerInvariant().StartsWith('web.')))" />
    </ItemGroup>
    <Error
      Condition="'@(_RehostRootWebConfig)' == ''"
      Text="RehostSiteContentRoot '$(RehostSiteContentRoot)' does not contain a Web.config." />

    <PropertyGroup>
      <_RehostWebConfigTransform Condition="'$(RehostWebConfigTransform)' != ''">$(RehostWebConfigTransform)</_RehostWebConfigTransform>
      <_RehostWebConfigTransform Condition="'$(_RehostWebConfigTransform)' == '' and Exists('$(MSBuildProjectDirectory)/Web.Rehost.config')">$(MSBuildProjectDirectory)/Web.Rehost.config</_RehostWebConfigTransform>
      <_RehostWebConfigTransform Condition="'$(_RehostWebConfigTransform)' == ''">$(MSBuildThisFileDirectory)Web.Rehost.config</_RehostWebConfigTransform>
      <_RehostConfigurationTransform>@(_RehostRootConfigurationTransform)</_RehostConfigurationTransform>
      <!-- One manifest per stage root: a manifest shared between roots makes a publish to one
           folder delete the files an earlier publish staged in another. -->
      <_RehostStageManifest>$(IntermediateOutputPath)rehost-stage-$(_RehostStageInvocation)-$([MSBuild]::StableStringHash('$(RehostStageRoot)')).manifest</_RehostStageManifest>
      <_RehostWebConfigSources>@(_RehostRootWebConfig);$(_RehostWebConfigTransform)</_RehostWebConfigSources>
      <_RehostWebConfigSources Condition="'$(RehostApplyConfigurationTransform)' == 'true' and Exists('$(_RehostConfigurationTransform)')">$(_RehostWebConfigSources);$(_RehostConfigurationTransform)</_RehostWebConfigSources>
      <!-- Timestamps alone miss a switch to sources older than the staged web.config. Keyed by
           stage root only, because every configuration stages into the same root. -->
      <_RehostWebConfigSourcesFile>$(BaseIntermediateOutputPath)rehost-stage-$([MSBuild]::StableStringHash('$(RehostStageRoot)')).webconfig-sources</_RehostWebConfigSourcesFile>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(_RehostWebConfigSourcesFile)"
      Lines="$(_RehostWebConfigSources)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <_RehostSiteContent
        Include="$(RehostSiteContentRoot)**/*"
        Exclude="$(RehostSiteContentRoot)**/*.cs;$(RehostSiteContentRoot)**/*.csproj;$(RehostSiteContentRoot)**/*.user;$(RehostSiteContentRoot)bin/**;$(RehostSiteContentRoot)obj/**;$(RehostSiteContentRoot)packages/**;$(RehostSiteContentRoot)packages.config;@(_RehostRootConfig);$(RehostSiteContentRoot).vs/**;$(RehostSiteContentExcludes)" />
      <_RehostDesired Include="@(_RehostSiteContent->'$(RehostStageRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
      <_RehostDesired Include="$(RehostStageRoot)web.config" />
    </ItemGroup>
  </Target>

  <Target Name="RehostCopyStagedFiles">
    <ItemGroup Condition="'$(_RehostStageInvocation)' == 'build'">
      <_RehostSiteContent Remove="@(_RehostSiteContent)" Condition="$([System.String]::Copy('%(RecursiveDir)').StartsWith('App_Data')) and Exists('$(RehostStageRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_RehostSiteContent)"
      DestinationFiles="@(_RehostSiteContent->'$(RehostStageRoot)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target
    Name="RehostTransformStagedWebConfig"
    Inputs="$(_RehostWebConfigSources);$(_RehostWebConfigSourcesFile)"
    Outputs="$(RehostStageRoot)web.config">
    <PropertyGroup>
      <_RehostConfigSource>@(_RehostRootWebConfig)</_RehostConfigSource>
    </PropertyGroup>

    <ApplyXdtTransform
      Condition="'$(RehostApplyConfigurationTransform)' == 'true' and Exists('$(_RehostConfigurationTransform)')"
      Source="$(_RehostConfigSource)"
      Transform="$(_RehostConfigurationTransform)"
      Destination="$(IntermediateOutputPath)rehost-web.$(Configuration).config" />
    <PropertyGroup Condition="'$(RehostApplyConfigurationTransform)' == 'true' and Exists('$(_RehostConfigurationTransform)')">
      <_RehostConfigSource>$(IntermediateOutputPath)rehost-web.$(Configuration).config</_RehostConfigSource>
    </PropertyGroup>

    <ApplyXdtTransform
      Source="$(_RehostConfigSource)"
      Transform="$(_RehostWebConfigTransform)"
      Destination="$(RehostStageRoot)web.config" />
  </Target>

  <Target Name="RehostRetargetStagedConfigAssemblyNames">
    <ItemGroup>
      <_RehostNestedWebConfig Include="@(_RehostSiteContent)" Condition="'%(Filename)%(Extension)' == 'web.config'" />
      <_RehostStagedWebConfig Include="$(RehostStageRoot)web.config;@(_RehostNestedWebConfig->'$(RehostStageRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <RetargetConfigAssemblyNames Files="@(_RehostStagedWebConfig)" />
  </Target>

  <Target Name="RehostCleanStaleStagedFiles">
    <ReadLinesFromFile File="$(_RehostStageManifest)" Condition="Exists('$(_RehostStageManifest)')">
      <Output TaskParameter="Lines" ItemName="_RehostPreviouslyStaged" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RehostStale Include="@(_RehostPreviouslyStaged)" Exclude="@(_RehostDesired)" />
    </ItemGroup>
    <Delete Files="@(_RehostStale)" />
  </Target>

  <!-- Guard: a successful build means the staged site is complete. -->
  <Target Name="RehostVerifyStagedSite">
    <Error
      Condition="!Exists('%(_RehostDesired.Identity)')"
      Text="Staged site is missing '%(_RehostDesired.Identity)'; the stage is incomplete." />
  </Target>

  <Target Name="RehostWriteStageManifest">
    <WriteLinesToFile
      File="$(_RehostStageManifest)"
      Lines="@(_RehostDesired)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
