<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>System.Web.Http.WebHost</RootNamespace>
    <PackageId>Rehost.AspNet.WebApi.WebHost</PackageId>
    <Description>ASP.NET Web API 2 host over the Rehost.Web ASP.NET request pipeline.</Description>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);ASPNETMVC</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Common/CommonWebApiResources.resx" LogicalName="System.Web.Http.WebHost.Properties.CommonWebApiResources.resources" />
    <EmbeddedResource Update="Properties/SRResources.resx" LogicalName="System.Web.Http.WebHost.Properties.SRResources.resources" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.Web.Package/Rehost.Web.Package.csproj" />
    <ProjectReference Include="../Rehost.Web/Rehost.Web.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" NoWarn="NU1701" />
  </ItemGroup>
</Project>
