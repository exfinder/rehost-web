<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rehost.ScriptManager.WebForms</RootNamespace>
    <PackageId>Rehost.AspNet.ScriptManager.WebForms</PackageId>
    <Description>ScriptManager mapping for WebFormsBundle on Rehost.Web, replacing Microsoft.AspNet.ScriptManager.WebForms.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.Web.Package/Rehost.Web.Package.csproj" />
    <ProjectReference Include="../Rehost.Web.Extensions/Rehost.Web.Extensions.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Rehost.Web/Rehost.Web.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
