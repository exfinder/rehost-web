<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>System.Web.WebPages.Razor</RootNamespace>
    <Description>ASP.NET Web Pages Razor build provider over the Rehost.Web ASP.NET runtime.</Description>
    <RehostAssemblyVersion>3.0.0.0</RehostAssemblyVersion>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);ASPNETWEBPAGES</DefineConstants>
    <NoWarn>$(NoWarn);CS3001;CS3003;CS3009</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Common/CommonResources.resx" LogicalName="System.Web.WebPages.Razor.Common.CommonResources.resources" />
    <EmbeddedResource Update="Resources/RazorWebResources.resx" LogicalName="System.Web.WebPages.Razor.Resources.RazorWebResources.resources" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.Web.Package/Rehost.Web.Package.csproj" />
    <ProjectReference Include="../Rehost.Web/Rehost.Web.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Rehost.Web.WebPages/Rehost.Web.WebPages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Razor" NoWarn="NU1701" />
  </ItemGroup>
</Project>
