<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Rehost.WebForms.Optimization.WebForms</AssemblyName>
    <RootNamespace>Microsoft.AspNet.Web.Optimization.WebForms</RootNamespace>
    <Description>Web Forms controls for Rehost.WebForms optimization bundles.</Description>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Microsoft.AspNet.Web.Optimization.WebForms.ReferenceSource/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.WebForms.Optimization/Rehost.WebForms.Optimization.csproj" />
    <ProjectReference Include="../Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
  </ItemGroup>
</Project>
