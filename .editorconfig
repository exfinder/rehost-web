root = true

[*.cs]
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Imported Reference Source reaches Windows-only providers by design; the
# portable runtime either excludes those features or fails with a diagnostic.
# CA1416 stays on for authored code, where a new Windows-only dependency is a
# portability defect rather than an inherited one.
[src/System.Web.ReferenceSource/**.cs]
dotnet_diagnostic.CA1416.severity = none

[src/System.Web.Extensions.ReferenceSource/**.cs]
dotnet_diagnostic.CA1416.severity = none

[src/Rehost.Web/Compatibility/Resources/**.cs]
dotnet_diagnostic.CA1416.severity = none
