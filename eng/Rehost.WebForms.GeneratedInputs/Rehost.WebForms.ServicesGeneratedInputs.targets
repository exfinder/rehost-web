<Project>
  <PropertyGroup>
    <ServicesGeneratedInputsDir>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/generated/System.Web.Services/</ServicesGeneratedInputsDir>
    <GeneratedInputsToolProject>$(MSBuildThisFileDirectory)Rehost.WebForms.GeneratedInputs.csproj</GeneratedInputsToolProject>
  </PropertyGroup>

  <ItemGroup>
    <_ServicesGeneratorInput Include="$(MSBuildThisFileFullPath)" />
    <_ServicesGeneratorInput Include="$(GeneratedInputsToolProject)" />
    <_ServicesGeneratorInput Include="$(MSBuildThisFileDirectory)Program.cs" />
    <_ServicesGeneratorInput Include="$(MSBuildThisFileDirectory)../../src/System.Web.Services.ReferenceSource/System.Web.Services.txt" />

    <_ServicesGeneratedSource Include="$(ServicesGeneratedInputsDir)Res.g.cs" />
    <_ServicesGeneratedResource Include="$(ServicesGeneratedInputsDir)System.Web.Services.resources" />
    <_ServicesGeneratorOutput Include="@(_ServicesGeneratedSource);@(_ServicesGeneratedResource)" />

    <Compile Include="@(_ServicesGeneratedSource)" />
    <EmbeddedResource Include="@(_ServicesGeneratedResource)"
                      LogicalName="System.Web.Services.resources" />
  </ItemGroup>

  <Target Name="GenerateSystemWebServicesBuildInputs"
          BeforeTargets="PrepareForBuild"
          Inputs="@(_ServicesGeneratorInput)"
          Outputs="@(_ServicesGeneratorOutput)">
    <MSBuild Projects="$(GeneratedInputsToolProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_GeneratedInputsToolOutput" />
    </MSBuild>
    <Exec Command="dotnet &quot;%(_GeneratedInputsToolOutput.Identity)&quot; generate-services &quot;$(MSBuildThisFileDirectory)../..&quot; &quot;$(ServicesGeneratedInputsDir)&quot;" />
  </Target>
</Project>
