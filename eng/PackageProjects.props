<Project>
  <!-- The public package set. The local feed packs it; the package tests inspect it. -->
  <PropertyGroup>
    <RehostRepoRoot Condition="'$(RehostRepoRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RehostRepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.AspNet.WebApi.WebHost/Rehost.AspNet.WebApi.WebHost.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.WebForms/Rehost.WebForms.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.WebForms.FriendlyUrls/Rehost.WebForms.FriendlyUrls.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.WebForms.Hosting/Rehost.WebForms.Hosting.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.WebForms.Optimization/Rehost.WebForms.Optimization.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.WebForms.Optimization.WebForms/Rehost.WebForms.Optimization.WebForms.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.WebForms.Owin.Host.SystemWeb/Rehost.WebForms.Owin.Host.SystemWeb.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.WebForms.ScriptManager.Bundles/Rehost.WebForms.ScriptManager.Bundles.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.WebForms.Templates/Rehost.WebForms.Templates.csproj" />
  </ItemGroup>

  <!-- Everything a package's content can depend on. Broad on purpose: a hand-maintained
       per-project list once missed Extensions' embedded Scripts/*.js and shipped a stale
       package. False repacks are cheap; stale packages are not. -->
  <ItemGroup>
    <RehostPackageSource
      Include="$(RehostRepoRoot)src/**/*;$(RehostRepoRoot)eng/Rehost.WebForms.Build.Tasks/**/*;$(RehostRepoRoot)eng/Rehost.WebForms.GeneratedInputs/**/*"
      Exclude="$(RehostRepoRoot)src/**/bin/**;$(RehostRepoRoot)src/**/obj/**;$(RehostRepoRoot)eng/**/bin/**;$(RehostRepoRoot)eng/**/obj/**" />
    <RehostPackageSource Include="$(RehostRepoRoot)Directory.Packages.props;$(RehostRepoRoot)global.json;$(MSBuildThisFileFullPath)" />
  </ItemGroup>
</Project>
