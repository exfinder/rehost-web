<Project>
  <!-- The public package set. The local feed packs it; the package tests inspect it. -->
  <PropertyGroup>
    <RehostRepoRoot Condition="'$(RehostRepoRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RehostRepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.AspNet.FriendlyUrls/Rehost.AspNet.FriendlyUrls.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.AspNet.Web.Optimization.WebForms/Rehost.AspNet.Web.Optimization.WebForms.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.AspNet.WebPages/Rehost.AspNet.WebPages.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.Owin.Host.SystemWeb/Rehost.Owin.Host.SystemWeb.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.ScriptManager.MSAjax/Rehost.ScriptManager.MSAjax.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.ScriptManager.WebForms/Rehost.ScriptManager.WebForms.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.Web.AspNetCore/Rehost.Web.AspNetCore.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.Web.Http.WebHost/Rehost.Web.Http.WebHost.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.Web.Optimization/Rehost.Web.Optimization.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.Web.Package/Rehost.Web.Package.csproj" />
    <RehostPackageProject Include="$(RehostRepoRoot)src/Rehost.Web.Templates/Rehost.Web.Templates.csproj" />
  </ItemGroup>

  <!-- Everything a package's content can depend on. Broad on purpose: a hand-maintained
       per-project list once missed Extensions' embedded Scripts/*.js and shipped a stale
       package. False repacks are cheap; stale packages are not. -->
  <ItemGroup>
    <RehostPackageSource
      Include="$(RehostRepoRoot)src/**/*;$(RehostRepoRoot)eng/Rehost.Web.Build.Tasks/**/*;$(RehostRepoRoot)eng/Rehost.Web.GeneratedInputs/**/*"
      Exclude="$(RehostRepoRoot)src/**/bin/**;$(RehostRepoRoot)src/**/obj/**;$(RehostRepoRoot)eng/**/bin/**;$(RehostRepoRoot)eng/**/obj/**" />
    <RehostPackageSource Include="$(RehostRepoRoot)Directory.Packages.props;$(RehostRepoRoot)global.json;$(MSBuildThisFileFullPath)" />
  </ItemGroup>
</Project>
