<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the package default wholesale, so it repeats the default
     adjustments before the app-specific ones. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <runtime xdt:Transform="RemoveAll" />
  <system.web>
    <pages>
      <controls>
        <add xdt:Locator="Condition(@assembly='Microsoft.AspNet.Web.Optimization.WebForms')"
             xdt:Transform="SetAttributes(assembly)"
             assembly="Rehost.WebForms.Optimization.WebForms" />
      </controls>
    </pages>
  </system.web>
  <system.webServer>
    <modules>
      <!-- Elmah.dll binds Framework's strong-named System.Web and has no portable
           build; a module row whose type will not load fails its URLs. No
           application code references Elmah. -->
      <add name="ErrorLog" xdt:Transform="Remove" xdt:Locator="Match(name)" />
      <add name="ErrorMail" xdt:Transform="Remove" xdt:Locator="Match(name)" />
      <add name="ErrorFilter" xdt:Transform="Remove" xdt:Locator="Match(name)" />
    </modules>
  </system.webServer>
  <!-- The block only registers the Elmah handler removed above, and this port
       honors <system.webServer> in the application root alone. -->
  <location path="elmah.axd" xdt:Transform="Remove" xdt:Locator="Match(path)" />
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Data Source=127.0.0.1,14333;Initial Catalog=aspnet-WingtipToys;User ID=sa;Password=Rehost!Dev2026;TrustServerCertificate=True"
         xdt:Locator="Match(name)"
         xdt:Transform="SetAttributes(connectionString)" />
    <!-- AttachDbFilename is a LocalDb user-instance feature with no container
         equivalent, so the file store becomes a named catalog. -->
    <add name="WingtipToys"
         connectionString="Data Source=127.0.0.1,14333;Initial Catalog=WingtipToys;User ID=sa;Password=Rehost!Dev2026;TrustServerCertificate=True"
         xdt:Locator="Match(name)"
         xdt:Transform="SetAttributes(connectionString)" />
  </connectionStrings>
</configuration>
