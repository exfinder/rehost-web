<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WingtipToys</AssemblyName>
    <RootNamespace>WingtipToys</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RehostAppContentRoot>../WingtipToys/</RehostAppContentRoot>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.WebForms" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Rehost.WebForms.FriendlyUrls" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Rehost.WebForms.Optimization" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Rehost.WebForms.Optimization.WebForms" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Rehost.WebForms.Owin.Host.SystemWeb" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Rehost.WebForms.ScriptManager.Bundles" Version="$(RehostWebFormsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="Microsoft.AspNet.Identity.Core" Version="2.2.4" />
    <PackageReference Include="Microsoft.AspNet.Identity.EntityFramework" Version="2.2.4" />
    <PackageReference Include="Microsoft.AspNet.Identity.Owin" Version="2.2.4" />
    <PackageReference Include="Microsoft.Owin" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.Security" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.Security.Cookies" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.Security.Facebook" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.Security.Google" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.Security.MicrosoftAccount" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.Security.OAuth" Version="4.2.3" />
    <PackageReference Include="Microsoft.Owin.Security.Twitter" Version="4.2.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Owin" Version="1.0.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../System.Net.Http.WebRequest/System.Net.Http.WebRequest.csproj" />
  </ItemGroup>
</Project>
