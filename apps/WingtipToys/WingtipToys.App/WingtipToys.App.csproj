<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WingtipToys</AssemblyName>
    <RootNamespace>WingtipToys</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RehostAppContentRoot>../WingtipToys/</RehostAppContentRoot>
    <NoWarn>$(NoWarn);SYSLIB0014;CS0252</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RehostAppContentRoot)**/*.cs" />
    <Compile Remove="$(RehostAppContentRoot)bin/**" />
    <Compile Remove="$(RehostAppContentRoot)obj/**" />
    <Compile Remove="$(RehostAppContentRoot)packages/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.Web" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.FriendlyUrls" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.Web.Optimization" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.Web.Optimization.WebForms" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.Owin.Host.SystemWeb" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.ScriptManager.MSAjax" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.ScriptManager.WebForms" Version="$(RehostVersion)" />
    <PackageReference Include="Antlr" Version="3.5.0.2" NoWarn="NU1701" />
    <PackageReference Include="WebGrease" Version="1.6.0" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="Microsoft.AspNet.Identity.Core" Version="2.2.4" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.AspNet.Identity.EntityFramework" Version="2.2.4" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.AspNet.Identity.Owin" Version="2.2.4" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.Cookies" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.Facebook" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.Google" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.MicrosoftAccount" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.OAuth" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.Twitter" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Owin" Version="1.0.0" NoWarn="NU1701" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../System.Net.Http.WebRequest/System.Net.Http.WebRequest.csproj" />
  </ItemGroup>
</Project>
