<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the package default wholesale, so it repeats the default
     adjustments before the app-specific ones. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <runtime xdt:Transform="RemoveAll" />
  <system.serviceModel xdt:Transform="RemoveAll" />
  <!-- BlogEngine on SQLite: the differences setup/SQLite/SQLiteWeb.Config makes to Web.Config.
       The path separator is "/": off Windows a "\" becomes part of the file name. -->
  <BlogEngine>
    <blogProvider defaultProvider="DbBlogProvider" xdt:Transform="SetAttributes(defaultProvider)">
      <providers>
        <add connectionStringName="BlogEngine" description="Sql Database Provider" name="DbBlogProvider" type="BlogEngine.Core.Providers.DbBlogProvider, BlogEngine.Core" xdt:Transform="Insert" />
      </providers>
    </blogProvider>
  </BlogEngine>
  <connectionStrings xdt:Transform="Insert">
    <clear />
    <add name="BlogEngine" connectionString="Data Source=|DataDirectory|/BlogEngine.s3db;Version=3;BinaryGUID=False;" providerName="System.Data.SQLite" />
  </connectionStrings>
  <system.data xdt:Transform="Insert">
    <DbProviderFactories>
      <remove invariant="System.Data.SQLite" />
      <add name="SQLite Data Provider" invariant="System.Data.SQLite" description=".Net Framework Data Provider for SQLite" type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite" />
    </DbProviderFactories>
  </system.data>
  <system.web>
    <compilation>
      <assemblies>
        <add xdt:Locator="Condition(starts-with(@assembly,'System.Management,'))" xdt:Transform="Remove" />
        <add xdt:Locator="Condition(starts-with(@assembly,'System.Net.Http.WebRequest,'))" xdt:Transform="Remove" />
      </assemblies>
    </compilation>
    <membership defaultProvider="DbMembershipProvider" xdt:Transform="SetAttributes(defaultProvider)">
      <providers>
        <add name="DbMembershipProvider" type="BlogEngine.Core.Providers.DbMembershipProvider, BlogEngine.Core" passwordFormat="Hashed" connectionStringName="BlogEngine" xdt:Transform="Insert" />
      </providers>
    </membership>
    <roleManager defaultProvider="DbRoleProvider" xdt:Transform="SetAttributes(defaultProvider)">
      <providers>
        <add name="DbRoleProvider" type="BlogEngine.Core.Providers.DbRoleProvider, BlogEngine.Core" connectionStringName="BlogEngine" xdt:Transform="Insert" />
      </providers>
    </roleManager>
  </system.web>
</configuration>
