<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RehostSiteContentRoot>../BlogEngine/BlogEngine.NET/</RehostSiteContentRoot>
    <OutDir>rehost_root/bin/</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.Web.AspNetCore" Version="$(RehostVersion)" />
    <ProjectReference Include="../BlogEngine.App/BlogEngine.App.csproj" />
  </ItemGroup>

  <Target Name="BlogEngineSeedDatabase" AfterTargets="Build">
    <Copy
      SourceFiles="$(RehostSiteContentRoot)setup/SQLite/BlogEngine.s3db"
      DestinationFolder="$(RehostStagedSiteRoot)App_Data"
      Condition="!Exists('$(RehostStagedSiteRoot)App_Data/BlogEngine.s3db')" />
  </Target>
</Project>
