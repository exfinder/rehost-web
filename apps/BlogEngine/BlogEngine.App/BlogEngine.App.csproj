<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BlogEngine.NET</AssemblyName>
    <RootNamespace>BlogEngine.NET</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RehostAppContentRoot>../BlogEngine/BlogEngine.NET/</RehostAppContentRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RehostAppContentRoot)**/*.cs" />
    <Compile Remove="$(RehostAppContentRoot)bin/**" />
    <Compile Remove="$(RehostAppContentRoot)obj/**" />
    <Compile Remove="$(RehostAppContentRoot)packages/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.Web" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.Web.Optimization" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.WebApi.WebHost" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.WebPages" Version="$(RehostVersion)" />
    <PackageReference Include="Antlr" Version="3.5.0.2" NoWarn="NU1701" />
    <PackageReference Include="WebGrease" Version="1.6.0" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Razor" Version="3.3.0" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.3.0" NoWarn="NU1701" />
    <PackageReference Include="SimpleInjector.Integration.WebApi" Version="4.10.2" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BlogEngine.Core/BlogEngine.Core.csproj" />
  </ItemGroup>
</Project>
