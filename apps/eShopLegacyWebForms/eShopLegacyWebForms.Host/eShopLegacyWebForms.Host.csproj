<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RehostSiteContentRoot>../eShopLegacyWebForms/</RehostSiteContentRoot>
    <OutDir>rehost_root/bin/</OutDir>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.WebForms" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Rehost.WebForms.Hosting" Version="$(RehostWebFormsVersion)" />
    <ProjectReference Include="../eShopLegacyWebForms.App/eShopLegacyWebForms.App.csproj" />
  </ItemGroup>
</Project>
