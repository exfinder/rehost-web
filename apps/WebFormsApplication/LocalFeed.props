<Project>
  <!-- Single source for this app's local-feed location, shared by the project-level
       and solution-level restore hooks. -->
  <PropertyGroup>
    <RehostWebFormsVersion>1.0.0-local</RehostWebFormsVersion>
    <RehostLocalPackageRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'webforms-application'))</RehostLocalPackageRoot>
    <RestoreAdditionalProjectSources>$(RehostLocalPackageRoot)feed</RestoreAdditionalProjectSources>
    <RestorePackagesPath>$(RehostLocalPackageRoot)packages</RestorePackagesPath>
    <RestoreNoCache>true</RestoreNoCache>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
