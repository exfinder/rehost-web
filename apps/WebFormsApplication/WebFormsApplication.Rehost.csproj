<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WebFormsApplication</AssemblyName>
    <RootNamespace>WebFormsApplication</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../../artifacts/webforms-application/feed</RestoreAdditionalProjectSources>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)../../artifacts/webforms-application/packages</RestorePackagesPath>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="WebFormsApplication/**/*.cs"
      Exclude="WebFormsApplication/**/bin/**;WebFormsApplication/**/obj/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.WebForms.Runtime" Version="[1.0.0-local]" />
    <PackageReference Include="Rehost.WebForms.FriendlyUrls" Version="[1.0.0-local]" />
    <PackageReference Include="Rehost.WebForms.Extensions" Version="[1.0.0-local]" />
    <PackageReference Include="Rehost.WebForms.Optimization" Version="[1.0.0-local]" />
    <PackageReference Include="Rehost.WebForms.Optimization.WebForms" Version="[1.0.0-local]" />
    <PackageReference Include="Rehost.WebForms.ScriptManager.Bundles" Version="[1.0.0-local]" />
  </ItemGroup>
</Project>
