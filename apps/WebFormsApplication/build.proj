<Project DefaultTargets="Build">
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
    <LocalPackageVersion>1.0.0-local</LocalPackageVersion>
    <LocalPackageRoot>$(RepoRoot)artifacts/webforms-application/</LocalPackageRoot>
    <LocalPackageFeed>$(LocalPackageRoot)feed/</LocalPackageFeed>
    <LocalPackageCache>$(LocalPackageRoot)packages/</LocalPackageCache>
    <LocalPackageStamp>$(LocalPackageRoot)local-packages.stamp</LocalPackageStamp>
    <SidecarProject>$(MSBuildThisFileDirectory)WebFormsApplication.Rehost.csproj</SidecarProject>
    <HostProject>$(MSBuildThisFileDirectory)WebFormsApplication.Host.csproj</HostProject>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <LocalBuildSupportProject Include="$(RepoRoot)eng/Rehost.WebForms.GeneratedInputs/Rehost.WebForms.GeneratedInputs.csproj" />
    <LocalPackageProject Include="$(RepoRoot)src/Rehost.WebForms.ApplicationServices/Rehost.WebForms.ApplicationServices.csproj" />
    <LocalPackageProject Include="$(RepoRoot)src/Rehost.WebForms.Extensions/Rehost.WebForms.Extensions.csproj" />
    <LocalPackageProject Include="$(RepoRoot)src/Rehost.WebForms.FriendlyUrls/Rehost.WebForms.FriendlyUrls.csproj" />
    <LocalPackageProject Include="$(RepoRoot)src/Rehost.WebForms.Hosting/Rehost.WebForms.Hosting.csproj" />
    <LocalPackageProject Include="$(RepoRoot)src/Rehost.WebForms.Optimization/Rehost.WebForms.Optimization.csproj" />
    <LocalPackageProject Include="$(RepoRoot)src/Rehost.WebForms.Optimization.WebForms/Rehost.WebForms.Optimization.WebForms.csproj" />
    <LocalPackageProject Include="$(RepoRoot)src/Rehost.WebForms.WebServices/Rehost.WebForms.WebServices.csproj" />
    <LocalPackageProject Include="$(RepoRoot)src/Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
    <LocalPackageProject Include="$(RepoRoot)src/Rehost.WebForms.ScriptManager.Bundles/Rehost.WebForms.ScriptManager.Bundles.csproj" />

    <LocalPackageInput Include="$(MSBuildThisFileFullPath);$(RepoRoot)Directory.Packages.props;$(RepoRoot)global.json" />
    <LocalPackageInput
      Include="$(RepoRoot)src/Rehost.WebForms.ApplicationServices/**/*.cs;$(RepoRoot)src/Rehost.WebForms.ApplicationServices/**/*.csproj;$(RepoRoot)src/Rehost.WebForms.ApplicationServices/**/*.resx"
      Exclude="$(RepoRoot)src/Rehost.WebForms.ApplicationServices/**/bin/**;$(RepoRoot)src/Rehost.WebForms.ApplicationServices/**/obj/**" />
    <LocalPackageInput
      Include="$(RepoRoot)src/Rehost.WebForms.Extensions/**/*.cs;$(RepoRoot)src/Rehost.WebForms.Extensions/**/*.csproj"
      Exclude="$(RepoRoot)src/Rehost.WebForms.Extensions/**/bin/**;$(RepoRoot)src/Rehost.WebForms.Extensions/**/obj/**" />
    <LocalPackageInput
      Include="$(RepoRoot)src/Rehost.WebForms.FriendlyUrls/**/*.cs;$(RepoRoot)src/Rehost.WebForms.FriendlyUrls/**/*.csproj"
      Exclude="$(RepoRoot)src/Rehost.WebForms.FriendlyUrls/**/bin/**;$(RepoRoot)src/Rehost.WebForms.FriendlyUrls/**/obj/**" />
    <LocalPackageInput
      Include="$(RepoRoot)src/Rehost.WebForms.Hosting/**/*.cs;$(RepoRoot)src/Rehost.WebForms.Hosting/**/*.csproj"
      Exclude="$(RepoRoot)src/Rehost.WebForms.Hosting/**/bin/**;$(RepoRoot)src/Rehost.WebForms.Hosting/**/obj/**" />
    <LocalPackageInput
      Include="$(RepoRoot)src/Rehost.WebForms.Optimization/**/*.cs;$(RepoRoot)src/Rehost.WebForms.Optimization/**/*.csproj"
      Exclude="$(RepoRoot)src/Rehost.WebForms.Optimization/**/bin/**;$(RepoRoot)src/Rehost.WebForms.Optimization/**/obj/**" />
    <LocalPackageInput
      Include="$(RepoRoot)src/Rehost.WebForms.Optimization.WebForms/**/*.cs;$(RepoRoot)src/Rehost.WebForms.Optimization.WebForms/**/*.csproj"
      Exclude="$(RepoRoot)src/Rehost.WebForms.Optimization.WebForms/**/bin/**;$(RepoRoot)src/Rehost.WebForms.Optimization.WebForms/**/obj/**" />
    <LocalPackageInput
      Include="$(RepoRoot)src/Rehost.WebForms.WebServices/**/*.cs;$(RepoRoot)src/Rehost.WebForms.WebServices/**/*.csproj"
      Exclude="$(RepoRoot)src/Rehost.WebForms.WebServices/**/bin/**;$(RepoRoot)src/Rehost.WebForms.WebServices/**/obj/**" />
    <LocalPackageInput
      Include="$(RepoRoot)src/Rehost.WebForms.Runtime/**/*.cs;$(RepoRoot)src/Rehost.WebForms.Runtime/**/*.csproj;$(RepoRoot)src/Rehost.WebForms.Runtime/**/*.config;$(RepoRoot)src/Rehost.WebForms.Runtime/**/*.targets"
      Exclude="$(RepoRoot)src/Rehost.WebForms.Runtime/**/bin/**;$(RepoRoot)src/Rehost.WebForms.Runtime/**/obj/**" />
    <LocalPackageInput
      Include="$(RepoRoot)src/Rehost.WebForms.ScriptManager.Bundles/**/*.cs;$(RepoRoot)src/Rehost.WebForms.ScriptManager.Bundles/**/*.csproj"
      Exclude="$(RepoRoot)src/Rehost.WebForms.ScriptManager.Bundles/**/bin/**;$(RepoRoot)src/Rehost.WebForms.ScriptManager.Bundles/**/obj/**" />
    <LocalPackageInput Include="$(RepoRoot)src/System.Web.ApplicationServices.ReferenceSource/**/*.cs;$(RepoRoot)src/System.Web.ApplicationServices.ReferenceSource/**/*.resx" />
    <LocalPackageInput Include="$(RepoRoot)src/System.Web.Extensions.ReferenceSource/**/*.cs;$(RepoRoot)src/System.Web.Extensions.ReferenceSource/**/*.resx" />
    <LocalPackageInput Include="$(RepoRoot)src/System.Web.Optimization.ReferenceSource/**/*.cs;$(RepoRoot)src/System.Web.Optimization.ReferenceSource/**/*.resx;$(RepoRoot)src/System.Web.Optimization.ReferenceSource/**/*.xsd" />
    <LocalPackageInput Include="$(RepoRoot)src/Microsoft.AspNet.Web.Optimization.WebForms.ReferenceSource/**/*.cs" />
    <LocalPackageInput Include="$(RepoRoot)src/System.Web.Services.ReferenceSource/**/*.cs" />
    <LocalPackageInput Include="$(RepoRoot)src/System.Web.ReferenceSource/**/*.cs;$(RepoRoot)src/System.Web.ReferenceSource/**/*.cspp;$(RepoRoot)src/System.Web.ReferenceSource/**/*.txt;$(RepoRoot)src/System.Web.ReferenceSource/**/*.js;$(RepoRoot)src/System.Web.ReferenceSource/**/*.htm" />
    <LocalPackageInput
      Include="$(RepoRoot)eng/Rehost.WebForms.GeneratedInputs/**/*.cs;$(RepoRoot)eng/Rehost.WebForms.GeneratedInputs/**/*.csproj;$(RepoRoot)eng/Rehost.WebForms.GeneratedInputs/**/*.json;$(RepoRoot)eng/Rehost.WebForms.GeneratedInputs/**/*.targets"
      Exclude="$(RepoRoot)eng/Rehost.WebForms.GeneratedInputs/**/bin/**;$(RepoRoot)eng/Rehost.WebForms.GeneratedInputs/**/obj/**" />
    <LocalPackageInput
      Include="$(RepoRoot)eng/Rehost.WebForms.ReferenceSource.BuildInputs/**/*.cs;$(RepoRoot)eng/Rehost.WebForms.ReferenceSource.BuildInputs/**/*.csproj"
      Exclude="$(RepoRoot)eng/Rehost.WebForms.ReferenceSource.BuildInputs/**/bin/**;$(RepoRoot)eng/Rehost.WebForms.ReferenceSource.BuildInputs/**/obj/**" />
    <LocalPackageInput Include="$(RepoRoot)eng/RoslynReadyToRun.targets" />

    <LocalPackageOutput Include="$(LocalPackageFeed)Rehost.WebForms.ApplicationServices.$(LocalPackageVersion).nupkg" />
    <LocalPackageOutput Include="$(LocalPackageFeed)Rehost.WebForms.Extensions.$(LocalPackageVersion).nupkg" />
    <LocalPackageOutput Include="$(LocalPackageFeed)Rehost.WebForms.FriendlyUrls.$(LocalPackageVersion).nupkg" />
    <LocalPackageOutput Include="$(LocalPackageFeed)Rehost.WebForms.Hosting.$(LocalPackageVersion).nupkg" />
    <LocalPackageOutput Include="$(LocalPackageFeed)Rehost.WebForms.Optimization.$(LocalPackageVersion).nupkg" />
    <LocalPackageOutput Include="$(LocalPackageFeed)Rehost.WebForms.Optimization.WebForms.$(LocalPackageVersion).nupkg" />
    <LocalPackageOutput Include="$(LocalPackageFeed)Rehost.WebForms.WebServices.$(LocalPackageVersion).nupkg" />
    <LocalPackageOutput Include="$(LocalPackageFeed)Rehost.WebForms.Runtime.$(LocalPackageVersion).nupkg" />
    <LocalPackageOutput Include="$(LocalPackageFeed)Rehost.WebForms.ScriptManager.Bundles.$(LocalPackageVersion).nupkg" />

    <LocalPackageCacheEntry Include="$(LocalPackageCache)rehost.webforms.applicationservices/$(LocalPackageVersion)" />
    <LocalPackageCacheEntry Include="$(LocalPackageCache)rehost.webforms.extensions/$(LocalPackageVersion)" />
    <LocalPackageCacheEntry Include="$(LocalPackageCache)rehost.webforms.friendlyurls/$(LocalPackageVersion)" />
    <LocalPackageCacheEntry Include="$(LocalPackageCache)rehost.webforms.hosting/$(LocalPackageVersion)" />
    <LocalPackageCacheEntry Include="$(LocalPackageCache)rehost.webforms.optimization/$(LocalPackageVersion)" />
    <LocalPackageCacheEntry Include="$(LocalPackageCache)rehost.webforms.optimization.webforms/$(LocalPackageVersion)" />
    <LocalPackageCacheEntry Include="$(LocalPackageCache)rehost.webforms.webservices/$(LocalPackageVersion)" />
    <LocalPackageCacheEntry Include="$(LocalPackageCache)rehost.webforms.runtime/$(LocalPackageVersion)" />
    <LocalPackageCacheEntry Include="$(LocalPackageCache)rehost.webforms.scriptmanager.bundles/$(LocalPackageVersion)" />

    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Rehost/project.assets.json" />
    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Rehost/project.nuget.cache" />
    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Rehost/WebFormsApplication.Rehost.csproj.nuget.dgspec.json" />
    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Rehost/WebFormsApplication.Rehost.csproj.nuget.g.props" />
    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Rehost/WebFormsApplication.Rehost.csproj.nuget.g.targets" />
    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Host/project.assets.json" />
    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Host/project.nuget.cache" />
    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Host/WebFormsApplication.Host.csproj.nuget.dgspec.json" />
    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Host/WebFormsApplication.Host.csproj.nuget.g.props" />
    <SidecarRestoreState Include="$(MSBuildThisFileDirectory)obj/Host/WebFormsApplication.Host.csproj.nuget.g.targets" />
  </ItemGroup>

  <Target
    Name="PackLocalPackages"
    Inputs="@(LocalPackageInput)"
    Outputs="$(LocalPackageStamp)">
    <MakeDir Directories="$(LocalPackageFeed);$(LocalPackageCache)" />
    <RemoveDir Directories="@(LocalPackageCacheEntry)" />
    <Delete Files="@(SidecarRestoreState)" />
    <MSBuild
      Projects="@(LocalBuildSupportProject)"
      Targets="Restore"
      BuildInParallel="false"
      Properties="Configuration=Release" />
    <MSBuild
      Projects="@(LocalPackageProject)"
      Targets="Restore"
      BuildInParallel="false"
      Properties="Configuration=Release;PackageOutputPath=$(LocalPackageFeed);PackageVersion=$(LocalPackageVersion)" />
    <MSBuild
      Projects="@(LocalPackageProject)"
      Targets="Pack"
      BuildInParallel="false"
      Properties="Configuration=Release;PackageOutputPath=$(LocalPackageFeed);PackageVersion=$(LocalPackageVersion);RehostWebFormsRestoreCompleted=true" />
    <RemoveDir Directories="@(LocalPackageCacheEntry)" />
    <Delete Files="@(SidecarRestoreState)" />
    <Touch Files="$(LocalPackageStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="Build" DependsOnTargets="PackLocalPackages">
    <MSBuild
      Projects="$(HostProject)"
      Targets="Restore"
      Properties="Configuration=$(Configuration);RestoreAdditionalProjectSources=$(LocalPackageFeed);RestorePackagesPath=$(LocalPackageCache);RestoreNoCache=true" />
    <MSBuild
      Projects="$(HostProject)"
      Targets="Build"
      Properties="Configuration=$(Configuration);RehostWebFormsRestoreCompleted=true;RestoreAdditionalProjectSources=$(LocalPackageFeed);RestorePackagesPath=$(LocalPackageCache)" />
  </Target>
</Project>
