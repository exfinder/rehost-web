<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RehostSiteContentRoot>../WebFormsApplication/</RehostSiteContentRoot>
    <OutDir>rehost_root/bin/</OutDir>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.Web.AspNetCore" Version="$(RehostVersion)" />
    <ProjectReference Include="../WebFormsApplication.App/WebFormsApplication.App.csproj" />
  </ItemGroup>
</Project>
