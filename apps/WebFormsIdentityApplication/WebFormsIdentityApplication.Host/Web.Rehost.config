<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the package default wholesale: its rules, plus the connection
     string, since LocalDb is a Windows-only engine. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <runtime xdt:Transform="RemoveAll" />
  <system.codedom xdt:Transform="RemoveAll" />
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Data Source=|DataDirectory|Identity.db;Foreign Keys=True"
         providerName="System.Data.SQLite.EF6"
         xdt:Locator="Match(name)"
         xdt:Transform="SetAttributes(connectionString,providerName)" />
  </connectionStrings>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SQLite.EF6"
                type="System.Data.SQLite.EF6.SQLiteProviderServices, System.Data.SQLite.EF6"
                xdt:Transform="Insert" />
    </providers>
    <contexts xdt:Transform="Insert">
      <context type="WebFormsIdentityApplication.Models.ApplicationDbContext, WebFormsIdentityApplication"
               disableDatabaseInitialization="true" />
    </contexts>
  </entityFramework>
  <system.data xdt:Transform="Insert">
    <DbProviderFactories>
      <add name="SQLite Data Provider (Entity Framework 6)"
           invariant="System.Data.SQLite.EF6"
           description=".NET Framework Data Provider for SQLite (Entity Framework 6)"
           type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite" />
    </DbProviderFactories>
  </system.data>
</configuration>
