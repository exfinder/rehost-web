<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the package default wholesale: its three rules, plus the connection
     string, since LocalDb is a Windows-only engine. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <runtime xdt:Transform="RemoveAll" />
  <system.codedom xdt:Transform="RemoveAll" />
  <system.web>
    <pages>
      <controls>
        <add xdt:Locator="Condition(@assembly='Microsoft.AspNet.Web.Optimization.WebForms')"
             xdt:Transform="SetAttributes(assembly)"
             assembly="Rehost.WebForms.Optimization.WebForms" />
      </controls>
    </pages>
  </system.web>
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Server=127.0.0.1,14333;Database=WebFormsIdentityApplication;User Id=sa;Password=Rehost!Dev2026;TrustServerCertificate=True"
         providerName="System.Data.SqlClient"
         xdt:Locator="Match(name)"
         xdt:Transform="SetAttributes(connectionString)" />
  </connectionStrings>
</configuration>
