<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RehostSiteContentRoot>../WebFormsIdentityApplication/</RehostSiteContentRoot>
    <OutDir>rehost_root/bin/</OutDir>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.WebForms.Hosting" Version="$(RehostWebFormsVersion)" />
    <ProjectReference Include="../WebFormsIdentityApplication.App/WebFormsIdentityApplication.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Identity.schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite" Version="2.0.4" />
    <PackageReference Include="System.Data.SQLite.EF6" Version="2.0.3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
</Project>
