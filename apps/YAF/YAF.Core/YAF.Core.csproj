<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Sidecar.props" />
  <PropertyGroup>
    <AssemblyName>YAF.Core</AssemblyName>
    <RootNamespace>YAF.Core</RootNamespace>
    <Source>$(YafSrc)YAF.Core/</Source>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Source)**/*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(YafSrc)GlobalAssemblyInfo.cs" Link="Properties/GlobalAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Rehost.Web" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.Owin.Host.SystemWeb" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.WebApi.WebHost" Version="$(RehostVersion)" />
    <PackageReference Include="Autofac" Version="9.3.2" />
    <PackageReference Include="Farsi.Library" Version="2.7.0" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.AspNet.Identity.Core" Version="2.2.4" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.AspNet.Identity.Owin" Version="2.2.4" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.3.0" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
    <PackageReference Include="Microsoft.Owin" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.Cookies" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.OAuth" Version="4.2.3" NoWarn="NU1701" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Owin" Version="1.0.0" NoWarn="NU1701" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.11" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.11" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00018" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00018" />
    <PackageReference Include="Lucene.Net.Highlighter" Version="4.8.0-beta00018" />
    <PackageReference Include="Lucene.Net.Queries" Version="4.8.0-beta00018" />
    <PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00018" />
    <PackageReference Include="OEmbed.Core" Version="2.0.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../YAF.Configuration/YAF.Configuration.csproj" />
    <ProjectReference Include="../ServiceStack.OrmLite/ServiceStack.OrmLite.csproj" />
    <ProjectReference Include="../YAF.Types/YAF.Types.csproj" />
  </ItemGroup>
</Project>
