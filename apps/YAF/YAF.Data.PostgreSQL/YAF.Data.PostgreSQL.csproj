<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Sidecar.props" />
  <PropertyGroup>
    <AssemblyName>YAF.Data.PostgreSQL</AssemblyName>
    <RootNamespace>YAF.Data.PostgreSQL</RootNamespace>
    <Source>$(YafSrc)YAF.Data/YAF.Data.PostgreSQL/</Source>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Source)**/*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
