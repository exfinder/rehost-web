<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the package default wholesale, so it repeats the default
     adjustments before the app-specific ones. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <runtime xdt:Transform="RemoveAll" />
  <!-- The runtime's machine.config declares no system.net group, so the section
       fails activation outright. Modern SmtpClient reads no mailSettings either,
       and mail is outside the journey this application proves. -->
  <system.net xdt:Transform="RemoveAll" />
  <!-- The shipped file names URLRewriter.config; the file is UrlRewriter.config.
       Only a case-sensitive filesystem tells them apart, so the section fails to
       load on Linux and the rewrite module dies in its static constructor. -->
  <rewriter xdt:Transform="SetAttributes(configSource)" configSource="UrlRewriter.config" />
  <connectionStrings>
    <!-- Both data assemblies register DbProviderFactory unnamed, so only one may
         be loaded; upstream ships a separate website project per database for the
         same reason. YAF.App references the PostgreSQL one, and providerName is
         what selects it. -->
    <add name="yafnet"
         connectionString="Server=127.0.0.1;Port=15432;Database=yafnet;User Id=yaf;Password=Rehost!Dev2026;"
         providerName="Npgsql Data Provider"
         xdt:Locator="Match(name)"
         xdt:Transform="SetAttributes(connectionString,providerName)" />
  </connectionStrings>
  <system.web>
    <!-- The shipped file leaves the key commented and tells operators to generate
         one. A fixed test key is what makes an auth cookie survive the process
         replacement that stands in for a restart. -->
    <machineKey
        xdt:Transform="Insert"
        validationKey="5AD1A3AAABAEE3C5B82958A6609B0BD1E9576ED1390B716BE9863173CFDF69590A9CCC5E041D26AEA5B685312AB856422B551CF1B71B2964C7954E5BEC8C57D0"
        decryptionKey="3B96B93469289D698453C30C4827E08D0AF52D731E001F5FD5D8800FECE00674"
        validation="HMACSHA256"
        decryption="AES" />
  </system.web>
</configuration>
