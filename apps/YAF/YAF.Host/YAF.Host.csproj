<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RehostSiteContentRoot>../yafsrc/YetAnotherForum.NET/</RehostSiteContentRoot>
    <OutDir>rehost_root/bin/</OutDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rehost.Web.AspNetCore" Version="$(RehostVersion)" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <ProjectReference Include="../YAF.App/YAF.App.csproj" />
  </ItemGroup>
</Project>
