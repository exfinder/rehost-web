<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RehostSiteContentRoot>../yafsrc/YetAnotherForum.NET/</RehostSiteContentRoot>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Application browser compilation is Unsupported and fails activation. The
         runtime already carries Framework 4.5's definitions, which is the version
         these patch files exist to backport onto 4.0. -->
    <RehostSiteContentExcludes>../yafsrc/YetAnotherForum.NET/App_Browsers/**</RehostSiteContentExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rehost.WebForms" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Rehost.WebForms.Hosting" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <ProjectReference Include="../YAF.App/YAF.App.csproj" />
  </ItemGroup>
</Project>
