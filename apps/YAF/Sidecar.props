<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- C# 14's first-class span conversions join overload resolution, so
         `array.Contains(x)` binds to MemoryExtensions instead of Enumerable and
         yields a ReadOnlySpan the frozen sources' expression trees cannot box.
         net481 had no such overload; 13 is the last version that agrees with it. -->
    <LangVersion>13</LangVersion>
    <SignAssembly>false</SignAssembly>
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1510;CS1591;CS1573</NoWarn>
    <NoWarn>$(NoWarn);CS0618;SYSLIB0003;SYSLIB0012;SYSLIB0014;SYSLIB0023;SYSLIB0050;SYSLIB0051;SYSLIB0057;CA2022;CA2265</NoWarn>
    <NoWarn>$(NoWarn);CS3001;CS3002;CS3003;CS3009</NoWarn>
    <NoWarn>$(NoWarn);CS8603;CS8618;CS8625;CS8764;CS8765;CS8766;CS8767;CS8981;CS0649</NoWarn>
    <YafSrc>$(MSBuildThisFileDirectory)yafsrc/</YafSrc>
  </PropertyGroup>
</Project>
