<Project>
  <!-- Single source for the apps' shared local-feed location, used by the project-level
       and solution-level restore hooks. -->
  <PropertyGroup>
    <RehostWebFormsVersion>1.0.0-local</RehostWebFormsVersion>
    <RehostLocalPackageRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'artifacts', 'apps'))</RehostLocalPackageRoot>
    <RestoreAdditionalProjectSources>$(RehostLocalPackageRoot)feed</RestoreAdditionalProjectSources>
    <RestorePackagesPath>$(RehostLocalPackageRoot)packages</RestorePackagesPath>
    <RestoreNoCache>true</RestoreNoCache>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
