<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the package default wholesale, so it repeats the default
     adjustments before the app-specific ones. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <runtime xdt:Transform="RemoveAll" />
  <system.codedom xdt:Transform="RemoveAll" />
  <appSettings>
    <!-- The shipped LocalDB connection is Windows-only. -->
    <add key="UseMockData" value="true" xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
  </appSettings>
  <system.webServer>
    <modules>
      <!-- Microsoft.AspNet.SessionState.SessionStateModule binds Framework's
           strong-named System.Web; dropping the swap falls back to the
           built-in module, identical for mode="InProc". -->
      <remove name="Session" xdt:Transform="Remove" xdt:Locator="Match(name)" />
      <add name="Session" xdt:Transform="Remove" xdt:Locator="Match(name)" />
      <!-- Application Insights binds Framework's strong-named System.Web and
           its collectors are Windows-only; telemetry is dropped, not ported. -->
      <remove name="TelemetryCorrelationHttpModule" xdt:Transform="Remove" xdt:Locator="Match(name)" />
      <add name="TelemetryCorrelationHttpModule" xdt:Transform="Remove" xdt:Locator="Match(name)" />
      <remove name="ApplicationInsightsWebTracking" xdt:Transform="Remove" xdt:Locator="Match(name)" />
      <add name="ApplicationInsightsWebTracking" xdt:Transform="Remove" xdt:Locator="Match(name)" />
    </modules>
  </system.webServer>
</configuration>
