<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>eShopLegacyMVC</AssemblyName>
    <RootNamespace>eShopLegacyMVC</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RehostAppContentRoot>../eShopLegacyMVC/</RehostAppContentRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RehostAppContentRoot)**/*.cs" />
    <Compile Remove="$(RehostAppContentRoot)bin/**" />
    <Compile Remove="$(RehostAppContentRoot)obj/**" />
    <Compile Remove="$(RehostAppContentRoot)packages/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.Web" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.Mvc" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.WebPages" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.WebApi.WebHost" Version="$(RehostVersion)" />
    <PackageReference Include="Rehost.AspNet.Web.Optimization" Version="$(RehostVersion)" />
    <PackageReference Include="Antlr" Version="3.5.0.2" NoWarn="NU1701" />
    <PackageReference Include="WebGrease" Version="1.6.0" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="6.1.0" />
    <PackageReference Include="Autofac.WebApi2" Version="6.0.1" NoWarn="NU1701" />
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="log4net" Version="2.0.10" />
    <PackageReference Include="Microsoft.AspNet.Razor" Version="3.3.0" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.3.0" NoWarn="NU1701" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Autofac.Integration.Mvc/Autofac.Integration.Mvc.csproj" />
    <ProjectReference Include="../eShopLegacy.Utilities/eShopLegacy.Utilities.csproj" />
  </ItemGroup>
</Project>
