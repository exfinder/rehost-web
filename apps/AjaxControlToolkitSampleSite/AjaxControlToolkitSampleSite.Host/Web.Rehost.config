<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the package default wholesale, so it repeats the default
     adjustments before the app-specific ones. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <runtime xdt:Transform="RemoveAll" />
  <system.codedom xdt:Transform="RemoveAll" />
  <!-- useStaticResources="true" points every toolkit script, style and image at
       ~/Scripts/AjaxControlToolkit and ~/Content/AjaxControlToolkit, which are
       build output of the Windows-only LinkStaticResources hard-link tool and do
       not exist in the frozen tree. false is the toolkit's own default and
       serves the same assets embedded. -->
  <!-- renderStyleLinks="false" leaves the ~/Content/AjaxControlToolkit/Styles/Bundle
       that Layout.master renders as the only carrier of toolkit CSS, and that
       bundle is registered by AjaxControlToolkit.StaticResources over the same
       missing build output; it 404s. true makes each control emit its own
       WebResource.axd stylesheet link instead. -->
  <ajaxControlToolkit
    xdt:Transform="SetAttributes(useStaticResources,renderStyleLinks)"
    useStaticResources="false"
    renderStyleLinks="true" />
  <!-- targetFramework 4.5 also defaults UnobtrusiveValidationMode to WebForms,
       which demands a 'jquery' ScriptResourceMapping the site never registers;
       MaskedEdit and ValidatorCallout throw in BaseValidator.OnPreRender. None
       is the 4.0 default the site was authored against. -->
  <!-- The block clears handlers and modules for a folder the frozen tree does not serve. -->
  <location path="Temp" xdt:Transform="Remove" xdt:Locator="Match(path)" />
  <appSettings xdt:Transform="Insert">
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <!-- ApplicationConfigurationPreflight refuses any level but Full. -->
    <trust xdt:Transform="Remove" />
    <!-- Absent upstream; without it every request renders a 500 naming the
         setting (ledger P40). 4.5 and not 4.8.1: at 4.7.2 and above
         ParseRecorder installs WebObjectActivatorParseRecorder, whose cast and
         typeof lack global::, so App_Code's `namespace InfoBlock { class
         InfoBlock }` fails codegen on every demo page. -->
    <httpRuntime targetFramework="4.5" xdt:Transform="Insert" />
  </system.web>
</configuration>
