<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RehostSiteContentRoot>../AjaxControlToolkitSampleSite/</RehostSiteContentRoot>
    <OutDir>rehost_root/bin/</OutDir>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rehost.WebForms" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Rehost.WebForms.Hosting" Version="$(RehostWebFormsVersion)" />
    <PackageReference Include="Rehost.WebForms.Optimization" Version="$(RehostWebFormsVersion)" />
    <ProjectReference Include="../AjaxControlToolkit/AjaxControlToolkit.csproj" />
    <ProjectReference Include="../AjaxControlToolkit.HtmlEditor.Sanitizer/AjaxControlToolkit.HtmlEditor.Sanitizer.csproj" />
  </ItemGroup>

  <!-- The hosting package stages a WAP, so it excludes **/*.cs. A Web Site project
       ships its App_Code and CodeFile sources as site content; without them the
       staged site has no code behind any page. -->
  <Target Name="StageWebSiteSources" AfterTargets="RehostStageSite">
    <ItemGroup>
      <_WebSiteSource
        Include="$(RehostSiteContentRoot)**/*.cs"
        Exclude="$(RehostSiteContentRoot)bin/**;$(RehostSiteContentRoot)obj/**" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WebSiteSource)"
      DestinationFiles="@(_WebSiteSource->'$(RehostStagedSiteRoot)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
