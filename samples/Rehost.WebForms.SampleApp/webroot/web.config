<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />

    <!--
      The shipped root configuration maps no content extension: Framework left static files
      to IIS, so an application opts each one in (ledger P54).
    -->
    <httpHandlers>
      <add path="*.css" verb="GET,HEAD" type="System.Web.StaticFileHandler, Rehost.WebForms.Runtime" validate="true" />
      <add path="*.png" verb="GET,HEAD" type="System.Web.StaticFileHandler, Rehost.WebForms.Runtime" validate="true" />
    </httpHandlers>
  </system.web>
</configuration>
