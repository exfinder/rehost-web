<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Repo.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Rehost.WebForms.SampleApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Classic Web Site shape: assemblies directly in the site's bin/, no configuration/tfm segments. -->
    <OutputPath>rehost_root/bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The Web Site payload, published one level above the binaries: the publish folder is
       the site root and PublishIntoSiteBin sends the binaries to its bin/, the shape the
       project has in place. App_Code and App_GlobalResources need Include, not
       Update: the runtime targets removed them from Compile/EmbeddedResource, which leaves
       them in no item group. -->
  <ItemGroup>
    <None
      Update="rehost_root/**/*.aspx;rehost_root/**/*.ascx;rehost_root/**/*.master;rehost_root/Global.asax;rehost_root/web.config;rehost_root/**/*.css;rehost_root/**/*.png"
      CopyToPublishDirectory="PreserveNewest"
      TargetPath="$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/rehost_root/bin/', '%(FullPath)'))" />
    <None
      Include="rehost_root/App_Code/**;rehost_root/App_GlobalResources/**"
      CopyToPublishDirectory="PreserveNewest"
      TargetPath="$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/rehost_root/bin/', '%(FullPath)'))" />
  </ItemGroup>

  <!-- A target may reassign PublishDir even when it came from the command line (-o). -->
  <Target Name="PublishIntoSiteBin" BeforeTargets="PrepareForPublish">
    <PropertyGroup>
      <PublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)', 'bin'))</PublishDir>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="../../src/Rehost.WebForms.Hosting/Rehost.WebForms.Hosting.csproj" />
  </ItemGroup>
  <Import Project="../../tests/BaselineNamedAssemblies.props" />

  <Import Project="$(RehostRepoRoot)src/Rehost.WebForms/build/Rehost.WebForms.targets" />
  <Import Project="$(RehostRepoRoot)eng/RoslynReadyToRun.targets" />
</Project>
