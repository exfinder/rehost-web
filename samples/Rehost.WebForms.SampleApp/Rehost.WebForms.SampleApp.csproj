<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Repo.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Rehost.WebForms.SampleApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Classic Web Site shape: assemblies directly in bin/, no configuration/tfm segments. -->
    <OutputPath>bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The Web Site payload, published beside the binaries so FindApplicationRoot resolves
       the publish directory itself. App_Code and App_GlobalResources need Include, not
       Update: the runtime targets removed them from Compile/EmbeddedResource, which leaves
       them in no item group. -->
  <ItemGroup>
    <None
      Update="**/*.aspx;**/*.master;Global.asax;web.config;**/*.css;**/*.png"
      CopyToPublishDirectory="PreserveNewest" />
    <None
      Include="App_Code/**;App_GlobalResources/**"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
    <ProjectReference Include="../../src/Rehost.WebForms.Hosting/Rehost.WebForms.Hosting.csproj" />
  </ItemGroup>
  <Import Project="../../tests/BaselineNamedAssemblies.props" />

  <Import Project="$(RehostRepoRoot)src/Rehost.WebForms.Runtime/build/Rehost.WebForms.Runtime.targets" />
  <Import Project="$(RehostRepoRoot)eng/RoslynReadyToRun.targets" />
</Project>
