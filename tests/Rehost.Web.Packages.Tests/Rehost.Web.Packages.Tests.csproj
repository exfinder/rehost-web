<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Repo.props" />
  <Import Project="../../eng/PackageProjects.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RehostTestPackageFeed>$(MSBuildProjectDirectory)/bin/$(Configuration)/packages/</RehostTestPackageFeed>
    <RehostTestPackageStamp>$(MSBuildProjectDirectory)/bin/$(Configuration)/packages.stamp</RehostTestPackageStamp>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="@(RehostPackageProject)" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RehostPackageFeed" Value="$(RehostTestPackageFeed)" />
    <AssemblyMetadata Include="RehostPackagesProps" Value="$(RehostRepoRoot)Directory.Packages.props" />
    <AssemblyMetadata Include="RehostDependenciesProps" Value="$(RehostRepoRoot)src/Rehost.Web.Package/Rehost.Web.Dependencies.props" />
  </ItemGroup>

  <!-- The packages under test are real pack output of the current tree, never a feed
       another build left behind. Same inputs and stamp rule as the local feed: the stamp
       takes the time packing began, so a source edited during the pack still counts as
       newer. -->
  <Target
    Name="RehostPackForTests"
    AfterTargets="Build"
    Inputs="@(RehostPackageSource)"
    Outputs="$(RehostTestPackageStamp)">
    <PropertyGroup>
      <_RehostPackStarted>$([System.DateTime]::UtcNow.ToString('o'))</_RehostPackStarted>
    </PropertyGroup>
    <RemoveDir Directories="$(RehostTestPackageFeed)" />
    <MSBuild
      Projects="@(RehostPackageProject)"
      Targets="Pack"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);PackageOutputPath=$(RehostTestPackageFeed)" />
    <Touch Files="$(RehostTestPackageStamp)" AlwaysCreate="true" Time="$(_RehostPackStarted)" />
  </Target>
</Project>
