<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="aspnet:DisableFcnDaclRead" value="true" />
  </appSettings>

  <system.web>
    <compilation
      debug="false"
      targetFramework="4.8"
      tempDirectory="__FRAMEWORK_ORACLE_TEMP__" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />

    <httpModules>
      <clear />
      <!-- The module name is recorded in the golden trace; renaming it breaks verify. -->
      <add
        name="FrameworkOracleProbe"
        type="Rehost.WebForms.Parity.Probes.ProbeModule, Rehost.WebForms.Parity.Probes" />
    </httpModules>

    <!--
      HttpModulesSection.CreateModules still appends DefaultAuthenticationModule
      after this configured collection is cleared and rebuilt.
    -->
    <httpHandlers>
      <clear />
      <add
        path="oracle"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.SyncProbeHandler, Rehost.WebForms.Parity.Probes"
        validate="true" />
      <!--
        The module short-circuits this path, so reaching the handler at all is the failure
        signal for the CompleteRequest scenario.
      -->
      <add
        path="complete"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.SyncProbeHandler, Rehost.WebForms.Parity.Probes"
        validate="true" />
      <add
        path="async"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.AsyncProbeHandler, Rehost.WebForms.Parity.Probes"
        validate="true" />
      <add
        path="echo"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.EchoProbeHandler, Rehost.WebForms.Parity.Probes"
        validate="true" />
      <add
        path="body"
        verb="POST"
        type="Rehost.WebForms.Parity.Probes.BodyProbeHandler, Rehost.WebForms.Parity.Probes"
        validate="true" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <!--
      The oracle column is a classic Framework host, where the <httpModules> above is the module
      authority; the port reads this section instead. Both columns must present the same effective
      list, so the removes restore what the classic <clear/> takes away. DefaultAuthentication has
      no remove because HttpModulesSection appends it after the classic clear.
    -->
    <modules>
      <remove name="OutputCache" />
      <remove name="Session" />
      <remove name="WindowsAuthentication" />
      <remove name="FormsAuthentication" />
      <remove name="RoleManager" />
      <remove name="UrlAuthorization" />
      <remove name="FileAuthorization" />
      <remove name="AnonymousIdentification" />
      <remove name="Profile" />
      <remove name="UrlMappingsModule" />
      <remove name="UrlRoutingModule-4.0" />
      <remove name="ScriptModule-4.0" />
      <add
        name="FrameworkOracleProbe"
        type="Rehost.WebForms.Parity.Probes.ProbeModule, Rehost.WebForms.Parity.Probes" />
    </modules>
    <!-- The port's handler authority; the <httpHandlers> above is the oracle column's. -->
    <handlers>
      <clear />
      <add
        name="oracle"
        path="oracle"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.SyncProbeHandler, Rehost.WebForms.Parity.Probes" />
      <add
        name="complete"
        path="complete"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.SyncProbeHandler, Rehost.WebForms.Parity.Probes" />
      <add
        name="async"
        path="async"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.AsyncProbeHandler, Rehost.WebForms.Parity.Probes" />
      <add
        name="echo"
        path="echo"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.EchoProbeHandler, Rehost.WebForms.Parity.Probes" />
      <add
        name="body"
        path="body"
        verb="POST"
        type="Rehost.WebForms.Parity.Probes.BodyProbeHandler, Rehost.WebForms.Parity.Probes" />
    </handlers>
  </system.webServer>
</configuration>
