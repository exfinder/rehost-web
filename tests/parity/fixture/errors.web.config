<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="aspnet:DisableFcnDaclRead" value="true" />
  </appSettings>

  <system.web>
    <compilation
      debug="false"
      targetFramework="4.8"
      tempDirectory="__FRAMEWORK_ORACLE_TEMP__" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />

    <!--
      The detailed error page carries a stack trace and a CLR/ASP.NET build footer, neither of
      which can agree across runtimes. The generic page is fixed wording from the same imported
      resources, so error responses stay byte-comparable.
    -->
    <customErrors mode="On" />
    <authentication mode="None" />

    <httpModules>
      <clear />
      <!-- The module name is recorded in the golden trace; renaming it breaks verify. -->
      <add
        name="FrameworkOracleProbe"
        type="Rehost.WebForms.Parity.Probes.ProbeModule, Rehost.WebForms.Parity.Probes" />
    </httpModules>

    <httpHandlers>
      <clear />
      <add
        path="throw-module"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.SyncProbeHandler, Rehost.WebForms.Parity.Probes"
        validate="true" />
      <add
        path="throw-handler"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.ThrowProbeHandler, Rehost.WebForms.Parity.Probes"
        validate="true" />
      <!--
        validate="false" defers type resolution to the request, so the application still starts
        and only this path fails. Validating here would be a startup failure instead.
      -->
      <add
        path="missing"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.AbsentHandler, Rehost.WebForms.Parity.Probes"
        validate="false" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <!--
      The oracle column is a Framework host with no IIS, so the baseline's inherited
      X-Powered-By row has no counterpart in the golden; the port's adapter column removes it
      the way an application drops the header on IIS.
    -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <!-- Same effective module list as the classic <clear/> above gives the oracle column. -->
    <modules>
      <remove name="OutputCache" />
      <remove name="Session" />
      <remove name="WindowsAuthentication" />
      <remove name="FormsAuthentication" />
      <remove name="RoleManager" />
      <remove name="UrlAuthorization" />
      <remove name="FileAuthorization" />
      <remove name="AnonymousIdentification" />
      <remove name="Profile" />
      <remove name="UrlMappingsModule" />
      <remove name="UrlRoutingModule-4.0" />
      <remove name="ScriptModule-4.0" />
      <add
        name="FrameworkOracleProbe"
        type="Rehost.WebForms.Parity.Probes.ProbeModule, Rehost.WebForms.Parity.Probes" />
    </modules>
    <!--
      The port's handler authority; the <httpHandlers> above is the oracle column's. A
      system.webServer row resolves its type at first match either way, so "missing" needs no
      validate="false" counterpart here.
    -->
    <handlers>
      <clear />
      <add
        name="throw-module"
        path="throw-module"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.SyncProbeHandler, Rehost.WebForms.Parity.Probes" />
      <add
        name="throw-handler"
        path="throw-handler"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.ThrowProbeHandler, Rehost.WebForms.Parity.Probes" />
      <add
        name="missing"
        path="missing"
        verb="GET"
        type="Rehost.WebForms.Parity.Probes.AbsentHandler, Rehost.WebForms.Parity.Probes" />
    </handlers>
  </system.webServer>
</configuration>
