<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>FrameworkOracle.Host</AssemblyName>
    <RootNamespace>FrameworkOracle.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CoreParity.Contracts/CoreParity.Contracts.csproj" />
    <ProjectReference Include="../FrameworkOracle.Runner/FrameworkOracle.Runner.csproj" />
    <ProjectReference
      Include="../FrameworkOracle.Probes/FrameworkOracle.Probes.csproj"
      ReferenceOutputAssembly="false" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="../../fixture/web.config"
      Link="fixture/app/web.config"
      CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="../../fixture/errors.web.config"
      Link="fixture/app-errors/web.config"
      CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="../../metadata/*.json"
      Link="metadata/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="../../sessions.json"
      Link="metadata/sessions.json"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StageOracleApplicationBin" AfterTargets="Build">
    <PropertyGroup>
      <_FixtureBin>$(TargetDir)fixture/app/bin</_FixtureBin>
      <_ErrorFixtureBin>$(TargetDir)fixture/app-errors/bin</_ErrorFixtureBin>
      <_FixtureTemp>$(TargetDir)fixture/temp</_FixtureTemp>
      <_ProbeAssembly>$(MSBuildProjectDirectory)/../FrameworkOracle.Probes/bin/$(Configuration)/net481/CoreParity.Probes.dll</_ProbeAssembly>
    </PropertyGroup>

    <Error
      Condition="!Exists('$(_ProbeAssembly)')"
      Text="Probe build output missing: $(_ProbeAssembly)" />
    <Error
      Condition="Exists('$(TargetDir)CoreParity.Probes.dll')"
      Text="CoreParity.Probes must not be copied beside the host." />

    <MakeDir Directories="$(_FixtureBin);$(_ErrorFixtureBin);$(_FixtureTemp)" />
    <Delete
      Files="$(_FixtureBin)/FrameworkOracle.Contracts.dll;$(_FixtureBin)/FrameworkOracle.Probes.dll" />
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app-errors/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <Copy
      SourceFiles="$(TargetDir)CoreParity.Contracts.dll;$(TargetDir)FrameworkOracle.Runner.dll;$(_ProbeAssembly)"
      DestinationFolder="$(_FixtureBin)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(TargetDir)CoreParity.Contracts.dll;$(TargetDir)FrameworkOracle.Runner.dll;$(_ProbeAssembly)"
      DestinationFolder="$(_ErrorFixtureBin)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
