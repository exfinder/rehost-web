<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../eng/Repo.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Rehost.WebForms.Parity.PortableHost</AssemblyName>
    <RootNamespace>Rehost.WebForms.Parity.PortableHost</RootNamespace>
    <ParityClearErrorsTempDirectory>true</ParityClearErrorsTempDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
    <!-- The baseline <compilation><assemblies> names these; activation hard-loads them. -->
    <ProjectReference Include="../../../../src/Rehost.WebForms.Extensions/Rehost.WebForms.Extensions.csproj" />
    <ProjectReference Include="../../../../src/Rehost.WebForms.WebServices/Rehost.WebForms.WebServices.csproj" />
  </ItemGroup>

  <Import Project="../../StageParityFixtures.targets" />
  <Import Project="$(RehostRepoRoot)src/Rehost.WebForms.Runtime/build/Rehost.WebForms.Runtime.targets" />
  <Import Project="$(RehostRepoRoot)eng/RoslynReadyToRun.targets" />
</Project>
