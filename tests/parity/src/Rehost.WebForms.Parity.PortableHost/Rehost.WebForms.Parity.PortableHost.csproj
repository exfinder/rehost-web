<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Rehost.WebForms.Parity.PortableHost</AssemblyName>
    <RootNamespace>Rehost.WebForms.Parity.PortableHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.WebForms.Parity.Contracts/Rehost.WebForms.Parity.Contracts.csproj" />
    <ProjectReference Include="../Rehost.WebForms.Parity.PortableRunner/Rehost.WebForms.Parity.PortableRunner.csproj" />
    <ProjectReference
      Include="../Rehost.WebForms.Parity.PortableProbes/Rehost.WebForms.Parity.PortableProbes.csproj"
      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../../src/Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
  </ItemGroup>


  <Target Name="StagePortableParityApplication" AfterTargets="Build">
    <!-- Staged, not Content: the payload must not flow into consumers' output. -->
    <Copy SourceFiles="../../fixture/web.config" DestinationFiles="$(TargetDir)fixture/app/web.config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../fixture/errors.web.config" DestinationFiles="$(TargetDir)fixture/app-errors/web.config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../metadata/normalization.json" DestinationFiles="$(TargetDir)metadata/normalization.json" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../sessions.json" DestinationFiles="$(TargetDir)metadata/sessions.json" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../artifacts/golden/sessions.json" DestinationFiles="$(TargetDir)oracle/sessions.json" SkipUnchangedFiles="true" />

    <PropertyGroup>
      <_FixtureBin>$(TargetDir)fixture/app/bin</_FixtureBin>
      <_ErrorFixtureBin>$(TargetDir)fixture/app-errors/bin</_ErrorFixtureBin>
      <_FixtureTemp>$(TargetDir)fixture/temp</_FixtureTemp>
      <_ProbeAssembly>$(MSBuildProjectDirectory)/../Rehost.WebForms.Parity.PortableProbes/bin/$(Configuration)/net10.0/Rehost.WebForms.Parity.Probes.dll</_ProbeAssembly>
    </PropertyGroup>

    <Error
      Condition="!Exists('$(_ProbeAssembly)')"
      Text="Probe build output missing: $(_ProbeAssembly)" />
    <Error
      Condition="Exists('$(TargetDir)Rehost.WebForms.Parity.Probes.dll')"
      Text="Rehost.WebForms.Parity.Probes must not be copied beside the host." />

    <MakeDir Directories="$(_FixtureBin);$(_ErrorFixtureBin);$(_FixtureTemp)" />
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <!--
      Cleared rather than set, so this fixture's codegen root can only come from the host
      CompilationTempDirectory option. An ignored option would relocate its output to the
      default temporary directory instead of failing quietly.
    -->
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app-errors/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="" />
    <Copy
      SourceFiles="$(TargetDir)Rehost.WebForms.Parity.Contracts.dll;$(TargetDir)Rehost.WebForms.Parity.PortableRunner.dll;$(_ProbeAssembly)"
      DestinationFolder="$(_FixtureBin)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(TargetDir)Rehost.WebForms.Parity.Contracts.dll;$(TargetDir)Rehost.WebForms.Parity.PortableRunner.dll;$(_ProbeAssembly)"
      DestinationFolder="$(_ErrorFixtureBin)"
      SkipUnchangedFiles="true" />
  </Target>

  <Import Project="../../../../src/Rehost.WebForms.Runtime/build/Rehost.WebForms.Runtime.targets" />
</Project>
