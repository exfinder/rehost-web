<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Rehost.WebForms.Parity.OracleHost</AssemblyName>
    <RootNamespace>Rehost.WebForms.Parity.OracleHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rehost.WebForms.Parity.Contracts/Rehost.WebForms.Parity.Contracts.csproj" />
    <ProjectReference Include="../Rehost.WebForms.Parity.OracleRunner/Rehost.WebForms.Parity.OracleRunner.csproj" />
    <ProjectReference
      Include="../Rehost.WebForms.Parity.OracleProbes/Rehost.WebForms.Parity.OracleProbes.csproj"
      ReferenceOutputAssembly="false" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web" />
  </ItemGroup>


  <Target Name="StageOracleApplicationBin" AfterTargets="Build">
    <!-- Staged, not Content: the payload must not flow into consumers' output. -->
    <Copy SourceFiles="../../fixture/web.config" DestinationFiles="$(TargetDir)fixture/app/web.config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../fixture/errors.web.config" DestinationFiles="$(TargetDir)fixture/app-errors/web.config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../metadata/normalization.json;../../metadata/provenance.json" DestinationFolder="$(TargetDir)metadata" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../sessions.json" DestinationFiles="$(TargetDir)metadata/sessions.json" SkipUnchangedFiles="true" />

    <PropertyGroup>
      <_FixtureBin>$(TargetDir)fixture/app/bin</_FixtureBin>
      <_ErrorFixtureBin>$(TargetDir)fixture/app-errors/bin</_ErrorFixtureBin>
      <_FixtureTemp>$(TargetDir)fixture/temp</_FixtureTemp>
      <_ProbeAssembly>$(MSBuildProjectDirectory)/../Rehost.WebForms.Parity.OracleProbes/bin/$(Configuration)/net481/Rehost.WebForms.Parity.Probes.dll</_ProbeAssembly>
    </PropertyGroup>

    <Error
      Condition="!Exists('$(_ProbeAssembly)')"
      Text="Probe build output missing: $(_ProbeAssembly)" />
    <Error
      Condition="Exists('$(TargetDir)Rehost.WebForms.Parity.Probes.dll')"
      Text="Rehost.WebForms.Parity.Probes must not be copied beside the host." />

    <MakeDir Directories="$(_FixtureBin);$(_ErrorFixtureBin);$(_FixtureTemp)" />
    <Delete
      Files="$(_FixtureBin)/FrameworkOracle.Contracts.dll;$(_FixtureBin)/Rehost.WebForms.Parity.OracleProbes.dll" />
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app-errors/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <Copy
      SourceFiles="$(TargetDir)Rehost.WebForms.Parity.Contracts.dll;$(TargetDir)Rehost.WebForms.Parity.OracleRunner.dll;$(_ProbeAssembly)"
      DestinationFolder="$(_FixtureBin)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(TargetDir)Rehost.WebForms.Parity.Contracts.dll;$(TargetDir)Rehost.WebForms.Parity.OracleRunner.dll;$(_ProbeAssembly)"
      DestinationFolder="$(_ErrorFixtureBin)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
