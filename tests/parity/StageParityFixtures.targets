<Project>
  <!-- Shared fixture staging for the three parity hosts. Per-host knobs, set before
       the import:
         ParityProbeTargetFramework   probe flavor to stage (net481 for the oracle)
         ParityStageGoldenSessions    false for the oracle, which produces the goldens
         ParityClearErrorsTempDirectory
                                      true clears the errors fixture's tempDirectory so
                                      its codegen root can only come from the host
                                      CompilationTempDirectory option; an ignored option
                                      would relocate output instead of failing quietly.
       Staged, not Content: the payload must not flow into consumers' output. -->

  <PropertyGroup>
    <ParityProbeTargetFramework Condition="'$(ParityProbeTargetFramework)' == ''">$(TargetFramework)</ParityProbeTargetFramework>
    <ParityStageGoldenSessions Condition="'$(ParityStageGoldenSessions)' == ''">true</ParityStageGoldenSessions>
    <ParityClearErrorsTempDirectory Condition="'$(ParityClearErrorsTempDirectory)' == ''">false</ParityClearErrorsTempDirectory>
  </PropertyGroup>

  <!-- Declared before the import: the shared module derives the payload's build-graph edge
       from this item, and item evaluation is file-ordered. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Rehost.Web.Parity.Contracts/Rehost.Web.Parity.Contracts.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Rehost.Web.Parity.Runner/Rehost.Web.Parity.Runner.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Rehost.Web.Parity.Harness/Rehost.Web.Parity.Harness.csproj" />
    <FixturePayloadProject
      Include="$(MSBuildThisFileDirectory)src/Rehost.Web.Parity.Probes/Rehost.Web.Parity.Probes.csproj"
      AdditionalProperties="TargetFramework=$(ParityProbeTargetFramework)"
      MustNotLeakBesideHost="true" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)../FixtureStaging.targets" />

  <Target Name="StageParityPayload" AfterTargets="Build" DependsOnTargets="PrepareParityStaging;StageFixtures;StageFixtureBinPayload" />

  <Target Name="PrepareParityStaging">
    <PropertyGroup>
      <_FixtureTemp>$(TargetDir)fixture/temp</_FixtureTemp>
      <_TempDirectoryQuery>/configuration/system.web/compilation/@tempDirectory</_TempDirectoryQuery>
    </PropertyGroup>
    <ItemGroup>
      <FixtureBinPayload Include="$(TargetDir)Rehost.Web.Parity.Contracts.dll;$(TargetDir)Rehost.Web.Parity.Runner.dll" />
      <FixtureBinDir Include="$(TargetDir)fixture/app/bin;$(TargetDir)fixture/app-errors/bin" />
      <FixtureStagedFile Include="$(MSBuildThisFileDirectory)fixture/web.config" StagedAs="$(TargetDir)fixture/app/web.config" />
      <FixtureStagedFile Include="$(MSBuildThisFileDirectory)fixture/errors.web.config" StagedAs="$(TargetDir)fixture/app-errors/web.config" />
      <FixtureStagedFile Include="$(MSBuildThisFileDirectory)sessions.json" StagedAs="$(TargetDir)metadata/sessions.json" />
      <FixtureStagedFile
        Include="$(MSBuildThisFileDirectory)artifacts/golden/sessions.json"
        StagedAs="$(TargetDir)oracle/sessions.json"
        Condition="'$(ParityStageGoldenSessions)' == 'true'" />
      <FixtureConfigEdit
        Include="$(TargetDir)fixture/app/web.config"
        XPath="$(_TempDirectoryQuery)"
        Value="$(_FixtureTemp)" />
      <FixtureConfigEdit
        Include="$(TargetDir)fixture/app-errors/web.config"
        XPath="$(_TempDirectoryQuery)"
        Value="$(_FixtureTemp)"
        Condition="'$(ParityClearErrorsTempDirectory)' != 'true'" />
      <FixtureConfigEdit
        Include="$(TargetDir)fixture/app-errors/web.config"
        XPath="$(_TempDirectoryQuery)"
        Value=""
        Condition="'$(ParityClearErrorsTempDirectory)' == 'true'" />
    </ItemGroup>
    <MakeDir Directories="$(_FixtureTemp)" />
  </Target>
</Project>
