<Project>
  <!-- Shared fixture staging for the three parity hosts. Per-host knobs, set before
       the import:
         ParityProbeTargetFramework   probe flavor to stage (net481 for the oracle)
         ParityStageGoldenSessions    false for the oracle, which produces the goldens
         ParityClearErrorsTempDirectory
                                      true clears the errors fixture's tempDirectory so
                                      its codegen root can only come from the host
                                      CompilationTempDirectory option; an ignored option
                                      would relocate output instead of failing quietly.
       Staged, not Content: the payload must not flow into consumers' output. -->

  <PropertyGroup>
    <ParityProbeTargetFramework Condition="'$(ParityProbeTargetFramework)' == ''">$(TargetFramework)</ParityProbeTargetFramework>
    <ParityStageGoldenSessions Condition="'$(ParityStageGoldenSessions)' == ''">true</ParityStageGoldenSessions>
    <ParityClearErrorsTempDirectory Condition="'$(ParityClearErrorsTempDirectory)' == ''">false</ParityClearErrorsTempDirectory>
  </PropertyGroup>

  <Target Name="ResolveParityProbeAssembly">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)src/Rehost.WebForms.Parity.Probes/Rehost.WebForms.Parity.Probes.csproj"
      Targets="GetTargetPath"
      Properties="TargetFramework=$(ParityProbeTargetFramework)">
      <Output TaskParameter="TargetOutputs" PropertyName="_ProbeAssembly" />
    </MSBuild>

    <Error
      Condition="!Exists('$(_ProbeAssembly)')"
      Text="Probe build output missing: $(_ProbeAssembly)" />
    <Error
      Condition="Exists('$(TargetDir)Rehost.WebForms.Parity.Probes.dll')"
      Text="Rehost.WebForms.Parity.Probes must not be copied beside the host." />
  </Target>

  <Target
    Name="StageParityFixtures"
    AfterTargets="Build"
    DependsOnTargets="ResolveParityProbeAssembly">
    <PropertyGroup>
      <_FixtureBin>$(TargetDir)fixture/app/bin</_FixtureBin>
      <_ErrorFixtureBin>$(TargetDir)fixture/app-errors/bin</_ErrorFixtureBin>
      <_FixtureTemp>$(TargetDir)fixture/temp</_FixtureTemp>
    </PropertyGroup>

    <Copy SourceFiles="$(MSBuildThisFileDirectory)fixture/web.config" DestinationFiles="$(TargetDir)fixture/app/web.config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)fixture/errors.web.config" DestinationFiles="$(TargetDir)fixture/app-errors/web.config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)sessions.json" DestinationFiles="$(TargetDir)metadata/sessions.json" SkipUnchangedFiles="true" />
    <Copy
      Condition="'$(ParityStageGoldenSessions)' == 'true'"
      SourceFiles="$(MSBuildThisFileDirectory)artifacts/golden/sessions.json"
      DestinationFiles="$(TargetDir)oracle/sessions.json"
      SkipUnchangedFiles="true" />

    <MakeDir Directories="$(_FixtureBin);$(_ErrorFixtureBin);$(_FixtureTemp)" />
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <XmlPoke
      Condition="'$(ParityClearErrorsTempDirectory)' != 'true'"
      XmlInputPath="$(TargetDir)fixture/app-errors/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <XmlPoke
      Condition="'$(ParityClearErrorsTempDirectory)' == 'true'"
      XmlInputPath="$(TargetDir)fixture/app-errors/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="" />

    <ItemGroup>
      <_ParityFixturePayload Include="$(TargetDir)Rehost.WebForms.Parity.Contracts.dll;$(TargetDir)Rehost.WebForms.Parity.Runner.dll;$(_ProbeAssembly)" />
      <!-- Anything else in a warm fixture bin is a leftover (renamed assembly, removed
           dependency) and would keep resolving; deleting the leftovers replaces the old
           wipe-and-recopy while keeping the copies incremental. -->
      <_StaleFixtureBinFile Include="$(_FixtureBin)/**;$(_ErrorFixtureBin)/**" Exclude="@(_ParityFixturePayload->'$(_FixtureBin)/%(Filename)%(Extension)');@(_ParityFixturePayload->'$(_ErrorFixtureBin)/%(Filename)%(Extension)')" />
    </ItemGroup>
    <Delete Files="@(_StaleFixtureBinFile)" />

    <Copy SourceFiles="@(_ParityFixturePayload)" DestinationFolder="$(_FixtureBin)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ParityFixturePayload)" DestinationFolder="$(_ErrorFixtureBin)" SkipUnchangedFiles="true" />
  </Target>
</Project>
