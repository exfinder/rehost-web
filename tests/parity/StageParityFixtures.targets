<Project>
  <!-- Shared fixture staging for the three parity hosts. Per-host knobs, set before
       the import:
         ParityProbeTargetFramework   probe flavor to stage (net481 for the oracle)
         ParityStageGoldenSessions    false for the oracle, which produces the goldens
         ParityClearErrorsTempDirectory
                                      true clears the errors fixture's tempDirectory so
                                      its codegen root can only come from the host
                                      CompilationTempDirectory option; an ignored option
                                      would relocate output instead of failing quietly.
       Staged, not Content: the payload must not flow into consumers' output. -->

  <Import Project="$(MSBuildThisFileDirectory)../FixtureStaging.targets" />

  <PropertyGroup>
    <ParityProbeTargetFramework Condition="'$(ParityProbeTargetFramework)' == ''">$(TargetFramework)</ParityProbeTargetFramework>
    <ParityStageGoldenSessions Condition="'$(ParityStageGoldenSessions)' == ''">true</ParityStageGoldenSessions>
    <ParityClearErrorsTempDirectory Condition="'$(ParityClearErrorsTempDirectory)' == ''">false</ParityClearErrorsTempDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Rehost.WebForms.Parity.Contracts/Rehost.WebForms.Parity.Contracts.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Rehost.WebForms.Parity.Runner/Rehost.WebForms.Parity.Runner.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Rehost.WebForms.Parity.Harness/Rehost.WebForms.Parity.Harness.csproj" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)src/Rehost.WebForms.Parity.Probes/Rehost.WebForms.Parity.Probes.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <FixturePayloadProject
      Include="$(MSBuildThisFileDirectory)src/Rehost.WebForms.Parity.Probes/Rehost.WebForms.Parity.Probes.csproj"
      AdditionalProperties="TargetFramework=$(ParityProbeTargetFramework)"
      MustNotLeakBesideHost="true" />
  </ItemGroup>

  <Target Name="StageParityPayload" AfterTargets="Build" DependsOnTargets="StageParityFixtures;StageFixtureBinPayload" />

  <Target Name="PrepareParityStaging">
    <PropertyGroup>
      <_FixtureTemp>$(TargetDir)fixture/temp</_FixtureTemp>
    </PropertyGroup>
    <ItemGroup>
      <FixtureBinPayload Include="$(TargetDir)Rehost.WebForms.Parity.Contracts.dll;$(TargetDir)Rehost.WebForms.Parity.Runner.dll" />
      <FixtureBinDir Include="$(TargetDir)fixture/app/bin;$(TargetDir)fixture/app-errors/bin" />
      <_ParityStageInput Include="$(MSBuildThisFileDirectory)fixture/web.config;$(MSBuildThisFileDirectory)fixture/errors.web.config;$(MSBuildThisFileDirectory)sessions.json" />
      <_ParityStageOutput Include="$(TargetDir)fixture/app/web.config;$(TargetDir)fixture/app-errors/web.config;$(TargetDir)metadata/sessions.json" />
      <_ParityStageInput Include="$(MSBuildThisFileDirectory)artifacts/golden/sessions.json" Condition="'$(ParityStageGoldenSessions)' == 'true'" />
      <_ParityStageOutput Include="$(TargetDir)oracle/sessions.json" Condition="'$(ParityStageGoldenSessions)' == 'true'" />
    </ItemGroup>
    <MakeDir Directories="$(_FixtureTemp)" />
  </Target>

  <!-- Gated as one unit: the poke makes the staged config differ from its source, so an
       ungated copy re-clobbers it and both re-run every build. -->
  <Target
    Name="StageParityFixtures"
    DependsOnTargets="PrepareParityStaging"
    Inputs="@(_ParityStageInput)"
    Outputs="@(_ParityStageOutput)">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)fixture/web.config" DestinationFiles="$(TargetDir)fixture/app/web.config" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)fixture/errors.web.config" DestinationFiles="$(TargetDir)fixture/app-errors/web.config" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)sessions.json" DestinationFiles="$(TargetDir)metadata/sessions.json" />
    <Copy
      Condition="'$(ParityStageGoldenSessions)' == 'true'"
      SourceFiles="$(MSBuildThisFileDirectory)artifacts/golden/sessions.json"
      DestinationFiles="$(TargetDir)oracle/sessions.json" />
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <XmlPoke
      Condition="'$(ParityClearErrorsTempDirectory)' != 'true'"
      XmlInputPath="$(TargetDir)fixture/app-errors/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <XmlPoke
      Condition="'$(ParityClearErrorsTempDirectory)' == 'true'"
      XmlInputPath="$(TargetDir)fixture/app-errors/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="" />

    <!-- Copy preserves source timestamps, and the gate compares newest input against oldest
         output across unrelated pairs; stamping the outputs at staging time keeps the check
         meaningful. -->
    <Touch Files="@(_ParityStageOutput)" />
  </Target>
</Project>
