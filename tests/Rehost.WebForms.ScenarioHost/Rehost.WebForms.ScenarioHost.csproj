<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Repo.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- The serve scenario drives the production adapter over real Kestrel. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
    <ProjectReference Include="../../src/Rehost.WebForms.Hosting/Rehost.WebForms.Hosting.csproj" />
    <ProjectReference Include="../../src/Rehost.WebForms.Extensions/Rehost.WebForms.Extensions.csproj" />
    <ProjectReference
      Include="../../src/Rehost.WebForms.FriendlyUrls/Rehost.WebForms.FriendlyUrls.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <ProjectReference Include="../parity/src/Rehost.WebForms.Parity.Contracts/Rehost.WebForms.Parity.Contracts.csproj" />
    <!--
      Built but not referenced: the probe assembly must reach the application through the
      fixture's own bin directory, as an application's binaries do. Loading it beside the host
      would prove nothing about bin resolution.
    -->
    <ProjectReference
      Include="../Rehost.WebForms.ScenarioProbes/Rehost.WebForms.ScenarioProbes.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="StageScenarioPayload" AfterTargets="Build" DependsOnTargets="StageScenarioFixtures;StageFriendlyUrlsAssembly;StageScenarioProbes" />

  <Target Name="StageScenarioFixtures">
    <ItemGroup>
      <_FixtureFile Include="fixtures/**" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_FixtureFile)"
      DestinationFiles="@(_FixtureFile->'$(TargetDir)fixtures/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageFriendlyUrlsAssembly" DependsOnTargets="StageScenarioFixtures">
    <MSBuild
      Projects="../../src/Rehost.WebForms.FriendlyUrls/Rehost.WebForms.FriendlyUrls.csproj"
      Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_FriendlyUrlsAssembly" />
    </MSBuild>
    <Copy
      SourceFiles="$(_FriendlyUrlsAssembly)"
      DestinationFolder="$(TargetDir)fixtures/friendlyurls/bin"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageScenarioProbes" DependsOnTargets="StageScenarioFixtures">
    <MSBuild
      Projects="../Rehost.WebForms.ScenarioProbes/Rehost.WebForms.ScenarioProbes.csproj"
      Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_ProbeAssembly" />
    </MSBuild>

    <Error
      Condition="!Exists('$(_ProbeAssembly)')"
      Text="Probe build output missing: $(_ProbeAssembly)" />
    <Error
      Condition="Exists('$(TargetDir)Rehost.WebForms.ScenarioProbes.dll')"
      Text="Rehost.WebForms.ScenarioProbes must not be copied beside the host." />

    <ItemGroup>
      <_FixtureDirectory
        Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)fixtures'))"
        Condition="Exists('$(TargetDir)fixtures')" />
    </ItemGroup>

    <!-- The probe assembly now leans on the shared journal, so its dependency ships too. -->
    <Copy
      SourceFiles="$(_ProbeAssembly);$([System.IO.Path]::GetDirectoryName('$(_ProbeAssembly)'))/Rehost.WebForms.Parity.Contracts.dll"
      DestinationFolder="%(_FixtureDirectory.Identity)/bin"
      SkipUnchangedFiles="true" />
  </Target>

  <Import Project="$(RehostRepoRoot)src/Rehost.WebForms.Runtime/build/Rehost.WebForms.Runtime.targets" />
  <Import Project="$(RehostRepoRoot)eng/RoslynReadyToRun.targets" />
</Project>
