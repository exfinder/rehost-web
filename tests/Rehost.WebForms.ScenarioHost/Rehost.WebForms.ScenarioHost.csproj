<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Repo.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- The serve scenario drives the production adapter over real Kestrel. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
    <ProjectReference Include="../../src/Rehost.WebForms.Hosting/Rehost.WebForms.Hosting.csproj" />
    <ProjectReference Include="../../src/Rehost.WebForms.Extensions/Rehost.WebForms.Extensions.csproj" />
    <ProjectReference
      Include="../../src/Rehost.WebForms.FriendlyUrls/Rehost.WebForms.FriendlyUrls.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <ProjectReference
      Include="../../src/Rehost.WebForms.Owin.Host.SystemWeb/Rehost.WebForms.Owin.Host.SystemWeb.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <ProjectReference Include="../Rehost.WebForms.ScenarioProtocol/Rehost.WebForms.ScenarioProtocol.csproj" />
    <!--
      Built but not referenced: the probe assembly must reach the application through the
      fixture's own bin directory, as an application's binaries do. Loading it beside the host
      would prove nothing about bin resolution.
    -->
    <ProjectReference
      Include="../Rehost.WebForms.ScenarioProbes/Rehost.WebForms.ScenarioProbes.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <!-- The parity probes compile against real Framework too; the path probe is the same bytes
         on both sides of a reading. -->
    <ProjectReference
      Include="../parity/src/Rehost.WebForms.Parity.Probes/Rehost.WebForms.Parity.Probes.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
      SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <!-- Not referenced by the host: the OWIN assemblies are staged into the friendlyurls
       fixture bin, where the application resolves them. -->
  <ItemGroup>
    <PackageReference Include="Owin" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.Cookies" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <_FixtureFile Include="fixtures/**" />
    <FixturePayloadProject
      Include="../Rehost.WebForms.ScenarioProbes/Rehost.WebForms.ScenarioProbes.csproj"
      MustNotLeakBesideHost="true" />
    <FixturePayloadProject
      Include="../parity/src/Rehost.WebForms.Parity.Probes/Rehost.WebForms.Parity.Probes.csproj"
      MustNotLeakBesideHost="true"
      AdditionalProperties="TargetFramework=net10.0" />
    <!-- The parity probe assembly resolves its contracts in-bin, as an application's would. -->
    <FixturePayloadProject
      Include="../parity/src/Rehost.WebForms.Parity.Contracts/Rehost.WebForms.Parity.Contracts.csproj" />
  </ItemGroup>

  <Target Name="StageScenarioPayload" AfterTargets="Build" DependsOnTargets="StageScenarioFixtures;PruneStaleScenarioFixtures;StageFixtureBinPayload" />

  <!-- No Inputs/Outputs: a staged copy mutated in place is newer than its source, which the
       target-level up-to-date check reads as nothing to do. The Copy itself stays incremental
       through SkipUnchangedFiles, and re-copies exactly the files whose size or timestamp
       drifted from source. -->
  <Target Name="StageScenarioFixtures">
    <Copy
      SourceFiles="@(_FixtureFile)"
      DestinationFiles="@(_FixtureFile->'$(TargetDir)fixtures/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- Without pruning, a fixture or page deleted from source keeps serving from the
       staged copy until a clean build. Directories are compared by bare name; separator
       differences cannot misclassify them. -->
  <Target Name="PruneStaleScenarioFixtures" DependsOnTargets="StageScenarioFixtures">
    <ItemGroup>
      <_FixtureSourceDir Include="$([System.IO.Directory]::GetDirectories('$(MSBuildProjectDirectory)/fixtures'))" />
      <_StagedFixtureDir
        Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)fixtures'))"
        Condition="Exists('$(TargetDir)fixtures')" />
      <_StaleFixtureDirName
        Include="@(_StagedFixtureDir->'%(Filename)')"
        Exclude="@(_FixtureSourceDir->'%(Filename)')" />
      <_StaleFixtureFile
        Include="$(TargetDir)fixtures/**"
        Exclude="@(_FixtureFile->'$(TargetDir)fixtures/%(RecursiveDir)%(Filename)%(Extension)');$(TargetDir)fixtures/*/bin/**" />
    </ItemGroup>

    <Delete Files="@(_StaleFixtureFile)" />
    <RemoveDir Directories="@(_StaleFixtureDirName->'$(TargetDir)fixtures/%(Identity)')" />

    <!-- A nested directory deleted from source must not survive in the staged tree, where a
         directory-request scenario would see it; the top-level comparison above cannot reach
         it. Staleness is by relative path: staged nested directories with no source
         counterpart are removed, bins excepted (payload-owned, staged-only). Enumeration is
         per level because MSBuild exposes no recursive GetDirectories; four levels is one
         deeper than any fixture nests, and the guard below fails the build rather than
         silently under-pruning a deeper tree. -->
    <PropertyGroup>
      <_Sep>$([System.IO.Path]::DirectorySeparatorChar)</_Sep>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(TargetDir)fixtures')">
      <_StagedDirL1 Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)fixtures'))" />
      <_StagedDirL2
        Include="$([System.IO.Directory]::GetDirectories('%(_StagedDirL1.Identity)'))"
        Condition="'@(_StagedDirL1)' != ''" />
      <_StagedDirL3
        Include="$([System.IO.Directory]::GetDirectories('%(_StagedDirL2.Identity)'))"
        Condition="'@(_StagedDirL2)' != ''" />
      <_StagedDirL4
        Include="$([System.IO.Directory]::GetDirectories('%(_StagedDirL3.Identity)'))"
        Condition="'@(_StagedDirL3)' != ''" />
      <_StagedDirL5
        Include="$([System.IO.Directory]::GetDirectories('%(_StagedDirL4.Identity)'))"
        Condition="'@(_StagedDirL4)' != ''" />
      <_SourceDirL1 Include="$([System.IO.Directory]::GetDirectories('$(MSBuildProjectDirectory)/fixtures'))" />
      <_SourceDirL2
        Include="$([System.IO.Directory]::GetDirectories('%(_SourceDirL1.Identity)'))"
        Condition="'@(_SourceDirL1)' != ''" />
      <_SourceDirL3
        Include="$([System.IO.Directory]::GetDirectories('%(_SourceDirL2.Identity)'))"
        Condition="'@(_SourceDirL2)' != ''" />
      <_SourceDirL4
        Include="$([System.IO.Directory]::GetDirectories('%(_SourceDirL3.Identity)'))"
        Condition="'@(_SourceDirL3)' != ''" />
      <_StagedNestedRel Include="@(_StagedDirL2->Replace('$(TargetDir)fixtures$(_Sep)', ''));@(_StagedDirL3->Replace('$(TargetDir)fixtures$(_Sep)', ''));@(_StagedDirL4->Replace('$(TargetDir)fixtures$(_Sep)', ''))" />
      <_LiveNestedRel Include="@(_SourceDirL2->Replace('$(MSBuildProjectDirectory)/fixtures$(_Sep)', ''));@(_SourceDirL3->Replace('$(MSBuildProjectDirectory)/fixtures$(_Sep)', ''));@(_SourceDirL4->Replace('$(MSBuildProjectDirectory)/fixtures$(_Sep)', ''))" />
      <_LiveNestedRel Include="@(_StagedDirL1->'%(Filename)$(_Sep)bin')" />
      <_StaleNestedRel Include="@(_StagedNestedRel)" Exclude="@(_LiveNestedRel)" />
    </ItemGroup>
    <Error
      Condition="'@(_StagedDirL5)' != ''"
      Text="Fixture tree nests deeper than the pruning enumeration: @(_StagedDirL5)" />
    <RemoveDir Directories="@(_StaleNestedRel->'$(TargetDir)fixtures$(_Sep)%(Identity)')" />
  </Target>

  <Target Name="StageScenarioFixtureBins" BeforeTargets="StageFixtureBinPayload" DependsOnTargets="PruneStaleScenarioFixtures">
    <MSBuild
      Projects="../../src/Rehost.WebForms.FriendlyUrls/Rehost.WebForms.FriendlyUrls.csproj"
      Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_FriendlyUrlsAssembly" />
    </MSBuild>
    <Error
      Condition="!Exists('$(_FriendlyUrlsAssembly)')"
      Text="FriendlyUrls build output missing: $(_FriendlyUrlsAssembly)" />

    <MSBuild
      Projects="../../src/Rehost.WebForms.Owin.Host.SystemWeb/Rehost.WebForms.Owin.Host.SystemWeb.csproj"
      Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_OwinHostAssembly" />
    </MSBuild>

    <ItemGroup>
      <_OwinFixtureAssembly Include="$(_OwinHostAssembly)" />
      <_OwinFixtureAssembly Include="$(TargetDir)Owin.dll" />
      <_OwinFixtureAssembly Include="$(TargetDir)Microsoft.Owin.dll" />
      <_OwinFixtureAssembly Include="$(TargetDir)Microsoft.Owin.Security.dll" />
      <_OwinFixtureAssembly Include="$(TargetDir)Microsoft.Owin.Security.Cookies.dll" />
    </ItemGroup>
    <Error
      Condition="!Exists('%(_OwinFixtureAssembly.Identity)')"
      Text="OWIN fixture payload missing: %(_OwinFixtureAssembly.Identity)" />

    <ItemGroup>
      <!-- The probe assembly leans on the shared journal, so its dependency ships too. -->
      <FixtureBinPayload Include="$(TargetDir)Rehost.WebForms.ScenarioProtocol.dll" />
      <!-- Not Update: inside a target, Update applies metadata to every item. -->
      <FixtureBinDir
        Include="@(_FixtureSourceDir->'$(TargetDir)fixtures/%(Filename)/bin')"
        Exclude="$(TargetDir)fixtures/friendlyurls/bin" />
      <FixtureBinDir
        Include="$(TargetDir)fixtures/friendlyurls/bin"
        ExtraPayload="$(_FriendlyUrlsAssembly);@(_OwinFixtureAssembly)" />
    </ItemGroup>
  </Target>

  <Import Project="../FixtureStaging.targets" />
  <Import Project="$(RehostRepoRoot)src/Rehost.WebForms.Runtime/build/Rehost.WebForms.Runtime.targets" />
  <Import Project="$(RehostRepoRoot)eng/RoslynReadyToRun.targets" />
</Project>
