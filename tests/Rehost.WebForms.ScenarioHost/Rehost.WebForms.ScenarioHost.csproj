<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Rehost.WebForms.ScenarioHost</AssemblyName>
    <RootNamespace>Rehost.WebForms.ScenarioHost</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The serve scenario drives the production adapter over real Kestrel. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
    <ProjectReference Include="../../src/Rehost.WebForms.Hosting/Rehost.WebForms.Hosting.csproj" />
    <ProjectReference
      Include="../../src/Rehost.WebForms.FriendlyUrls/Rehost.WebForms.FriendlyUrls.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <ProjectReference Include="../parity/src/Rehost.WebForms.Parity.Contracts/Rehost.WebForms.Parity.Contracts.csproj" />
    <!--
      Built but not referenced: the probe assembly must reach the application through the
      fixture's own bin directory, as an application's binaries do. Loading it beside the host
      would prove nothing about bin resolution.
    -->
    <ProjectReference
      Include="../Rehost.WebForms.ScenarioProbes/Rehost.WebForms.ScenarioProbes.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="StageScenarioFixtures" AfterTargets="Build" BeforeTargets="StageScenarioProbes">
    <ItemGroup>
      <_FixtureFile Include="fixtures/**" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_FixtureFile)"
      DestinationFiles="@(_FixtureFile->'$(TargetDir)fixtures/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageFriendlyUrlsAssembly" AfterTargets="StageScenarioFixtures" BeforeTargets="StageScenarioProbes">
    <Copy
      SourceFiles="../../src/Rehost.WebForms.FriendlyUrls/bin/$(Configuration)/net10.0/Rehost.WebForms.FriendlyUrls.dll"
      DestinationFolder="$(TargetDir)fixtures/friendlyurls/bin"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageScenarioProbes" AfterTargets="Build">
    <PropertyGroup>
      <_ProbeAssembly>$(MSBuildProjectDirectory)/../Rehost.WebForms.ScenarioProbes/bin/$(Configuration)/net10.0/Rehost.WebForms.ScenarioProbes.dll</_ProbeAssembly>
    </PropertyGroup>

    <Error
      Condition="!Exists('$(_ProbeAssembly)')"
      Text="Probe build output missing: $(_ProbeAssembly)" />
    <Error
      Condition="Exists('$(TargetDir)Rehost.WebForms.ScenarioProbes.dll')"
      Text="Rehost.WebForms.ScenarioProbes must not be copied beside the host." />

    <ItemGroup>
      <_FixtureDirectory
        Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)fixtures'))"
        Condition="Exists('$(TargetDir)fixtures')" />
    </ItemGroup>

    <!-- The probe assembly now leans on the shared journal, so its dependency ships too. -->
    <Copy
      SourceFiles="$(_ProbeAssembly);$(MSBuildProjectDirectory)/../Rehost.WebForms.ScenarioProbes/bin/$(Configuration)/net10.0/Rehost.WebForms.Parity.Contracts.dll"
      DestinationFolder="%(_FixtureDirectory.Identity)/bin"
      SkipUnchangedFiles="true" />
  </Target>

  <Import Project="../../src/Rehost.WebForms.Runtime/build/Rehost.WebForms.Runtime.targets" />
  <Import Project="../../eng/RoslynReadyToRun.targets" />
</Project>
