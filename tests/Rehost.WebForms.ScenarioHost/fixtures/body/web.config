<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime
      targetFramework="4.8"
      fcnMode="Disabled"
      asyncPreloadMode="None"
      maxRequestLength="4"
      requestLengthDiskThreshold="1" />
    <customErrors mode="Off" />
    <authentication mode="None" />
    <httpHandlers>
      <clear />
      <add
        path="body"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.RequestBodyHandler, Rehost.WebForms.ScenarioProbes"
        validate="true" />
      <add
        path="save"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.SaveHandler, Rehost.WebForms.ScenarioProbes"
        validate="true" />
      <add
        path="witness"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.WitnessHandler, Rehost.WebForms.ScenarioProbes"
        validate="true" />
    </httpHandlers>
  </system.web>
</configuration>
