<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add
        name="default"
        path="default"
        verb="GET"
        type="Rehost.WebForms.ScenarioProbes.ScenarioHandler, Rehost.WebForms.ScenarioProbes" />
      <add
        name="unload"
        path="unload"
        verb="GET"
        type="Rehost.WebForms.ScenarioProbes.UnloadProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="lifecycle"
        path="lifecycle"
        verb="GET"
        type="Rehost.WebForms.ScenarioProbes.LifecycleReportProbe, Rehost.WebForms.ScenarioProbes" />
    </handlers>
    <modules>
      <add name="Lifecycle" type="Rehost.WebForms.ScenarioProbes.LifecycleModule, Rehost.WebForms.ScenarioProbes" />
    </modules>
  </system.webServer>
</configuration>
