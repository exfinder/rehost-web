<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />

    <!--
      The belt-and-suspenders registrations a migrated application carries. Under the validation
      flag they are dead text: the classic-only names never load (MH4, MH16) and the name that
      also appears in <modules> runs from the webServer copy only (MH7).
    -->
    <httpModules>
      <add name="Gatekeeper" type="Rehost.WebForms.ScenarioProbes.ClassicCopyModuleProbe, Rehost.WebForms.ScenarioProbes" />
      <add name="ClassicOnly" type="Rehost.WebForms.ScenarioProbes.ClassicOnlyModuleProbe, Rehost.WebForms.ScenarioProbes" />
    </httpModules>
    <httpHandlers>
      <add verb="*" path="probe3.axd" type="Rehost.WebForms.ScenarioProbes.MarkerAHandler, Rehost.WebForms.ScenarioProbes" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <remove name="Session" />
      <add
        name="Session"
        type="Rehost.WebForms.ScenarioProbes.SessionSwapModule, Rehost.WebForms.ScenarioProbes"
        preCondition="managedHandler" />
      <add
        name="Gatekeeper"
        type="Rehost.WebForms.ScenarioProbes.GatekeeperModule, Rehost.WebForms.ScenarioProbes" />
      <add
        name="ResponseHeaders"
        type="Rehost.WebForms.ScenarioProbes.ResponseHeaderModule, Rehost.WebForms.ScenarioProbes" />
    </modules>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add
        name="ExtensionlessUrlHandler-Integrated-4.0"
        path="*."
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.MarkerBHandler, Rehost.WebForms.ScenarioProbes"
        preCondition="integratedMode,runtimeVersionv4.0" />
      <add
        name="Report"
        path="report"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.MarkerAHandler, Rehost.WebForms.ScenarioProbes" />
      <add
        name="ModuleList"
        path="module-list.axd"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.ModuleListHandler, Rehost.WebForms.ScenarioProbes" />
      <add
        name="Witness"
        path="witness"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.WitnessHandler, Rehost.WebForms.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
