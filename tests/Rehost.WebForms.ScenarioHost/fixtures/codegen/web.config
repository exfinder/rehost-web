<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8">
      <codeSubDirectories>
        <add directoryName="Shared" />
      </codeSubDirectories>
    </compilation>
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />

    <httpHandlers>
      <clear />
      <add
        path="default"
        verb="GET"
        type="Rehost.WebForms.ScenarioProbes.ScenarioHandler, Rehost.WebForms.ScenarioProbes"
        validate="true" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
</configuration>
