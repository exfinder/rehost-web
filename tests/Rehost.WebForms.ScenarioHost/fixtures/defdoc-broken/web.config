<?xml version="1.0"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <!-- Duplicates the baseline's Default.htm on purpose: the broken section must fail only
         the directory requests that consume it (readings D11/D13). -->
    <defaultDocument>
      <files>
        <add value="Default.htm" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
