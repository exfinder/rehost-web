<?xml version="1.0"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <!-- Precompiled probe instead of an .aspx: the claim only needs a full-pipeline dynamic
         request, and a page would cost this host its compilation episode. -->
    <httpHandlers>
      <add
        path="probe"
        verb="GET"
        type="Rehost.WebForms.ScenarioProbes.ScenarioHandler, Rehost.WebForms.ScenarioProbes" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <!-- Duplicates the baseline's Default.htm on purpose: the broken section must fail only
         the directory requests that consume it (readings D11/D13). -->
    <defaultDocument>
      <files>
        <add value="Default.htm" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
