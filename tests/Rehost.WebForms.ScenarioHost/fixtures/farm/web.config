<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <!-- Off so a rejected payload can be told apart from any other 500. -->
    <customErrors mode="Off" />
    <authentication mode="None" />

    <!--
      This key is what makes the farm claim testable: it is the same literal key the .NET
      Framework 4.8.1 node used when Framework.postback was captured, so both runtimes derive the
      same subkeys. Fixture key material, deliberately not secret. No ",IsolateApps" suffix: it
      overwrites the first four bytes with a hash the two runtimes do not agree on.
    -->
    <machineKey
      validationKey="E5E96E17E2FC4E4F325AD4B9374112BC5298EA7F6833E5EB2829FA61DEA8ABC7DBF63EDD75EE4A5B5B8E14A71B0F9E375BB35059AD8F42F314B48F1AB9AD337B"
      decryptionKey="5D96763F754B1A37C60A65B3B47C54684BDFE91CB5F56870021D5DA0477F6C3A"
      validation="HMACSHA256"
      decryption="AES" />
  </system.web>
</configuration>
