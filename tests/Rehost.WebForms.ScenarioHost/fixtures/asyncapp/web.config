<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />

    <httpHandlers>
      <add
        path="pending"
        verb="GET"
        type="PendingAsyncHandler"
        validate="true" />
    </httpHandlers>
  </system.web>
</configuration>
