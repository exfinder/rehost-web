<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="rehost:RequestTimeoutScanSeconds" value="2" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" executionTimeout="1" />
    <customErrors mode="Off" />
    <authentication mode="None" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add
        name="witness"
        path="witness"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.WitnessHandler, Rehost.WebForms.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
