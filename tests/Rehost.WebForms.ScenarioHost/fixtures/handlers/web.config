<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <!--
      The removed StaticFile catch-all is what makes an unmatched URL reachable at all (MH18);
      the re-added inherited name proves it matches at its inherited slot, behind every fresh
      add below it (MH9v).
    -->
    <handlers>
      <remove name="StaticFile" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add
        name="ExtensionlessUrlHandler-Integrated-4.0"
        path="*."
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.MarkerBHandler, Rehost.WebForms.ScenarioProbes" />
      <add
        name="Custom"
        path="Default.aspx"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.MarkerAHandler, Rehost.WebForms.ScenarioProbes" />
      <add
        name="PostOnly"
        path="verb.axd"
        verb="POST"
        type="Rehost.WebForms.ScenarioProbes.MarkerAHandler, Rehost.WebForms.ScenarioProbes" />
      <add
        name="AnyVerb"
        path="verb.axd"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.MarkerBHandler, Rehost.WebForms.ScenarioProbes" />
      <add
        name="Broken"
        path="broken.axd"
        verb="*"
        type="No.Such.Type, NoSuchAssembly" />
      <add
        name="Api"
        path="api"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.MarkerAHandler, Rehost.WebForms.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
