<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />

    <!-- No key attributes: the shipped AutoGenerate default is the claim. The algorithms match
         fixtures/auth so tickets can interchange when the environment supplies auth's keys. -->
    <machineKey validation="HMACSHA256" decryption="AES" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="2880" cookieless="UseCookies" />
    </authentication>

    <membership defaultProvider="fake">
      <providers>
        <clear />
        <add
          name="fake"
          type="Rehost.WebForms.ScenarioProbes.FakeMembershipProvider, Rehost.WebForms.ScenarioProbes" />
      </providers>
    </membership>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add
        name="auth-signin"
        path="auth-signin"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.SignInProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="Secret-secret"
        path="Secret/secret"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.ProtectedProbe, Rehost.WebForms.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
