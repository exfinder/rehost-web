<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />

    <!--
      No <httpHandlers> clear: .aspx must route through the shipped root configuration, which is
      the mapping this fixture exists to exercise.
    -->
  </system.web>
</configuration>
