<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />
  </system.web>
  <!--
    No <clear />: .aspx and .css must route through the shipped baseline, which is the mapping
    this fixture exists to exercise.
  -->
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <caching>
      <profiles>
        <add extension=".css" policy="CacheUntilChange" location="Client" />
      </profiles>
    </caching>
    <handlers>
      <add
        name="probe"
        path="*.probe"
        verb="*"
        type="Rehost.WebForms.Parity.Probes.PathProbeHandler, Rehost.WebForms.Parity.Probes" />
      <add
        name="runtime-identity"
        path="runtime-identity"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.RuntimeIdentityProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="base-directory"
        path="base-directory"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.BaseDirectoryProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="browser-caps"
        path="browser-caps"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.BrowserCapabilitiesProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="headers"
        path="headers"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.ResponseHeadersProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="on-sending-headers"
        path="on-sending-headers"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.OnSendingHeadersProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="request-headers"
        path="request-headers"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.RequestHeadersProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="integrated"
        path="integrated"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.IntegratedMembersProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="witness"
        path="witness"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.WitnessHandler, Rehost.WebForms.ScenarioProbes" />
      <add
        name="ws-echo"
        path="ws/echo"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.WebSocketProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="stream-asyncflush"
        path="stream/asyncflush"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.AsyncStreamingProbe, Rehost.WebForms.ScenarioProbes" />
      <add
        name="stream-flush"
        path="stream/flush"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.StreamingProbe, Rehost.WebForms.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
