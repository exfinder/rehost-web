<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- The value Microsoft's 2011 patch shipped. It is per-application and caps every request
         collection here, including the combined one that folds in cookies and server variables,
         so this application serves nothing else. -->
    <add key="aspnet:MaxHttpCollectionKeys" value="1000" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <!-- The query-string cases have to survive System.Web's own length check to reach the
         collection cap; 2048 is the default and rejects them first. Kestrel's 8 KB request
         line is the remaining ceiling, which the short key names stay under. -->
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" maxQueryStringLength="32768" />
    <customErrors mode="Off" />
    <authentication mode="None" />
    <httpHandlers>
      <clear />
      <add
        path="keys"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.CollectionKeysHandler, Rehost.WebForms.ScenarioProbes"
        validate="true" />
    </httpHandlers>
  </system.web>
</configuration>
