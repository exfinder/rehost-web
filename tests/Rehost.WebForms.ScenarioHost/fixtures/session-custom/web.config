<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />

    <sessionState mode="Custom" customProvider="recording">
      <providers>
        <add
          name="recording"
          type="Rehost.WebForms.ScenarioProbes.RecordingSessionStore, Rehost.WebForms.ScenarioProbes" />
      </providers>
    </sessionState>

    <httpHandlers>
      <add
        path="session"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.SessionProbe, Rehost.WebForms.ScenarioProbes"
        validate="true" />
      <add
        path="session-readonly"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.ReadOnlySessionProbe, Rehost.WebForms.ScenarioProbes"
        validate="true" />
      <add
        path="witness"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.WitnessHandler, Rehost.WebForms.ScenarioProbes"
        validate="true" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>
</configuration>
