<?xml version="1.0"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".css" />
      <remove fileExtension=".notthere" />
      <mimeMap fileExtension=".probe" mimeType="application/x-fixture-probe" />
    </staticContent>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="Private" />
          <remove segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <validation validateIntegratedModeConfiguration="false" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Future-Tenant" value="ignored-for-now" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
