<?xml version="1.0"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <add value="probe-default.htm" />
        <remove value="iisstart.htm" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".css" />
      <remove fileExtension=".notthere" />
      <mimeMap fileExtension=".probe" mimeType="application/x-fixture-probe" />
    </staticContent>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="Private" />
          <remove segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="rw-clean">
          <match url="^rw/clean/(.*)$" />
          <action type="Rewrite" url="rw-probe.aspx?id={R:1}" />
        </rule>
        <rule name="rw-hidden">
          <match url="^rw/hidden$" />
          <action type="Rewrite" url="Private/secret.probe" />
        </rule>
        <rule name="rw-open">
          <match url="^rw/open$" />
          <action type="Rewrite" url="App_Data/open.probe" />
        </rule>
        <rule name="rw-old">
          <match url="^rw/old$" />
          <action type="Redirect" url="rw/new" appendQueryString="false" />
        </rule>
        <rule name="rw-dir">
          <match url="^rw/dir$" />
          <action type="Rewrite" url="rw-dir/" />
        </rule>
        <rule name="rw-pi">
          <match url="^rw/pi/(.*)$" />
          <action type="Rewrite" url="rw-probe.aspx/{R:1}" />
        </rule>
        <rule name="rw-denied">
          <match url="^rw/bin/(.*)$" />
          <action type="Rewrite" url="rw-probe.aspx?id={R:1}" />
        </rule>
      </rules>
    </rewrite>
    <handlers>
      <add
        name="witness"
        path="witness"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.WitnessHandler, Rehost.WebForms.ScenarioProbes" />
      <add
        name="custom-headers"
        path="custom-headers"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.CustomHeadersProbe, Rehost.WebForms.ScenarioProbes" />
    </handlers>
    <validation validateIntegratedModeConfiguration="false" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Fixture" value="honored" />
        <add name="Cache-Control" value="no-store" />
      </customHeaders>
    </httpProtocol>
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  </system.webServer>
</configuration>
