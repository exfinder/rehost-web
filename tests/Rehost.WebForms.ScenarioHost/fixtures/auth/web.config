<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />

    <machineKey
      validationKey="E5E96E17E2FC4E4F325AD4B9374112BC5298EA7F6833E5EB2829FA61DEA8ABC7DBF63EDD75EE4A5B5B8E14A71B0F9E375BB35059AD8F42F314B48F1AB9AD337B"
      decryptionKey="5D96763F754B1A37C60A65B3B47C54684BDFE91CB5F56870021D5DA0477F6C3A"
      validation="HMACSHA256"
      decryption="AES" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="2880" cookieless="UseCookies" />
    </authentication>

    <membership defaultProvider="fake">
      <providers>
        <clear />
        <add
          name="fake"
          type="Rehost.WebForms.ScenarioProbes.FakeMembershipProvider, Rehost.WebForms.ScenarioProbes" />
      </providers>
    </membership>

    <roleManager enabled="true" cacheRolesInCookie="true" defaultProvider="fakeRoles">
      <providers>
        <clear />
        <add
          name="fakeRoles"
          type="Rehost.WebForms.ScenarioProbes.FakeRoleProvider, Rehost.WebForms.ScenarioProbes" />
      </providers>
    </roleManager>

    <anonymousIdentification enabled="true" />

    <profile enabled="true" defaultProvider="fakeProfile">
      <providers>
        <clear />
        <add
          name="fakeProfile"
          type="Rehost.WebForms.ScenarioProbes.FakeProfileProvider, Rehost.WebForms.ScenarioProbes" />
      </providers>
      <properties>
        <add name="Nickname" type="System.String" allowAnonymous="true" defaultValue="" />
      </properties>
    </profile>

    <httpHandlers>
      <add
        path="auth-status"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.AuthProbe, Rehost.WebForms.ScenarioProbes"
        validate="true" />
      <add
        path="auth-signin"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.SignInProbe, Rehost.WebForms.ScenarioProbes"
        validate="true" />
      <add
        path="auth-profile"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.ProfileWriteProbe, Rehost.WebForms.ScenarioProbes"
        validate="true" />
      <add
        path="Secret/secret"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.ProtectedProbe, Rehost.WebForms.ScenarioProbes"
        validate="true" />
      <add
        path="witness"
        verb="*"
        type="Rehost.WebForms.ScenarioProbes.WitnessHandler, Rehost.WebForms.ScenarioProbes"
        validate="true" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <add name="AuthStageProbe" type="Rehost.WebForms.ScenarioProbes.AuthStageProbeModule, Rehost.WebForms.ScenarioProbes" />
    </modules>
  </system.webServer>
</configuration>
