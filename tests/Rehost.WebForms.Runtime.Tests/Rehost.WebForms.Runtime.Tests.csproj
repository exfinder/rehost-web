<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Repo.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
    <ProjectReference Include="../parity/src/Rehost.WebForms.Parity.Harness/Rehost.WebForms.Parity.Harness.csproj" />
    <ProjectReference Include="../Rehost.WebForms.TestSupport/Rehost.WebForms.TestSupport.csproj" />
    <ProjectReference Include="../Rehost.WebForms.ScenarioProtocol/Rehost.WebForms.ScenarioProtocol.csproj" />
    <!-- Built, not referenced: scenarios run in their own process. -->
    <ProjectReference
      Include="../Rehost.WebForms.ScenarioHost/Rehost.WebForms.ScenarioHost.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
    <!-- Built but not referenced: the parity gate launches this host as a child process. -->
    <ProjectReference
      Include="../parity/src/Rehost.WebForms.Parity.PortableHost/Rehost.WebForms.Parity.PortableHost.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>

  <Import Project="$(RehostRepoRoot)src/Rehost.WebForms/build/Rehost.WebForms.targets" />
  <Import Project="$(RehostRepoRoot)eng/RoslynReadyToRun.targets" />

  <Import Project="../BaselineNamedAssemblies.props" />
</Project>
