<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net481</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rehost.Web.CallContext.Contract.Tests</RootNamespace>
  </PropertyGroup>

  <!-- The net481 leg builds everywhere (reference assemblies) but can only execute on Windows. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net481' and !$([MSBuild]::IsOSPlatform('Windows'))">
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <!-- net10.0 exercises the port's CallContext; net481 exercises mscorlib's. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="../../src/Rehost.Web/Rehost.Web.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
  </ItemGroup>

</Project>
