<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/Repo.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- The serve scenario drives the production adapter over real Kestrel. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rehost.Web/Rehost.Web.csproj" />
    <ProjectReference Include="../../src/Rehost.Web.AspNetCore/Rehost.Web.AspNetCore.csproj" />
    <ProjectReference Include="../../src/Rehost.Web.Extensions/Rehost.Web.Extensions.csproj" />
    <ProjectReference Include="../../src/Rehost.Web.Infrastructure/Rehost.Web.Infrastructure.csproj" />
    <ProjectReference Include="../Rehost.Web.ScenarioProtocol/Rehost.Web.ScenarioProtocol.csproj" />
  </ItemGroup>

  <!-- Not referenced by the host: the OWIN, Web API and Razor assemblies are staged into the
       friendlyurls, webpages and mvc fixture bins, where the application resolves them. -->
  <ItemGroup>
    <PackageReference Include="Owin" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Owin.Security.Cookies" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.AspNet.Razor" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <FixtureTreeRoot Include="fixtures" />
    <FixturePayloadProject
      Include="../Rehost.Web.ScenarioProbes/Rehost.Web.ScenarioProbes.csproj"
      MustNotLeakBesideHost="true" />
    <!-- The parity probes compile against real Framework too; the path probe is the same bytes
         on both sides of a reading. -->
    <FixturePayloadProject
      Include="../parity/src/Rehost.Web.Parity.Probes/Rehost.Web.Parity.Probes.csproj"
      MustNotLeakBesideHost="true"
      AdditionalProperties="TargetFramework=net10.0" />
    <!-- The parity probe assembly resolves its contracts in-bin, as an application's would. -->
    <FixturePayloadProject
      Include="../parity/src/Rehost.Web.Parity.Contracts/Rehost.Web.Parity.Contracts.csproj" />
    <FixturePayloadProject
      Include="../Rehost.Web.ScenarioProbes.Dynamic/Rehost.Web.ScenarioProbes.Dynamic.csproj"
      MustNotLeakBesideHost="true"
      Bins="modules;modules-rammfar" />
    <FixturePayloadProject
      Include="../../src/Rehost.AspNet.FriendlyUrls/Rehost.AspNet.FriendlyUrls.csproj"
      Bins="friendlyurls" />
    <FixturePayloadProject
      Include="../../src/Rehost.Owin.Host.SystemWeb/Rehost.Owin.Host.SystemWeb.csproj"
      Bins="friendlyurls" />
    <FixturePayloadProject
      Include="../../src/Rehost.Web.Http.WebHost/Rehost.Web.Http.WebHost.csproj"
      Bins="friendlyurls" />
    <FixturePayloadProject
      Include="../../src/Rehost.Web.WebPages/Rehost.Web.WebPages.csproj"
      MustNotLeakBesideHost="true"
      Bins="webpages;mvc" />
    <FixturePayloadProject
      Include="../../src/Rehost.Web.WebPages.Razor/Rehost.Web.WebPages.Razor.csproj"
      MustNotLeakBesideHost="true"
      Bins="webpages;mvc" />
    <FixturePayloadProject
      Include="../../src/Rehost.Web.WebPages.Deployment/Rehost.Web.WebPages.Deployment.csproj"
      MustNotLeakBesideHost="true"
      Bins="webpages;mvc" />
    <FixturePayloadProject
      Include="../../src/Rehost.Web.Mvc/Rehost.Web.Mvc.csproj"
      MustNotLeakBesideHost="true"
      Bins="mvc" />
    <FixturePayloadProject
      Include="../Rehost.Web.ScenarioMvc/Rehost.Web.ScenarioMvc.csproj"
      MustNotLeakBesideHost="true"
      Bins="mvc" />
  </ItemGroup>

  <Target Name="StageScenarioPayload" AfterTargets="Build" DependsOnTargets="StageFixtures;StageFixtureBinPayload" />

  <Target Name="StageScenarioFixtureBins" BeforeTargets="StageFixtureBinPayload" DependsOnTargets="StageFixtures">
    <MSBuild Projects="../Rehost.Web.ScenarioMvc/Rehost.Web.ScenarioMvc.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_ScenarioMvcTarget" />
    </MSBuild>
    <ItemGroup>
      <_FixtureSourceDir Include="$([System.IO.Directory]::GetDirectories('$(MSBuildProjectDirectory)/fixtures'))" />
      <!-- The probe assembly leans on the shared journal, so its dependency ships too. -->
      <FixtureBinPayload Include="$(TargetDir)Rehost.Web.ScenarioProtocol.dll" />
      <FixtureBinFile
        Include="$(TargetDir)Owin.dll;$(TargetDir)Microsoft.Owin.dll;$(TargetDir)Microsoft.Owin.Security.dll;$(TargetDir)Microsoft.Owin.Security.Cookies.dll"
        Bins="friendlyurls" />
      <FixtureBinFile
        Include="$(TargetDir)System.Web.Http.dll;$(TargetDir)System.Net.Http.Formatting.dll;$(TargetDir)Newtonsoft.Json.dll"
        Bins="friendlyurls" />
      <FixtureBinFile Include="$(TargetDir)System.Web.Razor.dll" Bins="webpages;mvc" />
      <FixtureBinFile Include="@(_ScenarioMvcTarget->'%(RootDir)%(Directory)Mindbox.Data.Linq.dll')" Bins="mvc" />
      <FixtureBinDir Include="@(_FixtureSourceDir->'$(TargetDir)fixtures/%(Filename)/bin')" />
    </ItemGroup>
  </Target>

  <Import Project="../FixtureStaging.targets" />
  <Import Project="$(RehostRepoRoot)src/Rehost.Web.Package/build/Rehost.Web.targets" />
  <Import Project="$(RehostRepoRoot)eng/RoslynReadyToRun.targets" />
</Project>
