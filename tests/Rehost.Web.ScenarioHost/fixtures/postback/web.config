<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Forces MAC enforcement and __VIEWSTATEGENERATOR on; both otherwise follow a machine-wide
         registry key, so a Framework host would render by its own patch state. -->
    <add key="aspnet:AllowInsecureDeserialization" value="false" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <!-- Off so a rejection can be told apart from any other 500. -->
    <customErrors mode="Off" />
    <authentication mode="None" />

    <!-- Fixture key material, deliberately not secret. Literal so both runtimes derive identical
         subkeys; auto-generated keys are per-process here and per-machine on Framework. The
         default ",IsolateApps" suffix is omitted: it mangles the first four bytes with a comparer
         hash that has no portable equivalent. -->
    <machineKey
      validationKey="E5E96E17E2FC4E4F325AD4B9374112BC5298EA7F6833E5EB2829FA61DEA8ABC7DBF63EDD75EE4A5B5B8E14A71B0F9E375BB35059AD8F42F314B48F1AB9AD337B"
      decryptionKey="5D96763F754B1A37C60A65B3B47C54684BDFE91CB5F56870021D5DA0477F6C3A"
      validation="HMACSHA256"
      decryption="AES" />

    <!--
      No <httpHandlers> clear: .aspx must route through the shipped root configuration.
    -->
  </system.web>
</configuration>
