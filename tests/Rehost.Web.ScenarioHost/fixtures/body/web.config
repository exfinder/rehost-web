<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime
      targetFramework="4.8"
      fcnMode="Disabled"
      asyncPreloadMode="None"
      maxRequestLength="4"
      requestLengthDiskThreshold="1" />
    <customErrors mode="Off" />
    <authentication mode="None" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add
        name="body"
        path="body"
        verb="*"
        type="Rehost.Web.ScenarioProbes.RequestBodyHandler, Rehost.Web.ScenarioProbes" />
      <add
        name="save"
        path="save"
        verb="*"
        type="Rehost.Web.ScenarioProbes.SaveHandler, Rehost.Web.ScenarioProbes" />
      <add
        name="cookies"
        path="cookies"
        verb="*"
        type="Rehost.Web.ScenarioProbes.CookieHandler, Rehost.Web.ScenarioProbes" />
      <add
        name="disconnect"
        path="disconnect"
        verb="*"
        type="Rehost.Web.ScenarioProbes.DisconnectProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="witness"
        path="witness"
        verb="*"
        type="Rehost.Web.ScenarioProbes.WitnessHandler, Rehost.Web.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
