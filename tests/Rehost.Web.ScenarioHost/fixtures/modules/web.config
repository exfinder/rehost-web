<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />

    <!--
      Dead text under integrated authority: the classic-only module never runs (MH4) and the
      disagreeing duplicate under the shared name loses to the webServer copy (MH7).
    -->
    <httpModules>
      <add name="ClassicOnly" type="Rehost.Web.ScenarioProbes.ClassicOnlyModuleProbe, Rehost.Web.ScenarioProbes" />
      <add name="Dual" type="Rehost.Web.ScenarioProbes.ClassicCopyModuleProbe, Rehost.Web.ScenarioProbes" />
    </httpModules>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add
        name="witness"
        path="witness"
        verb="*"
        type="Rehost.Web.ScenarioProbes.WitnessHandler, Rehost.Web.ScenarioProbes" />
    </handlers>
    <modules>
      <add name="Rewrite" type="Rehost.Web.ScenarioProbes.RewriteModuleProbe, Rehost.Web.ScenarioProbes" />
      <add name="Remap" type="Rehost.Web.ScenarioProbes.RemapModuleProbe, Rehost.Web.ScenarioProbes" />
      <add name="Unconditioned" type="Rehost.Web.ScenarioProbes.UnconditionedModuleProbe, Rehost.Web.ScenarioProbes" />
      <add name="Conditioned" type="Rehost.Web.ScenarioProbes.ManagedHandlerModuleProbe, Rehost.Web.ScenarioProbes" preCondition="managedHandler" />
      <add name="Dual" type="Rehost.Web.ScenarioProbes.WebServerCopyModuleProbe, Rehost.Web.ScenarioProbes" />
      <add name="StepWrapping" type="Rehost.Web.ScenarioProbes.StepWrappingModuleProbe, Rehost.Web.ScenarioProbes" />
    </modules>
  </system.webServer>
</configuration>
