<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      The extension the root serves natively is managed inside this folder, which is what the
      per-request managedHandler condition has to see (MH10, MH27).
    -->
    <handlers>
      <add
        name="ManagedText"
        path="*.txt"
        verb="*"
        type="Rehost.Web.ScenarioProbes.MarkerAHandler, Rehost.Web.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
