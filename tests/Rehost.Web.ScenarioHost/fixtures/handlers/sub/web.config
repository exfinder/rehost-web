<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      MH27b: removing the application root's own add takes effect for this folder only, and
      matching there falls back to the inherited page factory.
    -->
    <handlers>
      <remove name="Custom" />
    </handlers>
  </system.webServer>
</configuration>
