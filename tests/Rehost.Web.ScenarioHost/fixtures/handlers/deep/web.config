<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- MH27a: this folder's add is consulted ahead of the root's for the same URL. -->
    <handlers>
      <add
        name="DeepWildcard"
        path="*.aspx"
        verb="*"
        type="Rehost.Web.ScenarioProbes.MarkerBHandler, Rehost.Web.ScenarioProbes" />
      <add
        name="DeepAxd"
        path="*.axd"
        verb="*"
        type="Rehost.Web.ScenarioProbes.MarkerAHandler, Rehost.Web.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
