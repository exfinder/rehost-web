<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />
  </system.web>
  <system.data>
    <DbProviderFactories>
      <remove invariant="Rehost.ScenarioProbes.FixedRows" />
      <add
        name="Fixed rows"
        description="Scenario provider returning fixed rows"
        invariant="Rehost.ScenarioProbes.FixedRows"
        type="Rehost.Web.ScenarioProbes.FixedRowsProviderFactory, Rehost.Web.ScenarioProbes" />
    </DbProviderFactories>
  </system.data>
  <!--
    No <clear />: .aspx and .css must route through the shipped baseline, which is the mapping
    this fixture exists to exercise.
  -->
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <caching>
      <profiles>
        <add extension=".css" policy="CacheUntilChange" location="Client" />
      </profiles>
    </caching>
    <handlers>
      <add
        name="probe"
        path="*.probe"
        verb="*"
        type="Rehost.Web.Parity.Probes.PathProbeHandler, Rehost.Web.Parity.Probes" />
      <add
        name="runtime-identity"
        path="runtime-identity"
        verb="*"
        type="Rehost.Web.ScenarioProbes.RuntimeIdentityProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="base-directory"
        path="base-directory"
        verb="*"
        type="Rehost.Web.ScenarioProbes.BaseDirectoryProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="browser-caps"
        path="browser-caps"
        verb="*"
        type="Rehost.Web.ScenarioProbes.BrowserCapabilitiesProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="headers"
        path="headers"
        verb="*"
        type="Rehost.Web.ScenarioProbes.ResponseHeadersProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="on-sending-headers"
        path="on-sending-headers"
        verb="*"
        type="Rehost.Web.ScenarioProbes.OnSendingHeadersProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="request-headers"
        path="request-headers"
        verb="*"
        type="Rehost.Web.ScenarioProbes.RequestHeadersProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="integrated"
        path="integrated"
        verb="*"
        type="Rehost.Web.ScenarioProbes.IntegratedMembersProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="witness"
        path="witness"
        verb="*"
        type="Rehost.Web.ScenarioProbes.WitnessHandler, Rehost.Web.ScenarioProbes" />
      <add
        name="ws-echo"
        path="ws/echo"
        verb="*"
        type="Rehost.Web.ScenarioProbes.WebSocketProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="stream-asyncflush"
        path="stream/asyncflush"
        verb="*"
        type="Rehost.Web.ScenarioProbes.AsyncStreamingProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="stream-flush"
        path="stream/flush"
        verb="*"
        type="Rehost.Web.ScenarioProbes.StreamingProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="dynamic-validation"
        path="dynamic-validation"
        verb="POST"
        type="Rehost.Web.ScenarioProbes.DynamicValidationProbe, Rehost.Web.ScenarioProbes" />
      <add
        name="end-catch"
        path="end-catch"
        verb="*"
        type="Rehost.Web.ScenarioProbes.ResponseEndCatchProbe, Rehost.Web.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
