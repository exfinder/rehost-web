<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- No targetFramework: the application this fixture stands in for declares nothing. -->
    <compilation debug="false" />
    <httpRuntime fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add
        name="quirks"
        path="quirks"
        verb="GET"
        type="Rehost.Web.ScenarioProbes.QuirksHandler, Rehost.Web.ScenarioProbes" />
    </handlers>
  </system.webServer>
</configuration>
