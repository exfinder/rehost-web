<Project>
  <!--
    Shared fixture staging. Consumers declare, from a target so $(TargetDir) is set:
      FixtureTreeRoot        a source tree mirrored under $(TargetDir)<name>, with
                             copy-on-difference and pruning owned by StageFixtureTree
      FixturePayloadProject  built into every bin; MustNotLeakBesideHost guards against
                             the assembly resolving beside the host instead of the bin
      FixtureBinPayload      already-built files for every bin
      FixtureBinDir          the bin directories; ExtraPayload names per-bin additions
    Anything else in a warm bin is a leftover that would keep resolving; leftovers are
    deleted so the copies stay incremental without wipe-and-recopy.
  -->

  <UsingTask
    TaskName="Rehost.WebForms.FixtureStaging.Tasks.StageFixtureTree"
    AssemblyFile="$(MSBuildThisFileDirectory)Rehost.WebForms.FixtureStaging.Tasks/bin/$(Configuration)/net10.0/Rehost.WebForms.FixtureStaging.Tasks.dll" />

  <ItemGroup>
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)Rehost.WebForms.FixtureStaging.Tasks/Rehost.WebForms.FixtureStaging.Tasks.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
      SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <Target Name="StageFixtures">
    <StageFixtureTree
      Condition="'@(FixtureTreeRoot)' != ''"
      SourceRoot="%(FixtureTreeRoot.FullPath)"
      TargetRoot="$(TargetDir)%(FixtureTreeRoot.Filename)%(FixtureTreeRoot.Extension)"
      ProtectedSubtrees="*/bin" />
  </Target>

  <Target Name="ResolveFixtureBinPayload">
    <MSBuild Projects="@(FixturePayloadProject)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="FixtureBinPayload" />
    </MSBuild>

    <Error
      Condition="!Exists('%(FixtureBinPayload.Identity)')"
      Text="Fixture payload build output missing: %(FixtureBinPayload.Identity)" />
    <Error
      Condition="'%(FixturePayloadProject.MustNotLeakBesideHost)' == 'true' And Exists('$(TargetDir)%(FixturePayloadProject.Filename).dll')"
      Text="%(FixturePayloadProject.Filename) must not be copied beside the host." />
  </Target>

  <Target
    Name="StageFixtureBinPayload"
    DependsOnTargets="ResolveFixtureBinPayload"
    Outputs="%(FixtureBinDir.Identity)">
    <PropertyGroup>
      <_FixtureBin>%(FixtureBinDir.Identity)</_FixtureBin>
    </PropertyGroup>
    <ItemGroup>
      <_BinPayload Remove="@(_BinPayload)" />
      <_BinPayload Include="@(FixtureBinPayload);%(FixtureBinDir.ExtraPayload)" />
      <_StaleFixtureBinFile Remove="@(_StaleFixtureBinFile)" />
      <_StaleFixtureBinFile
        Include="$(_FixtureBin)/**"
        Exclude="@(_BinPayload->'$(_FixtureBin)/%(Filename)%(Extension)')" />
    </ItemGroup>

    <Delete Files="@(_StaleFixtureBinFile)" />
    <MakeDir Directories="$(_FixtureBin)" />
    <Copy SourceFiles="@(_BinPayload)" DestinationFolder="$(_FixtureBin)" SkipUnchangedFiles="true" />
  </Target>
</Project>
