<Project>
  <!--
    Shared fixture staging. Consumers declare, from a target so $(TargetDir) is set:
      FixtureTreeRoot        a source tree mirrored under $(TargetDir)<name>, with
                             copy-on-difference and pruning owned by StageFixtureTree
      FixturePayloadProject  built into every bin; MustNotLeakBesideHost guards against
                             the assembly resolving beside the host instead of the bin
      FixtureBinPayload      already-built files for every bin
      FixtureBinFile         already-built files for some bins; Bins names them
      FixtureBinDir          the bin directories
    A payload's Bins metadata scopes it to the named fixtures. Build-graph edges for
    payload projects are derived below; payload assemblies stay out of consumers' own
    outputs and reach the application only through the fixture bin, as an application's
    binaries do.
  -->

  <!-- Warm MSBuild nodes cache this assembly once loaded: after editing the task source, run
       `dotnet build-server shutdown` or a stale task keeps running (silently on Unix, as a
       file lock on Windows). -->
  <UsingTask
    TaskName="Rehost.Web.FixtureStaging.Tasks.StageFixtureTree"
    AssemblyFile="$(MSBuildThisFileDirectory)Rehost.Web.FixtureStaging.Tasks/bin/$(Configuration)/net10.0/Rehost.Web.FixtureStaging.Tasks.dll" />
  <UsingTask
    TaskName="Rehost.Web.FixtureStaging.Tasks.StageMappedFiles"
    AssemblyFile="$(MSBuildThisFileDirectory)Rehost.Web.FixtureStaging.Tasks/bin/$(Configuration)/net10.0/Rehost.Web.FixtureStaging.Tasks.dll" />
  <UsingTask
    TaskName="Rehost.Web.FixtureStaging.Tasks.StageFixtureBins"
    AssemblyFile="$(MSBuildThisFileDirectory)Rehost.Web.FixtureStaging.Tasks/bin/$(Configuration)/net10.0/Rehost.Web.FixtureStaging.Tasks.dll" />

  <ItemGroup>
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)Rehost.Web.FixtureStaging.Tasks/Rehost.Web.FixtureStaging.Tasks.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
      SetTargetFramework="TargetFramework=net10.0" />
    <_FixturePayloadPinned Include="@(FixturePayloadProject->HasMetadata('AdditionalProperties'))" />
    <_FixturePayloadUnpinned Include="@(FixturePayloadProject)" Exclude="@(_FixturePayloadPinned)" />
    <ProjectReference
      Include="@(_FixturePayloadPinned)"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
      SetTargetFramework="%(_FixturePayloadPinned.AdditionalProperties)" />
    <ProjectReference
      Include="@(_FixturePayloadUnpinned)"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="StageFixtures">
    <StageFixtureTree
      Condition="'@(FixtureTreeRoot)' != ''"
      SourceRoot="%(FixtureTreeRoot.FullPath)"
      TargetRoot="$(TargetDir)%(FixtureTreeRoot.Filename)%(FixtureTreeRoot.Extension)"
      ProtectedSubtrees="*/bin" />
    <StageMappedFiles
      Condition="'@(FixtureStagedFile)' != ''"
      Files="@(FixtureStagedFile)"
      ConfigEdits="@(FixtureConfigEdit)" />
  </Target>

  <Target Name="ResolveFixtureBinPayload">
    <MSBuild Projects="@(FixturePayloadProject)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="FixtureBinPayload" />
    </MSBuild>

    <Error
      Condition="'%(FixturePayloadProject.MustNotLeakBesideHost)' == 'true' And Exists('$(TargetDir)%(FixturePayloadProject.Filename).dll')"
      Text="%(FixturePayloadProject.Filename) must not be copied beside the host." />
  </Target>

  <Target Name="StageFixtureBinPayload" DependsOnTargets="ResolveFixtureBinPayload">
    <StageFixtureBins BinDirs="@(FixtureBinDir)" Payload="@(FixtureBinPayload);@(FixtureBinFile)" />
  </Target>
</Project>
