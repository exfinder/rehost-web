<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rehost.WebForms.Hosting/Rehost.WebForms.Hosting.csproj" />
    <!--
      Built but not referenced: the scenario tests launch this host as a child process from
      its own output directory, which carries its own copy of the hosting assembly. Without
      this, building only the test project leaves that copy stale and the scenario tests
      silently exercise the previous build.
    -->
    <ProjectReference
      Include="../Rehost.WebForms.ScenarioHost/Rehost.WebForms.ScenarioHost.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <!--
    The adapter gate launches this prototype's Release output as a child process, so the same
    staleness applies. It carries its own solution and Directory.Build.props, which an Exec
    keeps isolated from this build; a ProjectReference would import them and would build the
    wrong configuration.
  -->
  <Target Name="BuildAdapterParityPrototype" AfterTargets="Build">
    <Exec
      Command="dotnet build &quot;$(MSBuildThisFileDirectory)../../prototypes/adapter-parity/AdapterParity.slnx&quot; -c Release --nologo -v:quiet -clp:ErrorsOnly /p:UseSharedCompilation=false /nodeReuse:false" />
  </Target>

  <Import Project="../../src/Rehost.WebForms.Runtime/build/Rehost.WebForms.Runtime.targets" />
</Project>
