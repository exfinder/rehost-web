<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="aspnet:DisableFcnDaclRead" value="true" />
  </appSettings>

  <system.web>
    <compilation
      debug="false"
      targetFramework="4.8"
      tempDirectory="__FRAMEWORK_ORACLE_TEMP__" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />
    <customErrors mode="Off" />
    <authentication mode="None" />

    <httpModules>
      <clear />
      <add
        name="FrameworkOracleProbe"
        type="CoreParity.Probes.ProbeModule, CoreParity.Probes" />
    </httpModules>

    <!--
      HttpModulesSection.CreateModules still appends DefaultAuthenticationModule
      after this configured collection is cleared and rebuilt.
    -->
    <httpHandlers>
      <clear />
      <add
        path="oracle"
        verb="GET"
        type="CoreParity.Probes.SyncProbeHandler, CoreParity.Probes"
        validate="true" />
      <!--
        The module short-circuits this path, so reaching the handler at all is the failure
        signal for the CompleteRequest scenario.
      -->
      <add
        path="complete"
        verb="GET"
        type="CoreParity.Probes.SyncProbeHandler, CoreParity.Probes"
        validate="true" />
      <add
        path="async"
        verb="GET"
        type="CoreParity.Probes.AsyncProbeHandler, CoreParity.Probes"
        validate="true" />
      <add
        path="echo"
        verb="GET"
        type="CoreParity.Probes.EchoProbeHandler, CoreParity.Probes"
        validate="true" />
    </httpHandlers>
  </system.web>
</configuration>
