<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="aspnet:DisableFcnDaclRead" value="true" />
  </appSettings>

  <system.web>
    <compilation
      debug="false"
      targetFramework="4.8"
      tempDirectory="__FRAMEWORK_ORACLE_TEMP__" />
    <httpRuntime targetFramework="4.8" fcnMode="Disabled" />

    <!--
      The detailed error page carries a stack trace and a CLR/ASP.NET build footer, neither of
      which can agree across runtimes. The generic page is fixed wording from the same imported
      resources, so error responses stay byte-comparable.
    -->
    <customErrors mode="On" />
    <authentication mode="None" />

    <httpModules>
      <clear />
      <add
        name="FrameworkOracleProbe"
        type="CoreParity.Probes.ProbeModule, CoreParity.Probes" />
    </httpModules>

    <httpHandlers>
      <clear />
      <add
        path="throw-module"
        verb="GET"
        type="CoreParity.Probes.SyncProbeHandler, CoreParity.Probes"
        validate="true" />
      <add
        path="throw-handler"
        verb="GET"
        type="CoreParity.Probes.ThrowProbeHandler, CoreParity.Probes"
        validate="true" />
      <!--
        validate="false" defers type resolution to the request, so the application still starts
        and only this path fails. Validating here would be a startup failure instead.
      -->
      <add
        path="missing"
        verb="GET"
        type="CoreParity.Probes.AbsentHandler, CoreParity.Probes"
        validate="false" />
    </httpHandlers>
  </system.web>
</configuration>
