<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>PortableParity.Host</AssemblyName>
    <RootNamespace>PortableParity.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../core-parity/src/CoreParity.Contracts/CoreParity.Contracts.csproj" />
    <ProjectReference Include="../PortableParity.Runner/PortableParity.Runner.csproj" />
    <ProjectReference
      Include="../PortableParity.Probes/PortableParity.Probes.csproj"
      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../../src/Rehost.WebForms.Runtime/Rehost.WebForms.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="../../../framework-oracle/fixture/web.config"
      Link="fixture/app/web.config"
      CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="../../../framework-oracle/fixture/errors.web.config"
      Link="fixture/app-errors/web.config"
      CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="../../../framework-oracle/metadata/normalization.json"
      Link="metadata/normalization.json"
      CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="../../../core-parity/sessions.json"
      Link="metadata/sessions.json"
      CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="../../../framework-oracle/artifacts/golden/sessions.json"
      Link="oracle/sessions.json"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StagePortableParityApplication" AfterTargets="Build">
    <PropertyGroup>
      <_FixtureBin>$(TargetDir)fixture/app/bin</_FixtureBin>
      <_ErrorFixtureBin>$(TargetDir)fixture/app-errors/bin</_ErrorFixtureBin>
      <_FixtureTemp>$(TargetDir)fixture/temp</_FixtureTemp>
      <_ProbeAssembly>$(MSBuildProjectDirectory)/../PortableParity.Probes/bin/$(Configuration)/net10.0/CoreParity.Probes.dll</_ProbeAssembly>
    </PropertyGroup>

    <Error
      Condition="!Exists('$(_ProbeAssembly)')"
      Text="Probe build output missing: $(_ProbeAssembly)" />
    <Error
      Condition="Exists('$(TargetDir)CoreParity.Probes.dll')"
      Text="CoreParity.Probes must not be copied beside the host." />

    <MakeDir Directories="$(_FixtureBin);$(_ErrorFixtureBin);$(_FixtureTemp)" />
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <XmlPoke
      XmlInputPath="$(TargetDir)fixture/app-errors/web.config"
      Query="/configuration/system.web/compilation/@tempDirectory"
      Value="$(_FixtureTemp)" />
    <Copy
      SourceFiles="$(TargetDir)CoreParity.Contracts.dll;$(TargetDir)PortableParity.Runner.dll;$(_ProbeAssembly)"
      DestinationFolder="$(_FixtureBin)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(TargetDir)CoreParity.Contracts.dll;$(TargetDir)PortableParity.Runner.dll;$(_ProbeAssembly)"
      DestinationFolder="$(_ErrorFixtureBin)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
