* text=auto eol=lf

# Fixture markup bytes reach a byte-compared rendered response, and the Windows
# validation host has core.autocrlf=true at system level, so an unpinned .aspx
# would render CRLF there and LF on macOS.

third_party/** -text
src/System.Web.ReferenceSource/** -text
apps/YAF/yafsrc/** -text
apps/BlogEngine/BlogEngine/** -text
src/Rehost.Web.Http.WebHost/** -text
src/Rehost.Web.Http.WebHost/*.csproj text
src/Rehost.Web.WebPages/** -text
src/Rehost.Web.WebPages/*.csproj text
src/Rehost.Web.WebPages/AssemblyInfo.cs text
src/Rehost.Web.WebPages.Deployment/** -text
src/Rehost.Web.WebPages.Deployment/*.csproj text
src/Rehost.Web.WebPages.Deployment/AssemblyInfo.cs text
src/Rehost.Web.WebPages.Razor/** -text
src/Rehost.Web.WebPages.Razor/*.csproj text
src/Rehost.Web.WebPages.Razor/AssemblyInfo.cs text

# Recorded response bytes, not source. HttpWriter.WriteLine emits a hardcoded CRLF
# pair while markup literals carry the source's LF, so these files are a deliberate
# mix that any normalization would corrupt.
*.expected.html -text

# Generated to match the bytes the Framework assembly embeds, banner CRLF included.
src/Rehost.Web.Extensions/Scripts/** -text

# Verbatim Microsoft file shipped beside machine.config; keep upstream bytes.
src/Rehost.Web/configs/DefaultWsdlHelpGenerator.aspx -text
